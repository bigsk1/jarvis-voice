# Template: render with ./bin/render-systemd-unit.sh before installing so User/Group match the target account.
# Path specifiers use %h (that user's home) after User= is set.
[Unit]
Description=OpenCode Server for Jarvis Voice Assistant
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=__JARVIS_USER__
Group=__JARVIS_GROUP__
WorkingDirectory=%h
# Load environment variables (API keys for OpenCode providers)
EnvironmentFile=%h/.config/opencode/jarvis-env.env
# Also ensure PATH includes opencode binary location
Environment="PATH=%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.opencode/bin/opencode serve --port 4096 --hostname 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
