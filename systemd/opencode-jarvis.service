[Unit]
Description=OpenCode Server for Jarvis Voice Assistant
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=boss
Group=boss
WorkingDirectory=/home/boss
# Load environment variables (API keys for OpenCode providers)
EnvironmentFile=/home/boss/.config/opencode/jarvis-env.env
# Also ensure PATH includes opencode binary location
Environment="PATH=/home/boss/.opencode/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/boss/.opencode/bin/opencode serve --port 4096 --hostname 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

