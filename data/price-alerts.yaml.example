# Price Alert Data Template
# =========================
# Jarvis copies this tracked template to data/price-alerts.yaml on first use.

settings:
  check_interval_minutes: 10
  cooldown_hours: 24
  jarvis_api_url: http://localhost:8880
sources:
  crypto:
    api: coingecko
    base_url: https://api.coingecko.com/api/v3
  stocks:
    api: yfinance
watchlist:
  crypto: []
  stocks: []
