# Standalone, opt-in browser. Bind to a trusted LAN/Tailscale IP for remote use.
SQLITEBROWSER_BIND_IP=127.0.0.1
SQLITEBROWSER_PORT=8112

# Required: set a unique password of at least 12 characters before starting.
# Use single quotes around a value containing spaces, #, or $.
SQLITEBROWSER_USER=admin
SQLITEBROWSER_PASSWORD=

# Read-only host data mount by default. false explicitly allows live edits.
# ./start --edit and ./start --read-only override this for that Compose run.
SQLITEBROWSER_READ_ONLY=true

# Host directory, not a single .db file: SQLite may need adjacent WAL/SHM files.
# Includes cloud/local Memory, Intelligence, background tasks and Source Library.
SQLITEBROWSER_DATABASE_PATH=../data

# Match the owner of the database files; check with `id` on Linux.
SQLITEBROWSER_PUID=1000
SQLITEBROWSER_PGID=1000
SQLITEBROWSER_TZ=Etc/UTC

# Set a tested version tag or digest here if you prefer a pinned image.
SQLITEBROWSER_IMAGE=lscr.io/linuxserver/sqlitebrowser:latest
