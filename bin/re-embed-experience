#!/usr/bin/env python3
"""
Re-embed an experience by ID after manual text edits.

Usage: ./bin/re-embed-experience <id> [mode]
  
Examples:
  ./bin/re-embed-experience 5           # Re-embed experience ID 5 (cloud mode)
  ./bin/re-embed-experience 10 local    # Re-embed experience ID 10 (local mode)
"""

import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'lib'))
from config_loader import load_config

def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)
    
    experience_id = int(sys.argv[1])
    mode = sys.argv[2] if len(sys.argv) > 2 else 'cloud'
    
    # Load config
    load_config(mode)
    
    # Import after config loaded
    from intelligence import IntelligenceLayer
    import asyncio
    
    async def re_embed():
        intel = IntelligenceLayer()
        
        # Get current experience
        cursor = intel.conn.cursor()
        cursor.execute(
            """
            SELECT id, query, context_summary, tools_used, outcome_success,
                   error_occurred, raw_data
            FROM experiences WHERE id = ?
            """,
            (experience_id,),
        )
        row = cursor.fetchone()
        
        if not row:
            print(f"❌ Experience ID {experience_id} not found")
            return False
        
        print(f"📝 Re-embedding experience {experience_id}:")
        print(f"   Query: {row['query'][:80]}...")
        print(f"   Context: {(row['context_summary'] or 'None')[:60]}...")
        
        # Generate new embeddings
        query = row['query']
        context = row['context_summary']
        
        print("   Generating embeddings...")
        from embedding_metadata import (
            INTELLIGENCE_CONTEXT_NAMESPACE,
            INTELLIGENCE_OUTCOME_NAMESPACE,
            INTELLIGENCE_QUERY_NAMESPACE,
        )
        query_embedding = intel._get_persistable_embedding(
            query,
            role="document",
            namespace=INTELLIGENCE_QUERY_NAMESPACE,
            title="User query",
        )
        context_embedding = (
            intel._get_persistable_embedding(
                context,
                role="document",
                namespace=INTELLIGENCE_CONTEXT_NAMESPACE,
                title="Conversation context",
            )
            if context else None
        )
        
        # Reuse the same canonical input format as live recording and rebuilds.
        from embedding_inputs import build_stored_outcome_embedding_text
        outcome_text = build_stored_outcome_embedding_text(
            query=query,
            tools_used_json=row['tools_used'],
            raw_data_json=row['raw_data'],
            outcome_success=row['outcome_success'],
            error_occurred=row['error_occurred'],
        )
        outcome_embedding = intel._get_persistable_embedding(
            outcome_text,
            role="document",
            namespace=INTELLIGENCE_OUTCOME_NAMESPACE,
            title="Interaction outcome",
        )

        if query_embedding is None or outcome_embedding is None or (context and context_embedding is None):
            print("❌ Real provider embeddings were unavailable; existing vectors were preserved")
            return False
        
        # Serialize embeddings
        query_blob = intel._serialize_embedding(query_embedding)
        context_blob = intel._serialize_embedding(context_embedding) if context is not None else None
        outcome_blob = intel._serialize_embedding(outcome_embedding)
        
        # Update database
        cursor.execute("""
            UPDATE experiences SET
                query_embedding = ?,
                context_embedding = ?,
                outcome_embedding = ?
            WHERE id = ?
        """, (
            query_blob,
            context_blob,
            outcome_blob,
            experience_id
        ))
        intel.conn.commit()
        
        print(f"✅ Experience {experience_id} re-embedded successfully!")
        return True
    
    asyncio.run(re_embed())

if __name__ == "__main__":
    main()
