#!/usr/bin/env python3
"""
Jarvis Canvas - Visual Knowledge Viewer

A beautiful local web UI for Jarvis to display rich content.
Includes Canvas pages, Image Gallery, and Video Gallery.

Usage:
    ./bin/jarvis-canvas              # Start server on port 8890
    ./bin/jarvis-canvas --port 9000  # Custom port

API Endpoints:
    GET  /                    - Main UI (Canvas pages)
    GET  /gallery             - Image Gallery
    GET  /video-gallery       - Video Gallery
    GET  /api/pages           - List all pages
    GET  /api/pages/<id>      - Get single page
    POST /api/pages           - Create new page
    PUT  /api/pages/<id>      - Update page
    DELETE /api/pages/<id>    - Delete page
    GET  /api/health          - Health check
    GET  /api/stash/<space>/<file_id> - Serve stash files
    GET  /api/gallery/images  - List gallery images
"""
import sys
import os
import argparse
from pathlib import Path

# Add paths (same pattern as jarvis-intelligence, jarvis-memory)
SCRIPT_DIR = Path(__file__).parent.resolve()
JARVIS_ROOT = SCRIPT_DIR.parent
CANVAS_ROOT = JARVIS_ROOT / 'jarvis-canvas'

# Add to path
sys.path.insert(0, str(JARVIS_ROOT / 'lib'))
sys.path.insert(0, str(CANVAS_ROOT))


def main():
    parser = argparse.ArgumentParser(
        description='Jarvis Canvas - Visual Knowledge Viewer',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  jarvis-canvas                # Start on port 8890
  jarvis-canvas --port 9000    # Use custom port
  jarvis-canvas --debug        # Enable debug mode
        """
    )
    parser.add_argument('--host', default='0.0.0.0',
                        help='Host to bind to (default: 0.0.0.0)')
    parser.add_argument('--port', type=int, default=8890,
                        help='Port to bind to (default: 8890)')
    parser.add_argument('--debug', action='store_true',
                        help='Enable debug mode')
    
    args = parser.parse_args()
    
    # Import and run the app
    try:
        from server.app import run_server
        run_server(
            host=args.host,
            port=args.port,
            debug=args.debug
        )
    except ImportError as e:
        print(f"Error importing jarvis-canvas: {e}")
        print("\nMake sure dependencies are installed:")
        print(f"  pip install flask flask-cors")
        sys.exit(1)


if __name__ == '__main__':
    main()