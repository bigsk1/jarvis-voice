#!/usr/bin/env python3
"""
Jarvis Web UI Launcher
Run the web interface for Jarvis
"""
import os
import sys
from pathlib import Path

# Add paths
SCRIPT_DIR = Path(__file__).parent.resolve()
JARVIS_ROOT = SCRIPT_DIR.parent
WEB_ROOT = JARVIS_ROOT / 'jarvis-web'

# Add to path
sys.path.insert(0, str(JARVIS_ROOT / 'lib'))
sys.path.insert(0, str(WEB_ROOT))

def main():
    # Defensive: keep logs streaming in real time even when stdout is a pipe/file
    # instead of a TTY (e.g. `bin/jarvis-web > log.txt` or a non-pty launcher),
    # where Python would otherwise block-buffer stdout and delay print() output.
    # In a normal tmux pty stdout is already line-buffered, so this is a no-op there.
    for _stream in (sys.stdout, sys.stderr):
        try:
            _stream.reconfigure(line_buffering=True)
        except (AttributeError, ValueError):
            pass

    import argparse
    
    parser = argparse.ArgumentParser(
        description='Jarvis Web UI - Chat interface for Jarvis',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  jarvis-web                    # Start in cloud mode on port 5001
  jarvis-web local              # Start in local mode
  jarvis-web --port 8080        # Use custom port
  jarvis-web --debug            # Enable debug mode
        """
    )
    parser.add_argument('mode', nargs='?', default=None, choices=['cloud', 'local'],
                        help='Run mode: cloud (default) or local')
    parser.add_argument('--host', default='0.0.0.0',
                        help='Host to bind to (default: 0.0.0.0)')
    parser.add_argument('--port', type=int, default=5001,
                        help='Port to bind to (default: 5001)')
    parser.add_argument('--debug', action='store_true',
                        help='Enable debug mode')
    
    args = parser.parse_args()
    from jarvis_mode import JarvisModeError, require_local_config, resolve_jarvis_mode
    try:
        mode = resolve_jarvis_mode(args.mode)
        require_local_config(mode, JARVIS_ROOT)
        os.environ['JARVIS_MODE'] = mode
    except JarvisModeError as exc:
        parser.error(str(exc))
    
    # Import and run the app
    try:
        from server.app import run_server
        run_server(
            host=args.host,
            port=args.port,
            mode=mode,
            debug=args.debug
        )
    except ImportError as e:
        print(f"Error importing jarvis-web: {e}")
        print("\nMake sure dependencies are installed:")
        print(f"  pip install -r {WEB_ROOT}/requirements.txt")
        sys.exit(1)


if __name__ == '__main__':
    main()
