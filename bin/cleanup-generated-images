#!/usr/bin/env python3
"""Remove old generated images while preserving favorites."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT / "lib"))

from generated_image_cleanup import cleanup_generated_images  # noqa: E402


def _human_size(size: int) -> str:
    value = float(size)
    for unit in ("B", "KB", "MB", "GB"):
        if value < 1024 or unit == "GB":
            return f"{int(value)} B" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1024
    return f"{value:.1f} GB"


def _count_images(images_dir: Path) -> int:
    if not images_dir.exists():
        return 0
    return sum(
        1
        for path in images_dir.iterdir()
        if path.is_file() and path.suffix.lower() in {".jpg", ".jpeg", ".png", ".gif", ".webp"}
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Delete old generated images unless marked favorite."
    )
    parser.add_argument("--days", type=int, default=120, help="Retention window in days")
    parser.add_argument("--dry-run", action="store_true", help="Preview deletions")
    args = parser.parse_args()

    if args.days < 1:
        parser.error("--days must be at least 1")

    images_dir = PROJECT_ROOT / "data" / "generated_images"

    print("Generated Images Cleanup")
    print(f"   Retention:  {args.days} days")
    print(f"   Images dir: {images_dir}")
    if args.dry_run:
        print("   Mode:       DRY RUN (no files will be deleted)")
    print("")

    if not images_dir.exists():
        print("   (directory does not exist)")
        return 0

    before_count = _count_images(images_dir)
    before_size = _human_size(
        sum(path.stat().st_size for path in images_dir.iterdir() if path.is_file())
    )
    print("Before cleanup:")
    print(f"   Files: {before_count}")
    print(f"   Size:  {before_size}")
    print("")

    result = cleanup_generated_images(
        images_dir,
        retention_days=args.days,
        dry_run=args.dry_run,
    )
    action = "Would delete" if args.dry_run else "Deleted"
    count = len(result["candidates"]) if args.dry_run else result["deleted_images"]

    for candidate in result["candidates"][:10]:
        print(
            "   "
            f"{'Would delete' if args.dry_run else 'Deleted'}: "
            f"{candidate['name']} "
            f"({candidate['modified']}, {_human_size(candidate['size'])})"
        )
    if len(result["candidates"]) > 10:
        print(f"   ... and {len(result['candidates']) - 10} more")
    if result["candidates"]:
        print("")

    print(f"{action} {count} generated image(s), {_human_size(result['freed_bytes'])}")
    print(f"Preserved {result['preserved_favorites']} favorite image(s)")
    print(f"Preserved {result['preserved_recent']} recent image(s)")

    if not args.dry_run:
        after_count = _count_images(images_dir)
        after_size = _human_size(
            sum(path.stat().st_size for path in images_dir.iterdir() if path.is_file())
        )
        print("")
        print("After cleanup:")
        print(f"   Files: {after_count}")
        print(f"   Size:  {after_size}")

    if result["errors"]:
        for error in result["errors"][:10]:
            print(f"ERROR: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
