#!/usr/bin/env python3
"""
Prompt Evolution CLI

Commands:
  check     - Check which prompts need evolution
  generate  - Generate improvement for a component
  deploy    - Deploy an improvement
  history   - View version history
  rollback  - Rollback to a previous version
  auto      - Run automatic evolution (for cron)
"""

import os
import sys
import json
import argparse
from datetime import datetime

# Add lib to path
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'lib'))
from config_loader import load_config, get_config_value
from prompt_versioning import PromptVersionDB, EVOLUTION_CONFIG
from prompt_evolution import PromptEvolutionEngine, run_evolution_check


def cmd_check(args):
    """Check which prompts need evolution."""
    engine = PromptEvolutionEngine(args.mode)
    
    print(f"\n📊 Prompt Evolution Status ({args.mode} mode)")
    print("=" * 60)
    
    # Show current thresholds
    print(f"\nThresholds (lowered for testing):")
    print(f"  Min low ratings to trigger: {EVOLUTION_CONFIG['min_low_ratings']}")
    print(f"  Low rating threshold: <{EVOLUTION_CONFIG['low_rating_threshold']}")
    print(f"  Window: {EVOLUTION_CONFIG['window_days']} days")
    
    # Load and analyze feedback
    feedback = engine.load_feedback()
    if not feedback:
        print(f"\n⚠️  No feedback found in last {EVOLUTION_CONFIG['window_days']} days")
        print(f"   Run queries with --feedback flag to collect data")
        return
    
    print(f"\nFeedback entries found: {len(feedback)}")
    
    summaries = engine.analyze_feedback_by_component(feedback)
    candidates = engine.get_evolution_candidates()
    
    # Show all components with feedback
    print(f"\n{'Component':<30} {'Total':>6} {'Low':>5} {'Avg':>6} {'Status':<15}")
    print("-" * 70)
    
    for component, summary in sorted(summaries.items()):
        is_candidate = any(c.component == component for c in candidates)
        status = "🔴 NEEDS EVOLUTION" if is_candidate else "✅ OK"
        
        print(f"{component:<30} {summary.total_count:>6} {summary.low_rating_count:>5} "
              f"{summary.avg_rating:>6.1f} {status:<15}")
    
    # Show candidates with details
    if candidates:
        print(f"\n🎯 Evolution Candidates ({len(candidates)}):")
        print("-" * 60)
        
        for c in candidates:
            print(f"\n  📦 {c.component}")
            print(f"     Low ratings: {c.low_rating_count} (threshold: {EVOLUTION_CONFIG['min_low_ratings']})")
            print(f"     Avg rating: {c.avg_rating:.1f}")
            if c.common_issues:
                print(f"     Issues: {', '.join(c.common_issues[:3])}")
            if c.suggestions:
                print(f"     Suggestions: {', '.join(c.suggestions[:2])}")
    else:
        print(f"\n✅ No local components need evolution")
    
    # Check for MCP tool issues (separate category - can't evolve, may need replacement)
    mcp_issues = engine.get_mcp_issues()
    
    # Also get ALL MCP tools from summaries for --show-mcp
    mcp_all = {k: v for k, v in summaries.items() if k.startswith('tool:mcp_')}
    
    if mcp_issues:
        print(f"\n⚠️  MCP Tool Issues ({len(mcp_issues)}) - Consider building replacements:")
        print("-" * 60)
        
        for c in mcp_issues:
            mcp_name = c.component.replace('tool:', '')
            print(f"\n  🔌 {mcp_name}")
            print(f"     Low ratings: {c.low_rating_count}, Avg: {c.avg_rating:.1f}")
            print(f"     💡 This is an external MCP tool - cannot be evolved")
            print(f"     💡 Consider: ./bin/auto-tool-builder create \"{mcp_name.replace('mcp_', '').replace('_', ' ')}\"")
            if c.common_issues:
                print(f"     Issues: {', '.join(c.common_issues[:3])}")
    
    # Show all MCP tools if requested
    if hasattr(args, 'show_mcp') and args.show_mcp and mcp_all:
        print(f"\n🔌 MCP Tools Status (external, not evolvable):")
        print("-" * 60)
        print(f"  {'Tool':<45} {'Count':>5} {'Low':>4} {'Avg':>5}")
        print(f"  {'-'*45} {'-'*5} {'-'*4} {'-'*5}")
        for component, summary in sorted(mcp_all.items()):
            name = component.replace('tool:', '')
            is_issue = summary.low_rating_count >= EVOLUTION_CONFIG['min_low_ratings']
            marker = "⚠️" if is_issue else "  "
            print(f"  {marker}{name:<43} {summary.total_count:>5} {summary.low_rating_count:>4} {summary.avg_rating:>5.1f}")
        print(f"\n  💡 MCP tools can't be evolved. If consistently failing, build a local replacement.")
        print(f"  💡 See: docs/ADVANCED_AI_TECHNIQUES.md → Phase 4: Dynamic Tool Creation")
    
    # Check for degradation
    print(f"\n🔍 Degradation Check:")
    degraded = engine.check_degradation()
    if degraded:
        for item in degraded:
            icon = "🔴" if item['severity'] == 'critical' else "🟡"
            print(f"  {icon} {item['component']}: {item['drop_pct']:.1f}% drop "
                  f"({item['previous_rating']:.1f} → {item['current_rating']:.1f})")
    else:
        print("  ✅ No degradation detected")


def cmd_generate(args):
    """Generate improvement for a component."""
    engine = PromptEvolutionEngine(args.mode)
    
    print(f"\n🔧 Generating improvement for: {args.component}")
    print("=" * 60)
    
    # Get feedback summary for this component
    feedback = engine.load_feedback()
    summaries = engine.analyze_feedback_by_component(feedback)
    
    if args.component not in summaries:
        print(f"❌ No feedback found for {args.component}")
        return
    
    summary = summaries[args.component]
    print(f"\nFeedback summary:")
    print(f"  Total: {summary.total_count}, Low: {summary.low_rating_count}, Avg: {summary.avg_rating:.1f}")
    
    # Get current content
    current = engine.get_current_content(args.component)
    if current:
        print(f"\nCurrent content:")
        print(f"  {current[:200]}{'...' if len(current) > 200 else ''}")
    
    # Generate improvement (model info printed by engine)
    
    improvement = engine.generate_improvement(summary)
    
    if improvement:
        print(f"\n✅ Generated improvement!")
        print(f"\n📝 Change Summary:")
        print(f"  {improvement.change_summary}")
        print(f"\n📄 Proposed Content:")
        print("-" * 40)
        print(improvement.proposed_content)
        print("-" * 40)
        
        # Verify
        valid, errors = engine.verify_candidate(improvement)
        if valid:
            print(f"\n✅ Verification: PASSED")
        else:
            print(f"\n❌ Verification: FAILED")
            for e in errors:
                print(f"   - {e}")
        
        # Ask to deploy
        if args.deploy:
            print(f"\n🚀 Deploying...")
            success, msg = engine.deploy_candidate(improvement, activate=args.activate)
            print(f"   {'✅' if success else '❌'} {msg}")
        else:
            print(f"\n💡 Run with --deploy to apply this change")
            print(f"   Run with --deploy --activate to apply and activate immediately")
    else:
        print(f"\n❌ Could not generate improvement")


def cmd_history(args):
    """View version history for a component."""
    db = PromptVersionDB(args.mode)
    
    print(f"\n📜 Version History: {args.component}")
    print("=" * 60)
    
    versions = db.get_version_history(args.component, limit=args.limit)
    
    if not versions:
        print(f"No versions found for {args.component}")
        return
    
    for v in versions:
        status = "🟢 ACTIVE" if v.is_active else ("📦 ARCHIVED" if v.is_archived else "⚪ INACTIVE")
        rating = f"{v.avg_rating:.1f}" if v.avg_rating else "N/A"
        
        print(f"\n  Version {v.version} (ID: {v.id}) {status}")
        print(f"    Created: {v.created_at} by {v.created_by}")
        print(f"    Usage: {v.times_used} times, Avg Rating: {rating}")
        if v.change_summary:
            print(f"    Changes: {v.change_summary}")
        if args.verbose:
            print(f"    Content: {v.content[:100]}...")
    
    # Show evolution log
    print(f"\n📋 Evolution Log:")
    print("-" * 40)
    logs = db.get_evolution_log(args.component, limit=5)
    for log in logs:
        print(f"  {log['timestamp']}: {log['action']} ({log['status']})")
        if log['notes']:
            print(f"    Note: {log['notes']}")


def cmd_rollback(args):
    """Rollback to a previous version."""
    db = PromptVersionDB(args.mode)
    
    print(f"\n🔙 Rolling back: {args.component}")
    print("=" * 60)
    
    # Show current version
    current = db.get_active_version(args.component)
    if current:
        print(f"\nCurrent active version: {current.version}")
        print(f"  Created by: {current.created_by}")
        print(f"  Avg rating: {current.avg_rating or 'N/A'}")
    
    target_version = args.to_version
    if target_version:
        print(f"\nTarget version: {target_version}")
    else:
        if current and current.parent_version_id:
            parent = db.get_version(current.parent_version_id)
            print(f"\nTarget: Previous version ({parent.version if parent else 'unknown'})")
        else:
            print(f"\n❌ No previous version to rollback to")
            return
    
    if not args.confirm:
        print(f"\n⚠️  Run with --confirm to execute rollback")
        return
    
    success, msg = db.rollback(args.component, to_version=target_version)
    print(f"\n{'✅' if success else '❌'} {msg}")


def cmd_auto(args):
    """Run automatic evolution check (for cron)."""
    print(f"\n🤖 Automatic Evolution Check")
    print(f"   Mode: {args.mode}")
    print(f"   Deploy: {args.deploy}")
    print(f"   Activate: {args.activate}")
    print("=" * 60)
    
    run_evolution_check(
        mode=args.mode,
        auto_deploy=args.activate,
        dry_run=not args.deploy
    )


def cmd_list(args):
    """List all tracked components."""
    db = PromptVersionDB(args.mode)
    
    print(f"\n📦 Tracked Components ({args.mode} mode)")
    print("=" * 60)
    
    components = db.get_all_components()
    
    if not components:
        print("No components tracked yet.")
        print("Run: ./bin/setup-prompt-versions.py --seed")
        return
    
    print(f"\n{'Component':<35} {'Version':>8} {'Uses':>6} {'Rating':>7} {'Status':<10}")
    print("-" * 70)
    
    for component in sorted(components):
        active = db.get_active_version(component)
        if active:
            rating = f"{active.avg_rating:.1f}" if active.avg_rating else "N/A"
            status = "Active" if active.is_active else "Inactive"
            print(f"{component:<35} {active.version:>8} {active.times_used:>6} {rating:>7} {status:<10}")
        else:
            print(f"{component:<35} {'N/A':>8} {'N/A':>6} {'N/A':>7} {'No active':<10}")


def main():
    parser = argparse.ArgumentParser(
        description='Prompt Evolution CLI',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ./bin/evolve-prompts check                    # Check what needs evolution
  ./bin/evolve-prompts generate tool:search_memory  # Generate improvement
  ./bin/evolve-prompts history system_prompt    # View version history
  ./bin/evolve-prompts rollback tool:weather --to 2 --confirm
  ./bin/evolve-prompts auto --deploy            # Automatic evolution (for cron)
"""
    )
    
    parser.add_argument('--mode', '-m', choices=['cloud', 'local'], default='cloud',
                       help='Database mode (default: cloud)')
    
    subparsers = parser.add_subparsers(dest='command', help='Commands')
    
    # Check command
    check_parser = subparsers.add_parser('check', help='Check evolution candidates')
    check_parser.add_argument('--show-mcp', action='store_true', help='Always show MCP tool status')
    
    # Generate command
    gen_parser = subparsers.add_parser('generate', help='Generate improvement')
    gen_parser.add_argument('component', help='Component to improve (e.g., tool:search_memory)')
    gen_parser.add_argument('--deploy', action='store_true', help='Deploy the improvement')
    gen_parser.add_argument('--activate', action='store_true', help='Activate immediately')
    
    # History command
    hist_parser = subparsers.add_parser('history', help='View version history')
    hist_parser.add_argument('component', help='Component to view')
    hist_parser.add_argument('--limit', '-l', type=int, default=10, help='Max versions to show')
    hist_parser.add_argument('--verbose', '-v', action='store_true', help='Show content')
    
    # Rollback command
    rb_parser = subparsers.add_parser('rollback', help='Rollback to previous version')
    rb_parser.add_argument('component', help='Component to rollback')
    rb_parser.add_argument('--to', dest='to_version', type=int, help='Target version number')
    rb_parser.add_argument('--confirm', action='store_true', help='Confirm rollback')
    
    # Auto command
    auto_parser = subparsers.add_parser('auto', help='Automatic evolution (for cron)')
    auto_parser.add_argument('--deploy', action='store_true', help='Actually deploy changes')
    auto_parser.add_argument('--activate', action='store_true', help='Activate changes immediately')
    
    # List command
    list_parser = subparsers.add_parser('list', help='List tracked components')
    
    args = parser.parse_args()
    
    # Load config
    load_config(args.mode)
    
    if args.command == 'check':
        cmd_check(args)
    elif args.command == 'generate':
        cmd_generate(args)
    elif args.command == 'history':
        cmd_history(args)
    elif args.command == 'rollback':
        cmd_rollback(args)
    elif args.command == 'auto':
        cmd_auto(args)
    elif args.command == 'list':
        cmd_list(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()

