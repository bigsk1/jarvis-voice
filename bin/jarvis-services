#!/bin/bash
# Start Jarvis Background Services
# Runs follow-up, self-healing, and reminder scheduler daemons
#
# Usage:
#   ./bin/jarvis-services         # Cloud mode (default)
#   ./bin/jarvis-services --local # Local mode (Ollama)
#   ./bin/jarvis-services --stop  # Stop all services

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Parse arguments
MODE="cloud"
STOP=false

for arg in "$@"; do
    if [ "$arg" == "--local" ]; then
        MODE="local"
    elif [ "$arg" == "--stop" ]; then
        STOP=true
    fi
done

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# PID file locations
PIDDIR="$PROJECT_ROOT/logs"
mkdir -p "$PIDDIR"

FOLLOW_UP_PID="$PIDDIR/follow_up_daemon.pid"
SELF_HEALING_PID="$PIDDIR/self_healing_daemon.pid"
REMINDER_PID="$PIDDIR/reminder_scheduler.pid"

# Service scripts
FOLLOW_UP_SCRIPT="$PROJECT_ROOT/services/follow_up_daemon.py"
SELF_HEALING_SCRIPT="$PROJECT_ROOT/services/self_healing_daemon.py"
REMINDER_SCRIPT="$PROJECT_ROOT/services/reminder_scheduler.py"

# Stop services function
stop_services() {
    echo -e "${YELLOW}Stopping Jarvis background services...${NC}"
    
    stopped_count=0
    
    # Stop follow-up daemon
    if [ -f "$FOLLOW_UP_PID" ]; then
        PID=$(cat "$FOLLOW_UP_PID")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID" 2>/dev/null
            echo -e "${GREEN}✅ Stopped follow-up daemon (PID $PID)${NC}"
            stopped_count=$((stopped_count + 1))
        fi
        rm -f "$FOLLOW_UP_PID"
    fi
    
    # Stop self-healing daemon
    if [ -f "$SELF_HEALING_PID" ]; then
        PID=$(cat "$SELF_HEALING_PID")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID" 2>/dev/null
            echo -e "${GREEN}✅ Stopped self-healing daemon (PID $PID)${NC}"
            stopped_count=$((stopped_count + 1))
        fi
        rm -f "$SELF_HEALING_PID"
    fi
    
    # Stop reminder scheduler
    if [ -f "$REMINDER_PID" ]; then
        PID=$(cat "$REMINDER_PID")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID" 2>/dev/null
            echo -e "${GREEN}✅ Stopped reminder scheduler (PID $PID)${NC}"
            stopped_count=$((stopped_count + 1))
        fi
        rm -f "$REMINDER_PID"
    fi
    
    if [ $stopped_count -eq 0 ]; then
        echo -e "${YELLOW}No services were running${NC}"
    else
        echo -e "${GREEN}Stopped $stopped_count service(s)${NC}"
    fi
    
    exit 0
}

# Handle --stop flag
if [ "$STOP" = true ]; then
    stop_services
fi

# Banner
echo -e "${BLUE}╔═══════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║     Jarvis Background Services Daemon                 ║${NC}"
echo -e "${BLUE}╚═══════════════════════════════════════════════════════╝${NC}"
echo ""

# Check if services are already running
already_running=false

if [ -f "$FOLLOW_UP_PID" ]; then
    PID=$(cat "$FOLLOW_UP_PID")
    if kill -0 "$PID" 2>/dev/null; then
        echo -e "${YELLOW}⚠️  Follow-up daemon already running (PID $PID)${NC}"
        already_running=true
    fi
fi

if [ -f "$SELF_HEALING_PID" ]; then
    PID=$(cat "$SELF_HEALING_PID")
    if kill -0 "$PID" 2>/dev/null; then
        echo -e "${YELLOW}⚠️  Self-healing daemon already running (PID $PID)${NC}"
        already_running=true
    fi
fi

if [ -f "$REMINDER_PID" ]; then
    PID=$(cat "$REMINDER_PID")
    if kill -0 "$PID" 2>/dev/null; then
        echo -e "${YELLOW}⚠️  Reminder scheduler already running (PID $PID)${NC}"
        already_running=true
    fi
fi

if [ "$already_running" = true ]; then
    echo ""
    echo -e "${YELLOW}Use './bin/jarvis-services --stop' to stop existing services${NC}"
    exit 1
fi

# Check if venv is activated
if [ -z "$VIRTUAL_ENV" ]; then
    echo -e "${YELLOW}⚠️  Python virtual environment not activated${NC}"
    echo -e "${YELLOW}   Attempting to activate jarvis-venv...${NC}"
    
    if [ -d "$HOME/jarvis-venv" ]; then
        source "$HOME/jarvis-venv/bin/activate"
        echo -e "${GREEN}✅ Virtual environment activated${NC}"
    else
        echo -e "${RED}❌ jarvis-venv not found. Please run:${NC}"
        echo -e "${RED}   python3 -m venv ~/jarvis-venv${NC}"
        echo -e "${RED}   source ~/jarvis-venv/bin/activate${NC}"
        echo -e "${RED}   pip install -r requirements.txt${NC}"
        exit 1
    fi
fi

# Check if database is migrated
if ! sqlite3 "$PROJECT_ROOT/data/jarvis_memory.db" "SELECT name FROM sqlite_master WHERE type='table' AND name='alerts'" 2>/dev/null | grep -q alerts; then
    echo -e "${YELLOW}⚠️  Database not migrated. Running migration...${NC}"
    "$PROJECT_ROOT/bin/migrate-proactive-db.py"
    echo ""
fi

# Sync databases between cloud and local modes
if [ "$MODE" == "local" ]; then
    # Running in local mode - sync from cloud to local if cloud DB exists
    if [ -f "$PROJECT_ROOT/data/jarvis_memory.db" ]; then
        echo -e "${BLUE}🔄 Syncing data: cloud → local...${NC}"
        "$PROJECT_ROOT/bin/sync-memory-db.py" --from cloud --to local
        echo ""
    fi
else
    # Running in cloud mode - sync from local to cloud if local DB exists
    if [ -f "$PROJECT_ROOT/data/jarvis_memory_local.db" ]; then
        echo -e "${BLUE}🔄 Syncing data: local → cloud...${NC}"
        "$PROJECT_ROOT/bin/sync-memory-db.py" --from local --to cloud
        echo ""
    fi
fi

# Sync tool definitions to vector database
echo -e "${BLUE}🔧 Syncing tool definitions...${NC}"
python3 "$PROJECT_ROOT/bin/sync_tools.py" "$MODE" > /dev/null 2>&1
echo -e "${GREEN}  ✅ Tool embeddings updated${NC}"
echo ""

# Health check: Verify embedding dimensions are correct
echo -e "${BLUE}🩺 Checking embedding health...${NC}"
if python3 "$PROJECT_ROOT/bin/check-embeddings-health.py" "$MODE" --json > /dev/null 2>&1; then
    echo -e "${GREEN}  ✅ Embeddings healthy ($([ "$MODE" == "local" ] && echo "768" || echo "1536") dimensions)${NC}"
else
    echo -e "${RED}  ❌ Embedding dimension mismatch detected!${NC}"
    echo -e "${YELLOW}     Run: ./bin/check-embeddings-health.py $MODE${NC}"
    echo -e "${YELLOW}     This will cause semantic search to fail!${NC}"
    echo ""
    # Don't exit, but warn loudly
fi
echo ""

# Load appropriate config
if [ "$MODE" == "local" ]; then
    if [ -f "$PROJECT_ROOT/config/local.env" ]; then
        source "$PROJECT_ROOT/config/local.env"
        export LLM_PROVIDER="ollama"
    else
        echo -e "${RED}❌ config/local.env not found${NC}"
        exit 1
    fi
else
    if [ -f "$PROJECT_ROOT/config/cloud.env" ]; then
        source "$PROJECT_ROOT/config/cloud.env"
        export LLM_PROVIDER="${LLM_PROVIDER:-anthropic}"
    else
        echo -e "${RED}❌ config/cloud.env not found${NC}"
        exit 1
    fi
fi

# Save mode for watchdog cron to pick up on restart
echo "$MODE" > "$PIDDIR/services_mode"

echo -e "${GREEN}📡 Starting background services...${NC}"
echo -e "   Mode: ${BLUE}$MODE${NC}"
echo ""

# Start follow-up daemon (with unbuffered output for real-time logging)
echo -e "${BLUE}▶ Starting follow-up daemon...${NC}"
nohup python3 -u "$FOLLOW_UP_SCRIPT" >> "$PROJECT_ROOT/logs/follow_up_daemon.log" 2>&1 &
echo $! > "$FOLLOW_UP_PID"
echo -e "${GREEN}  ✅ Follow-up daemon started (PID $(cat $FOLLOW_UP_PID))${NC}"

# Wait a second between starts
sleep 1

# Start self-healing daemon (with unbuffered output for real-time logging)
echo -e "${BLUE}▶ Starting self-healing daemon...${NC}"
nohup python3 -u "$SELF_HEALING_SCRIPT" >> "$PROJECT_ROOT/logs/self_healing_daemon.log" 2>&1 &
echo $! > "$SELF_HEALING_PID"
echo -e "${GREEN}  ✅ Self-healing daemon started (PID $(cat $SELF_HEALING_PID))${NC}"

# Wait a second between starts
sleep 1

# Start reminder scheduler (with unbuffered output for real-time logging)
echo -e "${BLUE}▶ Starting reminder scheduler...${NC}"
nohup python3 -u "$REMINDER_SCRIPT" >> "$PROJECT_ROOT/logs/reminder_scheduler.log" 2>&1 &
echo $! > "$REMINDER_PID"
echo -e "${GREEN}  ✅ Reminder scheduler started (PID $(cat $REMINDER_PID))${NC}"

echo ""
echo -e "${GREEN}✅ All services started successfully!${NC}"
echo ""
echo -e "${BLUE}Services:${NC}"
echo -e "  • Follow-up daemon: Re-alerts for pending alerts (15-60 min intervals)"
echo -e "  • Self-healing daemon: Auto-resolves alerts by checking URLs"
echo -e "  • Reminder scheduler: Triggers time-based reminders"
echo ""
echo -e "${BLUE}Logs:${NC}"
echo -e "  tail -f $PROJECT_ROOT/logs/follow_up_daemon.log"
echo -e "  tail -f $PROJECT_ROOT/logs/self_healing_daemon.log"
echo -e "  tail -f $PROJECT_ROOT/logs/reminder_scheduler.log"
echo ""
echo -e "${BLUE}Management:${NC}"
echo -e "  Stop all: ${YELLOW}./bin/jarvis-services --stop${NC}"
echo -e "  Status: ${YELLOW}ps aux | grep -E 'follow_up|self_healing|reminder'${NC}"
echo ""
echo -e "${GREEN}Running in background. Services will continue even if you close this terminal.${NC}"
echo ""

