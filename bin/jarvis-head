#!/usr/bin/env python3
"""Launch the standalone Jarvis Head matrix display."""

from __future__ import annotations

import argparse
import math
import os
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).parent.resolve()
JARVIS_ROOT = SCRIPT_DIR.parent
HEAD_ROOT = JARVIS_ROOT / "jarvis-head"
REPO_VENV = JARVIS_ROOT / ".venv"
REPO_PYTHON = REPO_VENV / "bin" / "python"
LEGACY_VENV = Path.home() / "jarvis-venv"
LEGACY_PYTHON = LEGACY_VENV / "bin" / "python"
DIRECT_EMIT = sys.argv[1:2] == ["emit"]


def _display_python() -> tuple[Path, Path] | None:
    """Return the preferred environment and interpreter for the display."""

    for environment, interpreter in (
        (REPO_VENV, REPO_PYTHON),
        (LEGACY_VENV, LEGACY_PYTHON),
    ):
        if interpreter.is_file():
            return environment, interpreter
    return None


# The face renderer needs Pillow. Keep the documented direct command reliable
# even when the operator has not activated an environment first. Prefer the
# repository environment, then the legacy operator environment used by wake.
DISPLAY_PYTHON = None if DIRECT_EMIT else _display_python()
if DISPLAY_PYTHON and Path(sys.prefix).resolve() != DISPLAY_PYTHON[0].resolve():
    interpreter = DISPLAY_PYTHON[1]
    os.execv(
        str(interpreter),
        [str(interpreter), str(Path(__file__).resolve()), *sys.argv[1:]],
    )

sys.path.insert(0, str(HEAD_ROOT))
sys.path.insert(1, str(JARVIS_ROOT))


def _fps_value(value: str) -> float:
    try:
        fps = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("FPS must be a number") from exc
    if not 1 <= fps <= 120:
        raise argparse.ArgumentTypeError("FPS must be between 1 and 120")
    return fps


def _cell_aspect_value(value: str) -> float:
    try:
        cell_aspect = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("cell aspect must be a number") from exc
    if not 0.1 <= cell_aspect <= 2.0:
        raise argparse.ArgumentTypeError("cell aspect must be between 0.1 and 2.0")
    return cell_aspect


def _positive_seconds(value: str) -> float:
    try:
        seconds = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("value must be a number") from exc
    if not math.isfinite(seconds) or seconds <= 0:
        raise argparse.ArgumentTypeError("value must be a positive finite number")
    return seconds


def _epoch_value(value: str) -> float:
    timestamp = _positive_seconds(value)
    return timestamp


def _playback_id(value: str) -> str:
    if not value or len(value) > 128 or "\x00" in value:
        raise argparse.ArgumentTypeError("playback id must contain 1-128 characters")
    return value


def _bool_value(value: str) -> bool:
    normalized = value.strip().lower()
    if normalized == "true":
        return True
    if normalized == "false":
        return False
    raise argparse.ArgumentTypeError("value must be true or false")


DISPLAY_CONFIG_KEYS = (
    "JARVIS_HEAD_SOCKET",
    "JARVIS_HEAD_CELL_ASPECT",
    "JARVIS_HEAD_IDLE_TIMEOUT",
    "JARVIS_HEAD_RENDERER",
    "JARVIS_HEAD_FRAMEBUFFER",
    "JARVIS_HEAD_FONT",
    "JARVIS_HEAD_FONT_PX",
    "JARVIS_HEAD_FACE_BRIGHTNESS",
    "JARVIS_HEAD_FACE_PRESENCE",
)
RENDERERS = ("curses", "fb")


def _font_px_value(value: str) -> int:
    try:
        font_px = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("font size must be an integer") from exc
    if not 6 <= font_px <= 24:
        raise argparse.ArgumentTypeError("font size must be between 6 and 24 pixels")
    return font_px


def _face_brightness_value(value: str) -> float:
    try:
        gain = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("face brightness must be a number") from exc
    if not math.isfinite(gain) or not 0.2 <= gain <= 1.5:
        raise argparse.ArgumentTypeError("face brightness must be between 0.2 and 1.5")
    return gain


def _face_presence_value(value: str) -> float:
    try:
        presence = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("face presence must be a number") from exc
    if not math.isfinite(presence) or not 0.3 <= presence <= 1.0:
        raise argparse.ArgumentTypeError("face presence must be between 0.3 and 1.0")
    return presence


def _snapshot_seconds(value: str) -> float:
    try:
        seconds = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("snapshot time must be a number") from exc
    if not math.isfinite(seconds) or seconds < 0 or seconds > 600:
        raise argparse.ArgumentTypeError("snapshot time must be 0-600 seconds")
    return seconds


def _load_display_config() -> None:
    """Hydrate only optional display settings from the selected mode file."""

    from lib.config_loader import (
        get_active_config_mode,
        get_project_root,
        load_env_file,
    )

    mode = get_active_config_mode()
    values = load_env_file(get_project_root() / "config" / f"{mode}.env")
    home = os.environ.get("HOME", "")
    for key in DISPLAY_CONFIG_KEYS:
        if key in os.environ or f"JARVIS_OVERRIDE_{key}" in os.environ:
            continue
        value = values.get(key)
        if value is None:
            continue
        if home:
            value = value.replace("${HOME}", home).replace("$HOME", home)
        if value.startswith("~"):
            value = os.path.expanduser(value)
        os.environ[key] = value


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Jarvis Head - Matrix face display and local event receiver",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ./bin/jarvis-head
  ./bin/jarvis-head --preset reference
  ./bin/jarvis-head --preset kiosk --fps 45
  ./bin/jarvis-head --seed 42
  ./bin/jarvis-head --demo-face
  ./bin/jarvis-head --demo-face --cell-aspect 0.4
  ./bin/jarvis-head --demo-wav /path/to/speech.wav
  ./bin/jarvis-head --renderer fb --demo-face          # pixels on the VT framebuffer
  ./bin/jarvis-head --renderer fb --demo-think         # the THINK scanline, no wake needed
  ./bin/jarvis-head --renderer fb --demo-face --face-brightness 0.8
  ./bin/jarvis-head --renderer fb --demo-face --face-presence 0.45   # features veiled in rain
  ./bin/jarvis-head --renderer fb --snapshot /tmp/head.png --snapshot-at 6
  ./bin/jarvis-head emit listen
  ./bin/jarvis-head emit speak --wav /path/to/speech.wav --playback-id ID --t0 EPOCH

The WAV demo loops its visual timeline but never plays audio.
The fb renderer needs a Linux virtual console (bin/kiosk.sh) unless --snapshot
is used, which renders one PNG offscreen and exits.
Press q, Escape, or Ctrl+C to exit.
        """,
    )
    parser.add_argument(
        "--renderer",
        choices=RENDERERS,
        default=None,
        help="curses cells or fb pixels; defaults to JARVIS_HEAD_RENDERER or curses",
    )
    parser.add_argument(
        "--framebuffer",
        default=None,
        metavar="DEVICE",
        help="Framebuffer device for --renderer fb (default: JARVIS_HEAD_FRAMEBUFFER or /dev/fb0)",
    )
    parser.add_argument(
        "--font",
        default=None,
        metavar="PATH",
        help="Monospace TrueType font for --renderer fb (default: JARVIS_HEAD_FONT or DejaVu Sans Mono)",
    )
    parser.add_argument(
        "--font-px",
        type=_font_px_value,
        default=None,
        metavar="PX",
        help="Glyph size for --renderer fb, 6-24 (default: JARVIS_HEAD_FONT_PX or 10)",
    )
    parser.add_argument(
        "--face-brightness",
        type=_face_brightness_value,
        default=None,
        metavar="GAIN",
        help=(
            "Scale the face above the rain floor for --renderer fb, 0.2-1.5 "
            "(default: JARVIS_HEAD_FACE_BRIGHTNESS or 1.0)"
        ),
    )
    parser.add_argument(
        "--face-presence",
        type=_face_presence_value,
        default=None,
        metavar="FRACTION",
        help=(
            "How far the face condenses out of the rain, 0.3-1.0; 1.0 is the whole "
            "head, ~0.45 keeps the features visible while the skull stays veiled "
            "(default: JARVIS_HEAD_FACE_PRESENCE or 1.0)"
        ),
    )
    parser.add_argument(
        "--snapshot",
        type=Path,
        default=None,
        metavar="PNG",
        help="Render one offscreen frame with the fb renderer to PNG and exit (implies demo)",
    )
    parser.add_argument(
        "--snapshot-at",
        type=_snapshot_seconds,
        default=4.0,
        metavar="SECONDS",
        help="Simulated seconds before the snapshot frame (default: 4)",
    )
    parser.add_argument(
        "--preset",
        choices=("kiosk", "reference"),
        default="kiosk",
        help="Rain density preset (default: kiosk)",
    )
    parser.add_argument(
        "--fps",
        type=_fps_value,
        default=30.0,
        help="Maximum render frames per second, 1-120 (default: 30)",
    )
    parser.add_argument(
        "--seed",
        type=int,
        default=None,
        help="Fixed random seed for repeatable visual comparisons",
    )
    parser.add_argument(
        "--color",
        choices=("green", "cyan", "blue", "red", "yellow", "magenta", "white"),
        default="green",
        help="Rain color (default: green)",
    )
    demo_group = parser.add_mutually_exclusive_group()
    demo_group.add_argument(
        "--demo-face",
        action="store_true",
        help="Force the animated authored face on top of the rain",
    )
    demo_group.add_argument(
        "--demo-think",
        action="store_true",
        help="Like --demo-face but in the THINK state (scanline sweep)",
    )
    demo_group.add_argument(
        "--demo-wav",
        type=Path,
        metavar="PATH",
        help="Loop a bounded local PCM WAV mouth timeline without playing audio",
    )
    parser.add_argument(
        "--cell-aspect",
        type=_cell_aspect_value,
        default=None,
        metavar="RATIO",
        help=(
            "Terminal cell width/height ratio; defaults to "
            "JARVIS_HEAD_CELL_ASPECT or 0.4 for curses, and to the "
            "rasterized font's own cell ratio for --renderer fb"
        ),
    )
    return parser


def build_emit_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="jarvis-head emit",
        description="Fire-and-forget an event to a running Jarvis Head display",
    )
    commands = parser.add_subparsers(dest="event_type", required=True)
    commands.add_parser("listen", help="Show the listening face")
    commands.add_parser("think", help="Show the thinking face")
    commands.add_parser("sleep", help="Return the base state to rain")

    speak = commands.add_parser("speak", help="Start a WAV-backed speech overlay")
    speak.add_argument("--wav", type=Path, required=True, metavar="PATH")
    speak.add_argument("--playback-id", type=_playback_id, required=True, metavar="ID")
    speak.add_argument("--t0", type=_epoch_value, required=True, metavar="EPOCH")

    speak_end = commands.add_parser("speak_end", help="Finish the active speech overlay")
    speak_end.add_argument("--playback-id", type=_playback_id, required=True, metavar="ID")
    speak_end.add_argument("--ok", type=_bool_value, required=True, metavar="true|false")
    return parser


def _emit_main(argv: list[str]) -> int:
    args = build_emit_parser().parse_args(argv)
    from lib.head_events import emit

    payload: dict[str, object] = {}
    if args.event_type == "speak":
        payload = {
            "wav": os.fspath(args.wav.expanduser()),
            "playback_id": args.playback_id,
            "t0": args.t0,
        }
    elif args.event_type == "speak_end":
        payload = {"playback_id": args.playback_id, "ok": args.ok}
    emit(args.event_type, **payload)
    return 0


def main(argv: list[str] | None = None) -> int:
    effective_argv = list(sys.argv[1:] if argv is None else argv)
    if effective_argv[:1] == ["emit"]:
        return _emit_main(effective_argv[1:])

    # The display is mode-independent, but its optional settings live in the
    # selected Jarvis env file. Do not hydrate unrelated provider credentials
    # into the deliberately clean kiosk process.
    from lib.config_loader import get_config_value

    _load_display_config()

    parser = build_parser()
    args = parser.parse_args(effective_argv)
    try:
        from app import run_display
    except ModuleNotFoundError as exc:
        if exc.name == "PIL":
            parser.error("Pillow is unavailable; run `uv sync --dev` in the repository")
        raise

    from display_errors import DisplaySetupError
    from head_socket import HeadSocketError
    from visemes import WavAnalysisError

    from lib.head_events import get_socket_path

    renderer = args.renderer or str(get_config_value("JARVIS_HEAD_RENDERER", "curses")).strip()
    if renderer not in RENDERERS:
        parser.error(f"invalid JARVIS_HEAD_RENDERER: choose from {', '.join(RENDERERS)}")
    if args.snapshot is not None and args.renderer is None:
        renderer = "fb"
    if args.snapshot is not None and renderer != "fb":
        parser.error("--snapshot requires --renderer fb")

    # The curses aspect describes the console font. The fb renderer measures
    # its own rasterized cells, so only an explicit --cell-aspect overrides it.
    if args.cell_aspect is None and renderer == "curses":
        configured_aspect = get_config_value("JARVIS_HEAD_CELL_ASPECT", 0.4)
        try:
            args.cell_aspect = _cell_aspect_value(str(configured_aspect))
        except argparse.ArgumentTypeError as exc:
            parser.error(f"invalid JARVIS_HEAD_CELL_ASPECT: {exc}")

    framebuffer_path = args.framebuffer or str(
        get_config_value("JARVIS_HEAD_FRAMEBUFFER", "/dev/fb0") or "/dev/fb0"
    )
    font_path = args.font or (str(get_config_value("JARVIS_HEAD_FONT", "") or "").strip() or None)
    if args.font_px is None:
        try:
            args.font_px = _font_px_value(str(get_config_value("JARVIS_HEAD_FONT_PX", 10)))
        except argparse.ArgumentTypeError as exc:
            parser.error(f"invalid JARVIS_HEAD_FONT_PX: {exc}")
    if args.face_brightness is None:
        try:
            args.face_brightness = _face_brightness_value(
                str(get_config_value("JARVIS_HEAD_FACE_BRIGHTNESS", 1.0))
            )
        except argparse.ArgumentTypeError as exc:
            parser.error(f"invalid JARVIS_HEAD_FACE_BRIGHTNESS: {exc}")
    if args.face_presence is None:
        try:
            args.face_presence = _face_presence_value(
                str(get_config_value("JARVIS_HEAD_FACE_PRESENCE", 1.0))
            )
        except argparse.ArgumentTypeError as exc:
            parser.error(f"invalid JARVIS_HEAD_FACE_PRESENCE: {exc}")

    configured_socket = str(get_config_value("JARVIS_HEAD_SOCKET", "") or "").strip()
    try:
        event_socket_path = get_socket_path(configured_socket)
    except ValueError as exc:
        parser.error(str(exc))
    configured_idle_timeout = get_config_value("JARVIS_HEAD_IDLE_TIMEOUT", 120)
    try:
        idle_timeout = _positive_seconds(str(configured_idle_timeout))
    except argparse.ArgumentTypeError as exc:
        parser.error(f"invalid JARVIS_HEAD_IDLE_TIMEOUT: {exc}")

    try:
        run_display(
            preset=args.preset,
            fps=args.fps,
            seed=args.seed,
            color=args.color,
            demo_face=args.demo_face,
            demo_think=args.demo_think,
            demo_wav=args.demo_wav,
            asset_dir=HEAD_ROOT / "assets",
            cell_aspect=args.cell_aspect,
            event_socket_path=event_socket_path,
            event_socket_default=not bool(configured_socket),
            idle_timeout=idle_timeout,
            renderer=renderer,
            framebuffer_path=framebuffer_path,
            font_path=font_path,
            font_px=args.font_px,
            snapshot_path=args.snapshot,
            snapshot_at=args.snapshot_at,
            face_brightness=args.face_brightness,
            face_presence=args.face_presence,
        )
    except (HeadSocketError, WavAnalysisError, DisplaySetupError) as exc:
        parser.error(str(exc))
    except ModuleNotFoundError as exc:
        if exc.name == "numpy" and renderer == "fb":
            parser.error("NumPy is unavailable; run `uv sync --dev` in the repository")
        raise
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
