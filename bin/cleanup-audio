#!/bin/bash
#
# cleanup-audio - Remove old runtime audio and standalone speech artifacts
#
# Usage:
#   ./bin/cleanup-audio              # Runtime: 30 days; generated speech: 60 days
#   ./bin/cleanup-audio --days 14    # Runtime retention only; speech stays 60 days
#   ./bin/cleanup-audio --generated-days 90  # Override standalone speech retention
#   ./bin/cleanup-audio --dry-run    # Preview what would be deleted
#
# Directories cleaned:
#   - audio/cloud/recordings/  - TTS output, QA recordings
#   - audio/cloud/mic/         - Microphone recordings (cloud mode)
#   - audio/local/tts/         - TTS output (local mode)
#   - audio/local/mic/         - Microphone recordings (local mode)
#   - audio/local/logs/        - QA log text files
#   - data/generated_audio/   - Standalone speech audio, scripts and metadata (60 days)
#
# This script does NOT clean generated music in data/generated_music/.
#
# File types:
#   - *.wav  - Audio recordings
#   - *.mp3  - Compressed audio (if any)
#   - *.txt  - QA log files in audio/local/logs/

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
AUDIO_DIR="$PROJECT_ROOT/audio"
GENERATED_AUDIO_DIR="$PROJECT_ROOT/data/generated_audio"

# Default retention: 30 days
RETENTION_DAYS=30
GENERATED_RETENTION_DAYS=60
DRY_RUN=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --days)
            if [[ $# -lt 2 || ! "$2" =~ ^[0-9]+$ ]]; then
                echo "--days requires a nonnegative integer" >&2
                exit 2
            fi
            RETENTION_DAYS="$2"
            shift 2
            ;;
        --generated-days)
            if [[ $# -lt 2 || ! "$2" =~ ^[0-9]{1,5}$ ]] || (( 10#$2 < 1 || 10#$2 > 36500 )); then
                echo "--generated-days requires an integer from 1 to 36500" >&2
                exit 2
            fi
            GENERATED_RETENTION_DAYS=$((10#$2))
            shift 2
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            echo "Usage: cleanup-audio [--days N] [--generated-days N] [--dry-run]"
            echo ""
            echo "Options:"
            echo "  --days N     Runtime audio retention in days (default: 30)"
            echo "  --generated-days N  Standalone speech retention in days (default: 60)"
            echo "  --dry-run    Preview what would be deleted without deleting"
            echo ""
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# Standalone speech is flat, separate from the runtime cache and Canvas music.
# Never traverse a symlinked data directory/root, child directory or file.
cleanup_generated_audio() {
    echo ""
    echo "🗣️  Generated Speech Cleanup"
    echo "   Retention: $GENERATED_RETENTION_DAYS days"
    echo "   Directory: $GENERATED_AUDIO_DIR"
    if [[ -L "$PROJECT_ROOT/data" || -L "$GENERATED_AUDIO_DIR" ]]; then
        echo "   Skipped symlinked generated speech directory"
        return
    fi
    if [[ ! -d "$GENERATED_AUDIO_DIR" ]]; then
        echo "   No generated speech directory found"
        return
    fi

    local generated_scan generated_count=0 generated_bytes=0 file size
    generated_scan=$(mktemp)
    # Reuse the script's cleanup trap; a failed find must never process a
    # partial scan, nor leave its temporary candidate list behind.
    SCAN_FILE="$generated_scan"
    trap 'rm -f "$SCAN_FILE"' EXIT
    find "$GENERATED_AUDIO_DIR" -maxdepth 1 -type f \
        \( -name "*.mp3" -o -name "*.wav" -o -name "*.txt" -o -name "*.json" \) \
        -mtime +"$((GENERATED_RETENTION_DAYS - 1))" -print0 > "$generated_scan"
    while IFS= read -r -d '' file; do
        size=$(stat -c%s -- "$file")
        generated_count=$((generated_count + 1))
        generated_bytes=$((generated_bytes + size))
        if $DRY_RUN; then
            echo "   Would delete generated speech: $file"
        else
            rm -f -- "$file"
        fi
    done < "$generated_scan"
    rm -f "$generated_scan"
    if $DRY_RUN; then
        echo "   Would remove $generated_count generated speech files ($generated_bytes bytes)"
    else
        echo "   Removed $generated_count generated speech files ($generated_bytes bytes)"
    fi
}

echo "🎵 Jarvis Runtime Audio Cleanup (TTS/STT)"
echo "   Retention: $RETENTION_DAYS days"
echo "   Audio dir: $AUDIO_DIR"
echo "   Excludes:  data/generated_music/ (Canvas Audio Gallery)"
if $DRY_RUN; then
    echo "   Mode:      DRY RUN (no files will be deleted)"
fi
echo ""

# Check if audio dir exists
if [[ ! -d "$AUDIO_DIR" ]]; then
    echo "⚠️  Audio directory not found: $AUDIO_DIR"
    cleanup_generated_audio
    exit 0
fi

# Check scan completion before processing files; process substitution would hide
# find's exit status and could incorrectly report a successful cleanup.
SCAN_FILE=$(mktemp)
trap 'rm -f "$SCAN_FILE"' EXIT

# Count files before
BEFORE_COUNT=$(find "$AUDIO_DIR" -type f \( -name "*.wav" -o -name "*.mp3" -o -name "*.txt" \) | wc -l)
BEFORE_SIZE=$(du -sh "$AUDIO_DIR" | cut -f1)

echo "📊 Before cleanup:"
echo "   Files: $BEFORE_COUNT"
echo "   Size:  $BEFORE_SIZE"
echo ""

# Find old files
echo "🔍 Files older than $RETENTION_DAYS days:"

TOTAL_DELETED=0
TOTAL_BYTES=0
PREVIEW_SHOWN=0

# Find and process old audio files
find "$AUDIO_DIR" -type f \( -name "*.wav" -o -name "*.mp3" \) -mtime +"$RETENTION_DAYS" -print0 > "$SCAN_FILE"
while IFS= read -r -d '' file; do
    if [[ -n "$file" ]]; then
        size=$(stat -c%s -- "$file")
        TOTAL_BYTES=$((TOTAL_BYTES + size))
        TOTAL_DELETED=$((TOTAL_DELETED + 1))
        
        # Show progress every 50 files in dry-run, or always when deleting
        if $DRY_RUN; then
            if [[ $((TOTAL_DELETED % 50)) -eq 1 ]] || [[ $TOTAL_DELETED -le 10 ]]; then
                echo "   Would delete: $file ($(numfmt --to=iec "$size" 2>/dev/null || echo "${size}B"))"
                PREVIEW_SHOWN=$((PREVIEW_SHOWN + 1))
            fi
        else
            # Show every 100th file when actually deleting
            if [[ $((TOTAL_DELETED % 100)) -eq 1 ]]; then
                echo "   Deleting batch... ($TOTAL_DELETED files so far)"
            fi
            rm -f "$file"
        fi
    fi
done < "$SCAN_FILE"

# Also clean up old QA log text files in audio/local/logs/
if [[ -d "$AUDIO_DIR/local/logs" ]]; then
    find "$AUDIO_DIR/local/logs" -type f -name "*.txt" -mtime +"$RETENTION_DAYS" -print0 > "$SCAN_FILE"
    while IFS= read -r -d '' file; do
        if [[ -n "$file" ]]; then
            size=$(stat -c%s -- "$file")
            TOTAL_BYTES=$((TOTAL_BYTES + size))
            TOTAL_DELETED=$((TOTAL_DELETED + 1))
        
            if ! $DRY_RUN; then
                rm -f "$file"
            fi
        fi
    done < "$SCAN_FILE"
fi

# Clean up old text files in cloud directory too
if [[ -d "$AUDIO_DIR/cloud" ]]; then
    find "$AUDIO_DIR/cloud" -type f -name "*.txt" -mtime +"$RETENTION_DAYS" -print0 > "$SCAN_FILE"
    while IFS= read -r -d '' file; do
        if [[ -n "$file" ]]; then
            size=$(stat -c%s -- "$file")
            TOTAL_BYTES=$((TOTAL_BYTES + size))
            TOTAL_DELETED=$((TOTAL_DELETED + 1))
        
            if ! $DRY_RUN; then
                rm -f "$file"
            fi
        fi
    done < "$SCAN_FILE"
fi

echo ""

if [[ $TOTAL_DELETED -eq 0 ]]; then
    echo "✅ No files older than $RETENTION_DAYS days found. Nothing to clean."
else
    SIZE_HUMAN=$(numfmt --to=iec $TOTAL_BYTES 2>/dev/null || echo "${TOTAL_BYTES}B")
    if $DRY_RUN; then
        UNLISTED=$((TOTAL_DELETED - PREVIEW_SHOWN))
        if [[ $UNLISTED -gt 0 ]]; then
            echo "   ... $UNLISTED files not shown individually"
            echo ""
        fi
        echo "📋 Would delete $TOTAL_DELETED files ($SIZE_HUMAN)"
        echo ""
        echo "Run without --dry-run to actually delete."
    else
        echo "✅ Deleted $TOTAL_DELETED files ($SIZE_HUMAN)"
        
        # Count after
        AFTER_COUNT=$(find "$AUDIO_DIR" -type f \( -name "*.wav" -o -name "*.mp3" -o -name "*.txt" \) | wc -l)
        AFTER_SIZE=$(du -sh "$AUDIO_DIR" | cut -f1)
        
        echo ""
        echo "📊 After cleanup:"
        echo "   Files: $AFTER_COUNT"
        echo "   Size:  $AFTER_SIZE"
    fi
fi

rm -f "$SCAN_FILE"
cleanup_generated_audio
