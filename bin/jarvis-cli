#!/usr/bin/env bash
# Full Jarvis CLI; use the production environment regardless of the active shell venv.
set -euo pipefail
CLI_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
CLI_VENV=${JARVIS_VENV:-$HOME/jarvis-venv}
if [[ ! -f "$CLI_VENV/bin/activate" || ! -x "$CLI_VENV/bin/python" ]]; then
    echo "Jarvis production environment not found: $CLI_VENV. Run ./install.sh or set JARVIS_VENV." >&2
    exit 2
fi
CLI_VENV=$(cd "$CLI_VENV" && pwd -P)
if [[ -d "$CLI_ROOT/.venv" && "$CLI_VENV" == "$(cd "$CLI_ROOT/.venv" && pwd -P)" ]]; then
    echo "Jarvis CLI requires the production environment, not the repo .venv. Set JARVIS_VENV to your production environment." >&2
    exit 2
fi
source "$CLI_VENV/bin/activate"
cd "$CLI_ROOT"
exec "$CLI_VENV/bin/python" "$CLI_ROOT/lib/jarvis_cli.py" "$@"
