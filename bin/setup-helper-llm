#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="cloud"
DEFAULT_MODEL="bigsk1/jarvis-helper:minicpm5-1b-q4_k_m-v1"
MODEL_NAME=""
BASE_URL=""

usage() {
    printf '%s\n' \
        "Usage: ./bin/setup-helper-llm [--mode cloud|local] [--model NAME] [--base-url URL]" \
        "" \
        "Pulls the configured Jarvis helper model onto its native Ollama daemon." \
        "Defaults come from JARVIS_HELPER_LLM_MODEL and JARVIS_HELPER_LLM_BASE_URL" \
        "in the selected mode's ENV file."
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --mode)
            MODE="${2:?--mode requires cloud or local}"
            shift 2
            ;;
        --model)
            MODEL_NAME="${2:?--model requires a name}"
            shift 2
            ;;
        --base-url)
            BASE_URL="${2:?--base-url requires a URL}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown argument: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ "$MODE" != "cloud" && "$MODE" != "local" ]]; then
    printf 'Invalid mode: %s\n' "$MODE" >&2
    exit 2
fi

if ! command -v ollama >/dev/null 2>&1; then
    printf 'Ollama is required for the native helper model.\n' >&2
    exit 1
fi

if [[ -z "$MODEL_NAME" || -z "$BASE_URL" ]]; then
    PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
    if [[ ! -x "$PYTHON_BIN" ]]; then
        printf 'Missing repo environment. Run: uv sync --dev\n' >&2
        exit 1
    fi

    HELPER_CONFIG="$({
    PYTHONPATH="$ROOT_DIR/lib" \
    JARVIS_MODE="$MODE" \
    JARVIS_HELPER_DEFAULT_MODEL="$DEFAULT_MODEL" \
    "$PYTHON_BIN" - <<'PY'
import os

from config_loader import get_config_value, load_config

mode = os.environ["JARVIS_MODE"]
load_config(mode)
model = str(
    get_config_value(
        "JARVIS_HELPER_LLM_MODEL",
        os.environ["JARVIS_HELPER_DEFAULT_MODEL"],
    )
    or os.environ["JARVIS_HELPER_DEFAULT_MODEL"]
).strip()
base_url = str(
    get_config_value(
        "JARVIS_HELPER_LLM_BASE_URL",
        "http://127.0.0.1:11434",
    )
    or "http://127.0.0.1:11434"
).strip()
print(f"{model}\t{base_url}")
PY
    } | tail -n 1)"

    if [[ "$HELPER_CONFIG" != *$'\t'* ]]; then
        printf 'Could not read helper model configuration for %s mode.\n' "$MODE" >&2
        exit 1
    fi
    IFS=$'\t' read -r CONFIG_MODEL CONFIG_BASE_URL <<< "$HELPER_CONFIG"
    MODEL_NAME="${MODEL_NAME:-${CONFIG_MODEL:-$DEFAULT_MODEL}}"
    BASE_URL="${BASE_URL:-${CONFIG_BASE_URL:-http://127.0.0.1:11434}}"
fi

if [[ -z "$MODEL_NAME" || -z "$BASE_URL" ]]; then
    printf 'Helper model and base URL must not be empty.\n' >&2
    exit 2
fi

printf 'Pulling %s onto %s...\n' "$MODEL_NAME" "$BASE_URL"
OLLAMA_HOST="$BASE_URL" ollama pull "$MODEL_NAME"
OLLAMA_HOST="$BASE_URL" ollama show "$MODEL_NAME" >/dev/null
printf 'Ready: %s on %s\n' "$MODEL_NAME" "$BASE_URL"
