# ============================================================================
# MAIN APPLICATION
# ============================================================================

class CommandRunner(App):
    """The Main Application."""
    
    CSS = """
    Screen {
        layout: grid;
        grid-size: 2;
        grid-columns: 1fr 2fr; 
        grid-rows: 1fr 3;
        background: #0f172a;
    }

    /* LEFT PANE - COMMAND SELECTION */
    #left-pane {
        row-span: 1;
        background: #1e293b;
        border-right: solid #334155;
        height: 100%;
        overflow: hidden; /* Prevents container from stretching weirdly */
    }

    Input {
        dock: top;
        margin-bottom: 1;
        border: solid cyan;
    }

    /* FIX: Ensure TabPane and ListView fill vertical space */
    TabbedContent {
        height: 1fr;
    }
    
    TabPane {
        height: 1fr;
        padding: 0;
    }

    ListView {
        height: 100%;
        scrollbar-size-vertical: 1;
    }

    CommandItem {
        padding: 1;
        background: #334155 0%; 
        border-bottom: solid #475569;
        height: auto;
    }
    
    CommandItem:hover {
        background: #475569;
    }

    CommandItem.-highlight {
        background: #0ea5e9;
        border-left: solid white;
    }
    
    Label {
        color: #e2e8f0;
    }

    .cmd-name {
        text-style: bold;
    }
    
    .cmd-desc {
        color: #94a3b8; 
        text-style: italic;
    }

    /* RIGHT PANE - OUTPUT */
    #right-pane {
        row-span: 1;
        background: #0f172a;
        padding: 1;
        height: 100%;
    }

    RichLog {
        background: #0f172a;
        color: #e2e8f0;
        border: solid #334155;
        height: 1fr;
    }

    #status-bar {
        column-span: 2;
        height: 3;
        background: #1e293b;
        content-align: center middle;
        color: cyan;
        border-top: solid #334155;
    }
    """

    BINDINGS = [
        Binding("q", "quit", "Quit"),
        Binding("ctrl+c", "quit", "Quit"),
        Binding("c", "clear_log", "Clear Log"),
        Binding("/", "focus_search", "Search"),
    ]

    def compose(self) -> ComposeResult:
        """Create child widgets."""
        yield Header(show_clock=True)
        
        # LEFT PANE
        with Vertical(id="left-pane"):
            yield Input(placeholder="Search commands... (/)", id="search-box")
            
            with TabbedContent(id="tabs"):
                # 1. All Commands Tab
                with TabPane("All", id="tab-all"):
                    # Create CommandItems directly
                    items = [CommandItem(c) for c in COMMANDS]
                    yield ListView(*items, id="list-all")
                
                # 2. Category Tabs
                categories = sorted(list(set(c.category for c in COMMANDS)))
                for cat in categories:
                    clean_id = cat.split(" ")[-1].lower() # e.g. "Core" -> "core"
                    # Handle special chars if any, though "Core", "Services" etc are safe
                    clean_id = "".join(x for x in clean_id if x.isalnum())
                    
                    cat_cmds = [c for c in COMMANDS if c.category == cat]
                    items = [CommandItem(c) for c in cat_cmds]
                    
                    with TabPane(cat.split(" ")[-1], id=f"tab-{clean_id}"):
                        yield ListView(*items, id=f"list-{clean_id}")

        # RIGHT PANE
        with Vertical(id="right-pane"):
            yield Label("[bold cyan]System Output[/bold cyan]")
            yield RichLog(id="output-log", markup=True, wrap=True)

        yield SystemStatus(id="status-bar")
        yield Footer()

    def on_mount(self) -> None:
        self.query_one("#search-box").focus()

    def on_input_changed(self, event: Input.Changed) -> None:
        """Handle search filtering."""
        self.populate_lists(event.value)

    def on_tabbed_content_tab_activated(self, event: TabbedContent.TabActivated) -> None:
        """Refresh list when changing tabs."""
        try:
            val = self.query_one("#search-box", Input).value
            self.populate_lists(val)
        except:
            pass

    def populate_lists(self, filter_text: str):
        """Update lists based on search."""
        filter_text = filter_text.lower()
        
        # Helper to filter items
        def filter_cmd(cmd: Command) -> bool:
            if not filter_text: return True
            return (filter_text in cmd.name.lower() or 
                    filter_text in cmd.command.lower())

        # Update ALL List
        try:
            list_view = self.query_one("#list-all", ListView)
            list_view.clear()
            for cmd in COMMANDS:
                if filter_cmd(cmd):
                    list_view.append(CommandItem(cmd))
        except: pass

        # Update Category Lists
        categories = sorted(list(set(c.category for c in COMMANDS)))
        for cat in categories:
            clean_id = "".join(x for x in cat.split(" ")[-1].lower() if x.isalnum())
            try:
                list_view = self.query_one(f"#list-{clean_id}", ListView)
                list_view.clear()
                for cmd in COMMANDS:
                    if cmd.category == cat and filter_cmd(cmd):
                        list_view.append(CommandItem(cmd))
            except: pass

    def action_focus_search(self) -> None:
        self.query_one("#search-box").focus()

    def action_clear_log(self) -> None:
        self.query_one("#output-log", RichLog).clear()

    async def on_list_view_selected(self, event: ListView.Selected) -> None:
        """Handle selection using the custom CommandItem."""
        # 1. Get the custom item
        command_item = event.item
        
        # 2. Check type safety (just in case)
        if isinstance(command_item, CommandItem):
            cmd = command_item.command_obj
            await self.run_command(cmd)

    async def run_command(self, cmd: Command) -> None:
        """Execute command asynchronously."""
        log = self.query_one("#output-log", RichLog)
        
        log.write(f"\n[bold green]🚀 EXEC:[/bold green] {cmd.name}")
        log.write(f"[dim]{cmd.command}[/dim]\n")
        
        # Interactive commands need a real terminal - use tmux
        if cmd.interactive:
            await self.run_interactive_command(cmd)
            return
        
        # Run command with proper venv environment
        full_command = f"cd {PROJECT_ROOT} && {cmd.command}"
        
        try:
            process = await asyncio.create_subprocess_shell(
                full_command,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                env=get_env(),  # Use venv environment
                cwd=str(PROJECT_ROOT)
            )

            async def read_stream(stream, color):
                while True:
                    line = await stream.readline()
                    if not line: break
                    text = line.decode().strip()
                    if text: log.write(f"[{color}]{text}[/{color}]")

            await asyncio.gather(
                read_stream(process.stdout, "white"),
                read_stream(process.stderr, "red")
            )
            
            await process.wait()
            
            if process.returncode == 0:
                log.write(f"\n[bold green]✅ Finished[/bold green]")
            else:
                log.write(f"\n[bold red]❌ Failed (Code {process.returncode})[/bold red]")
                
        except Exception as e:
            log.write(f"\n[bold red]❌ Error: {e}[/bold red]")
            
        log.write("-" * 50)

    async def run_interactive_command(self, cmd: Command) -> None:
        """Run interactive commands in tmux (or show instructions)."""
        log = self.query_one("#output-log", RichLog)
        
        # Check if tmux is available
        tmux_check = await asyncio.create_subprocess_shell(
            "which tmux",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        await tmux_check.wait()
        has_tmux = tmux_check.returncode == 0
        
        # Check if we're inside tmux already
        in_tmux = os.environ.get("TMUX") is not None
        
        if has_tmux:
            # Create unique session/window names based on command
            window_name = cmd.name.lower().replace(" ", "-").replace("(", "").replace(")", "")
            
            # Determine session name based on command type
            if "jarvis" in cmd.command and ("./jarvis" == cmd.command or cmd.command.startswith("./jarvis-local")):
                session_name = "jarvis-voice"  # Wake word loop
            elif "jarvis-api" in cmd.command:
                session_name = "jarvis-api-local" if "--local" in cmd.command else "jarvis-api"
            elif "jarvis-services" in cmd.command:
                session_name = "jarvis-services"  # Background services
            elif "jarvis-canvas" in cmd.command:
                session_name = "jarvis-canvas"  # Canvas viewer
            else:
                session_name = window_name  # Use window name as session name
            
            # Activate venv and run command
            full_cmd = f"source {VENV_PATH}/bin/activate && cd {PROJECT_ROOT} && {cmd.command}"
            
            if in_tmux:
                # Create new window in current session
                tmux_cmd = f'tmux new-window -n "{window_name}" "{full_cmd}; read -p \'Press Enter to close...\'"'
                log.write(f"[cyan]🖥️  Opening in new tmux window: {window_name}[/cyan]")
                log.write(f"[dim]Switch windows: Ctrl+B then n (next) or p (prev)[/dim]")
            else:
                # Create new detached session (unique per service type)
                tmux_cmd = f'tmux new-session -d -s {session_name} -n "{window_name}" "{full_cmd}; read -p \'Press Enter to close...\'"'
                log.write(f"[cyan]🖥️  Started in tmux session: {session_name}[/cyan]")
                log.write(f"[yellow]To attach: tmux attach -t {session_name}[/yellow]")
            
            try:
                process = await asyncio.create_subprocess_shell(
                    tmux_cmd,
                    stdout=asyncio.subprocess.PIPE,
                    stderr=asyncio.subprocess.PIPE,
                    env=get_env(),
                    cwd=str(PROJECT_ROOT)
                )
                await process.wait()
                
                if process.returncode == 0:
                    log.write("[bold green]✅ Launched successfully[/bold green]")
                    if not in_tmux:
                        log.write("[dim]Jarvis is running in the background inside a tmux session.[/dim]")
                        log.write(f"[dim]Attach:  tmux attach -t {session_name}[/dim]")
                        log.write("[dim]Detach:  Press Ctrl+b, then d[/dim]")
                        log.write("[dim]List:    tmux ls[/dim]")
                        log.write(f"[dim]Stop:    tmux kill-session -t {session_name}[/dim]")

                else:
                    stderr = await process.stderr.read()
                    log.write(f"[bold red]❌ Failed to launch: {stderr.decode()}[/bold red]")
                    
            except Exception as e:
                log.write(f"[bold red]❌ Error: {e}[/bold red]")
        else:
            # No tmux - give manual instructions
            log.write(f"[yellow]⚠️  Interactive command requires a real terminal[/yellow]")
            log.write(f"[white]This command needs audio input and won't work captured.[/white]")
            log.write(f"")
            log.write(f"[cyan]Run manually in another terminal:[/cyan]")
            log.write(f"[bold white]cd {PROJECT_ROOT} && {cmd.command}[/bold white]")
            log.write(f"")
            log.write(f"[dim]Tip: Install tmux for better integration:[/dim]")
            log.write(f"[dim]  sudo apt install tmux[/dim]")
        
        log.write("-" * 50)

if __name__ == "__main__":
    app = CommandRunner()
    app.run()