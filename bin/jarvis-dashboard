#!/usr/bin/env python3
"""
Jarvis Command Center - State of the Art TUI
Powered by Textual & Rich
"""

import os
import sys
import asyncio
import psutil
import socket
from pathlib import Path
from typing import List, Optional
from dataclasses import dataclass

from textual.app import App, ComposeResult
from textual.containers import Vertical
from textual.widgets import (
    Header, Footer, Input, Static, 
    Label, ListItem, ListView, TabbedContent, TabPane, 
    RichLog
)
from textual.binding import Binding

# ============================================================================
# CONFIGURATION
# ============================================================================

PROJECT_ROOT = Path(__file__).parent.parent
VENV_PATH = Path.home() / "jarvis-venv"
VENV_PYTHON = str(VENV_PATH / "bin" / "python")

# Full environment setup for subprocess
def get_env():
    """Get environment with venv and PYTHONPATH set up."""
    env = os.environ.copy()
    env["PYTHONPATH"] = str(PROJECT_ROOT / "lib")
    env["PATH"] = f"{VENV_PATH}/bin:" + env.get("PATH", "")
    env["VIRTUAL_ENV"] = str(VENV_PATH)
    return env

@dataclass
class Command:
    name: str
    command: str
    description: str
    category: str
    dangerous: bool = False
    interactive: bool = False  # Commands that need a real terminal (audio, long-running)

# ============================================================================
# CUSTOM WIDGETS
# ============================================================================

class CommandItem(ListItem):
    """A custom ListItem that stores the Command object directly."""
    
    def __init__(self, command: Command) -> None:
        self.command_obj = command
        super().__init__()

    def compose(self) -> ComposeResult:
        if self.command_obj.dangerous:
            icon = "⚠️ "
        elif self.command_obj.interactive:
            icon = "🎙️ "
        else:
            icon = "🚀 "
        yield Label(f"{icon} {self.command_obj.name}", classes="cmd-name")
        yield Label(f"  {self.command_obj.description}", classes="cmd-desc")

class SystemStatus(Static):
    """A widget to display live system stats."""
    
    def on_mount(self) -> None:
        self.set_interval(2, self.update_stats)

    def update_stats(self) -> None:
        cpu = psutil.cpu_percent()
        ram = psutil.virtual_memory().percent
        
        # Check API Port (Non-blocking check)
        api_status = "⚪ CHECKING"
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(0.1)
            result = sock.connect_ex(('127.0.0.1', 8880))
            api_status = "🟢 ONLINE" if result == 0 else "🔴 OFFLINE"
            sock.close()
        except:
            pass

        self.update(f"CPU: {cpu}%  |  RAM: {ram}%  |  API: {api_status}")

