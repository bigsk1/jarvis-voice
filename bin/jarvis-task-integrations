#!/usr/bin/env python3
"""Explicit local credential-key bootstrap/rotation; no receiver or source enablement."""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path[:0] = [str(ROOT), str(ROOT / 'lib')]

from lib.background_tasks import TaskStore  # noqa: E402
from lib.webhook_integrations.service import IntegrationService  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('init-key', 'rotate-key', 'status'))
    parser.add_argument('--db', type=Path)
    parser.add_argument('--key', type=Path)
    args = parser.parse_args()
    value = IntegrationService(TaskStore(args.db), key_path=args.key)
    if args.action == 'status':
        result = value.status()
    else:
        value.store.initialize()
        result = value.initialize_key() if args.action == 'init-key' else value.rotate_key()
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
    main()
