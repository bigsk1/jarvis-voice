#!/bin/bash
# Start/Stop Jarvis Proactive Assistant API Server
# Runs FastAPI server for webhooks, alerts, and reminders
#
# Usage:
#   ./bin/jarvis-api              # Cloud mode (default)
#   ./bin/jarvis-api --local      # Local mode (Ollama)
#   ./bin/jarvis-api --stop       # Stop running server
#   ./bin/jarvis-api --local --stop  # Stop local mode server
#   ./bin/jarvis-api --status     # Check if running
#   ./bin/jarvis-api --restart    # Restart server

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
PID_FILE="$PROJECT_ROOT/logs/jarvis-api.pid"
PORT=8880

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Parse arguments
MODE_EXPLICIT=""
MODE="cloud"
ACTION="start"

for arg in "$@"; do
    case $arg in
        --local)
            MODE_EXPLICIT="local"
            ;;
        --stop)
            ACTION="stop"
            ;;
        --status)
            ACTION="status"
            ;;
        --restart)
            ACTION="restart"
            ;;
        --help|-h)
            echo "Usage: jarvis-api [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --local     Run in local mode (Ollama)"
            echo "  --stop      Stop the running server"
            echo "  --status    Check server status"
            echo "  --restart   Restart the server"
            echo "  --help      Show this help message"
            exit 0
            ;;
    esac
done

# Function to get running PID
get_running_pid() {
    # First check PID file
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "$pid"
            return 0
        fi
    fi
    
    # Fallback: check by port
    local pid=$(lsof -ti :$PORT 2>/dev/null | head -1)
    if [ -n "$pid" ]; then
        echo "$pid"
        return 0
    fi
    
    return 1
}

# Function to stop server
stop_server() {
    local pid=$(get_running_pid)
    
    if [ -z "$pid" ]; then
        echo -e "${YELLOW}⚠️  No jarvis-api server running on port $PORT${NC}"
        rm -f "$PID_FILE" 2>/dev/null
        return 0
    fi
    
    echo -e "${BLUE}🛑 Stopping jarvis-api (PID: $pid)...${NC}"
    kill "$pid" 2>/dev/null
    
    # Wait up to 5 seconds for graceful shutdown
    for i in {1..5}; do
        if ! kill -0 "$pid" 2>/dev/null; then
            echo -e "${GREEN}✅ Server stopped${NC}"
            rm -f "$PID_FILE" 2>/dev/null
            return 0
        fi
        sleep 1
    done
    
    # Force kill if still running
    echo -e "${YELLOW}⚠️  Forcing shutdown...${NC}"
    kill -9 "$pid" 2>/dev/null
    rm -f "$PID_FILE" 2>/dev/null
    echo -e "${GREEN}✅ Server stopped (forced)${NC}"
    return 0
}

# Function to check status
check_status() {
    local pid=$(get_running_pid)
    
    if [ -z "$pid" ]; then
        echo -e "${YELLOW}⚫ jarvis-api is NOT running${NC}"
        return 1
    fi
    
    echo -e "${GREEN}🟢 jarvis-api is running${NC}"
    echo -e "   PID:  ${BLUE}$pid${NC}"
    echo -e "   Port: ${BLUE}$PORT${NC}"
    echo -e "   URL:  ${BLUE}http://localhost:$PORT${NC}"
    
    # Check health endpoint
    if curl -s "http://localhost:$PORT/api/health" > /dev/null 2>&1; then
        echo -e "   Health: ${GREEN}✅ OK${NC}"
    else
        echo -e "   Health: ${YELLOW}⚠️  Not responding${NC}"
    fi
    
    return 0
}

# Handle actions
case $ACTION in
    stop)
        stop_server
        exit $?
        ;;
    status)
        check_status
        exit $?
        ;;
    restart)
        echo -e "${BLUE}🔄 Restarting jarvis-api...${NC}"
        stop_server
        sleep 2
        # Fall through to start
        ;;
esac

if [ -n "$MODE_EXPLICIT" ]; then
    MODE="$($PROJECT_ROOT/bin/resolve-jarvis-mode "$MODE_EXPLICIT")" || exit $?
else
    MODE="$($PROJECT_ROOT/bin/resolve-jarvis-mode)" || exit $?
fi

ENV_FILE="$PROJECT_ROOT/config/$MODE.env"
if [ ! -f "$ENV_FILE" ]; then
    echo -e "${RED}❌ config/$MODE.env not found${NC}"
    exit 1
fi
# shellcheck disable=SC1090
source "$ENV_FILE"
export JARVIS_MODE="$MODE"
export JARVIS_API_MODE="$MODE"

# Check if already running (for start action)
if [ "$ACTION" == "start" ]; then
    existing_pid=$(get_running_pid)
    if [ -n "$existing_pid" ]; then
        echo -e "${YELLOW}⚠️  jarvis-api already running (PID: $existing_pid)${NC}"
        echo -e "   Use ${BLUE}--stop${NC} to stop it first, or ${BLUE}--restart${NC} to restart"
        exit 1
    fi
fi

# === START SERVER ===

echo -e "${BLUE}╔═══════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║     Jarvis Proactive Assistant API Server            ║${NC}"
echo -e "${BLUE}╚═══════════════════════════════════════════════════════╝${NC}"
echo ""

# Check if venv is activated
if [ -z "$VIRTUAL_ENV" ]; then
    echo -e "${YELLOW}⚠️  Python virtual environment not activated${NC}"
    echo -e "${YELLOW}   Attempting to activate jarvis-venv...${NC}"
    
    if [ -d "$HOME/jarvis-venv" ]; then
        source "$HOME/jarvis-venv/bin/activate"
        echo -e "${GREEN}✅ Virtual environment activated${NC}"
    else
        echo -e "${RED}❌ jarvis-venv not found. Please run:${NC}"
        echo -e "${RED}   python3 -m venv ~/jarvis-venv${NC}"
        echo -e "${RED}   source ~/jarvis-venv/bin/activate${NC}"
        echo -e "${RED}   pip install -r requirements.txt${NC}"
        exit 1
    fi
fi

# Check if uvicorn is installed
if ! python3 -c "import uvicorn" 2>/dev/null; then
    echo -e "${RED}❌ uvicorn not installed${NC}"
    echo -e "${YELLOW}   Installing FastAPI and uvicorn...${NC}"
    pip install fastapi uvicorn[standard] >/dev/null 2>&1
    echo -e "${GREEN}✅ Dependencies installed${NC}"
fi

# Initialize and migrate only the selected Memory database.
SELECTED_DB="$PROJECT_ROOT/data/jarvis_memory$([ "$MODE" = local ] && echo _local).db"
python3 -c "import sys; sys.path.insert(0, '$PROJECT_ROOT/lib'); from memory_db import MemoryDB; db=MemoryDB('$SELECTED_DB'); db.close()"
if ! sqlite3 "$SELECTED_DB" "SELECT name FROM sqlite_master WHERE type='table' AND name='alerts'" | grep -q alerts; then
    echo -e "${YELLOW}⚠️  Database not migrated. Running migration...${NC}"
    "$PROJECT_ROOT/bin/migrate-proactive-db.py" "$MODE"
    echo ""
fi

# Fail closed before startup sync can mix an old or partially rebuilt vector
# namespace with the configured Jarvis Embedding artifact.
EMBEDDING_PREFLIGHT_OK=true
if ! python3 "$PROJECT_ROOT/bin/check-embeddings-health.py" "$MODE" --json > /dev/null 2>&1; then
    EMBEDDING_PREFLIGHT_OK=false
    echo -e "${RED}❌ Embedding fingerprint preflight failed${NC}"
    echo -e "${YELLOW}   Semantic retrieval and Tool RAG embedding writes remain disabled.${NC}"
    echo -e "${YELLOW}   Inspect: ./bin/check-embeddings-health.py $MODE${NC}"
    echo -e "${YELLOW}   Recover: ./bin/rebuild-embeddings $MODE (or delete the incompatible DB).${NC}"
    echo ""
fi

# Sync databases between cloud and local modes
if [ "$MODE" == "local" ]; then
    # Running in local mode - sync from cloud to local if cloud DB exists
    if [ -f "$PROJECT_ROOT/data/jarvis_memory.db" ]; then
        echo -e "${BLUE}🔄 Syncing data: cloud → local...${NC}"
        "$PROJECT_ROOT/bin/sync-memory-db.py" --from cloud --to local
        echo ""
    fi
else
    # Running in cloud mode - sync from local to cloud if local DB exists
    if [ -f "$PROJECT_ROOT/data/jarvis_memory_local.db" ]; then
        echo -e "${BLUE}🔄 Syncing data: local → cloud...${NC}"
        "$PROJECT_ROOT/bin/sync-memory-db.py" --from local --to cloud
        echo ""
    fi
fi

# Optional: Sync evolution data (prompt versions) between modes
# Set EVOLUTION_AUTO_SYNC=true in your .env to enable
# Default: false (manual sync recommended - evolution changes tool behavior)
if [ "${EVOLUTION_AUTO_SYNC:-false}" == "true" ]; then
    if [ "$MODE" == "local" ]; then
        if [ -f "$PROJECT_ROOT/data/jarvis_memory.db" ]; then
            echo -e "${BLUE}🧬 Syncing evolution data: cloud → local...${NC}"
            "$PROJECT_ROOT/bin/sync-evolution-db.py" local --update-files 2>/dev/null && \
                echo -e "${GREEN}  ✅ Evolution data synced${NC}" || \
                echo -e "${YELLOW}  ⚠️  Evolution sync skipped (no changes)${NC}"
            echo ""
        fi
    else
        if [ -f "$PROJECT_ROOT/data/jarvis_memory_local.db" ]; then
            echo -e "${BLUE}🧬 Syncing evolution data: local → cloud...${NC}"
            "$PROJECT_ROOT/bin/sync-evolution-db.py" cloud --update-files 2>/dev/null && \
                echo -e "${GREEN}  ✅ Evolution data synced${NC}" || \
                echo -e "${YELLOW}  ⚠️  Evolution sync skipped (no changes)${NC}"
            echo ""
        fi
    fi
fi

# Sync tool definitions to vector database
echo -e "${BLUE}🔧 Syncing tool definitions...${NC}"
TOOL_SYNC_LOG="$PROJECT_ROOT/logs/tool-sync-${MODE}.log"
if [ "$EMBEDDING_PREFLIGHT_OK" != true ]; then
    echo -e "${YELLOW}  ⚠️  Tool embedding sync skipped until the fingerprint is repaired${NC}"
elif python3 "$PROJECT_ROOT/bin/sync-tools.py" "$MODE" > "$TOOL_SYNC_LOG" 2>&1; then
    echo -e "${GREEN}  ✅ Tool embeddings updated${NC}"
else
    TOOL_SYNC_STATUS=$?
    echo -e "${YELLOW}  ⚠️  Tool embedding sync incomplete (exit $TOOL_SYNC_STATUS)${NC}"
    echo -e "${YELLOW}     Existing Tool RAG vectors were preserved; the API will still start.${NC}"
    echo -e "${YELLOW}     Details: $TOOL_SYNC_LOG${NC}"
    tail -20 "$TOOL_SYNC_LOG" >&2
fi
echo ""

# Health check: Verify embedding dimensions are correct
echo -e "${BLUE}🩺 Checking embedding health...${NC}"
if python3 "$PROJECT_ROOT/bin/check-embeddings-health.py" "$MODE" --json > /dev/null 2>&1; then
    echo -e "${GREEN}  ✅ Jarvis Embedding fingerprints healthy (768 dimensions)${NC}"
else
    echo -e "${RED}  ❌ Embedding fingerprint or vector health check failed!${NC}"
    echo -e "${YELLOW}     Run: ./bin/check-embeddings-health.py $MODE${NC}"
    echo -e "${YELLOW}     Semantic retrieval is fail-closed; lexical fallback remains available.${NC}"
    echo ""
    # Don't exit, but warn loudly
fi
echo ""

echo -e "${GREEN}📡 Starting API server...${NC}"
echo -e "   Mode: ${BLUE}$MODE${NC}"
echo -e "   Port: ${BLUE}$PORT${NC}"
echo -e "   Docs: ${BLUE}http://localhost:$PORT/docs${NC}"
if [ "$MODE" == "local" ]; then
    echo -e "   TTS:  ${BLUE}say-local.sh${NC} (provider-specific KOKORO_TTS_URL or QWEN3_TTS_URL)"
else
    echo -e "   TTS:  ${BLUE}say.sh${NC} (OpenAI)"
fi
echo ""
echo -e "${GREEN}Ready for webhooks!${NC}"
echo -e "   POST http://localhost:$PORT/api/alerts"
echo -e "   POST http://localhost:$PORT/api/reminders"
echo -e "   POST http://localhost:$PORT/api/voice/speak"
echo -e "   GET  http://localhost:$PORT/api/intelligence/stats"
echo ""
echo -e "${YELLOW}Press Ctrl+C to stop (or use: jarvis-api --stop)${NC}"
echo ""

# Run server and save PID (skip in Docker — API runs in its own container)
cd "$PROJECT_ROOT/api"
python3 server.py &
SERVER_PID=$!

if [ "${JARVIS_DEPLOYMENT:-}" != "docker" ]; then
    echo $SERVER_PID > "$PID_FILE"
fi

# Wait for server
wait $SERVER_PID

# Cleanup PID file on exit
if [ "${JARVIS_DEPLOYMENT:-}" != "docker" ]; then
    rm -f "$PID_FILE" 2>/dev/null
fi
