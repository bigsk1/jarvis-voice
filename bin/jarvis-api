#!/bin/bash
# Start Jarvis Proactive Assistant API Server
# Runs FastAPI server for webhooks, alerts, and reminders
#
# Usage:
#   ./bin/jarvis-api         # Cloud mode (default)
#   ./bin/jarvis-api --local # Local mode (Ollama)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Parse arguments
MODE="cloud"
if [ "$1" == "--local" ]; then
    MODE="local"
fi

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${BLUE}╔═══════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║     Jarvis Proactive Assistant API Server            ║${NC}"
echo -e "${BLUE}╚═══════════════════════════════════════════════════════╝${NC}"
echo ""

# Check if venv is activated
if [ -z "$VIRTUAL_ENV" ]; then
    echo -e "${YELLOW}⚠️  Python virtual environment not activated${NC}"
    echo -e "${YELLOW}   Attempting to activate jarvis-venv...${NC}"
    
    if [ -d "$HOME/jarvis-venv" ]; then
        source "$HOME/jarvis-venv/bin/activate"
        echo -e "${GREEN}✅ Virtual environment activated${NC}"
    else
        echo -e "${RED}❌ jarvis-venv not found. Please run:${NC}"
        echo -e "${RED}   python3 -m venv ~/jarvis-venv${NC}"
        echo -e "${RED}   source ~/jarvis-venv/bin/activate${NC}"
        echo -e "${RED}   pip install -r requirements.txt${NC}"
        exit 1
    fi
fi

# Check if uvicorn is installed
if ! python3 -c "import uvicorn" 2>/dev/null; then
    echo -e "${RED}❌ uvicorn not installed${NC}"
    echo -e "${YELLOW}   Installing FastAPI and uvicorn...${NC}"
    pip install fastapi uvicorn[standard] >/dev/null 2>&1
    echo -e "${GREEN}✅ Dependencies installed${NC}"
fi

# Check if database is migrated
if ! sqlite3 "$PROJECT_ROOT/data/jarvis_memory.db" "SELECT name FROM sqlite_master WHERE type='table' AND name='alerts'" | grep -q alerts; then
    echo -e "${YELLOW}⚠️  Database not migrated. Running migration...${NC}"
    "$PROJECT_ROOT/bin/migrate-proactive-db.py"
    echo ""
fi

# Sync databases between cloud and local modes
if [ "$MODE" == "local" ]; then
    # Running in local mode - sync from cloud to local if cloud DB exists
    if [ -f "$PROJECT_ROOT/data/jarvis_memory.db" ]; then
        echo -e "${BLUE}🔄 Syncing data: cloud → local...${NC}"
        "$PROJECT_ROOT/bin/sync-memory-db.py" --from cloud --to local
        echo ""
    fi
else
    # Running in cloud mode - sync from local to cloud if local DB exists
    if [ -f "$PROJECT_ROOT/data/jarvis_memory_local.db" ]; then
        echo -e "${BLUE}🔄 Syncing data: local → cloud...${NC}"
        "$PROJECT_ROOT/bin/sync-memory-db.py" --from local --to cloud
        echo ""
    fi
fi

# Sync tool definitions to vector database
echo -e "${BLUE}🔧 Syncing tool definitions...${NC}"
python3 "$PROJECT_ROOT/bin/sync_tools.py" "$MODE" > /dev/null 2>&1
echo -e "${GREEN}  ✅ Tool embeddings updated${NC}"
echo ""

# Load appropriate config
if [ "$MODE" == "local" ]; then
    if [ -f "$PROJECT_ROOT/config/local.env" ]; then
        source "$PROJECT_ROOT/config/local.env"
        export LLM_PROVIDER="ollama"
    else
        echo -e "${RED}❌ config/local.env not found${NC}"
        exit 1
    fi
else
    if [ -f "$PROJECT_ROOT/config/cloud.env" ]; then
        source "$PROJECT_ROOT/config/cloud.env"
        export LLM_PROVIDER={$LLM_PROVIDER}
    else
        echo -e "${RED}❌ config/cloud.env not found${NC}"
        exit 1
    fi
fi

echo -e "${GREEN}📡 Starting API server...${NC}"
echo -e "   Mode: ${BLUE}$MODE${NC}"
echo -e "   Port: ${BLUE}8880${NC}"
echo -e "   Docs: ${BLUE}http://localhost:8880/docs${NC}"
if [ "$MODE" == "local" ]; then
    echo -e "   TTS:  ${BLUE}say-local.sh${NC} (Kokoro - requires server at $TTS_URL)"
else
    echo -e "   TTS:  ${BLUE}say.sh${NC} (OpenAI)"
fi
echo ""
echo -e "${GREEN}Ready for webhooks!${NC}"
echo -e "   POST http://localhost:8880/api/alerts"
echo -e "   POST http://localhost:8880/api/reminders"
echo -e "   POST http://localhost:8880/api/voice/speak"
echo ""
echo -e "${YELLOW}Press Ctrl+C to stop${NC}"
echo ""

# Export mode for Python
export JARVIS_API_MODE="$MODE"

# Run server
cd "$PROJECT_ROOT/api"
python3 server.py

