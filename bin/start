#!/bin/bash
#
# Jarvis Start Script
# Starts all Jarvis services in tmux sessions
#
# Usage:
#   ./bin/start              # Start all services (API first, wait, then others)
#   ./bin/start <service>    # Start one service by name
#   ./bin/start --ui-only    # Start only UI services (web, canvas, memory, intelligence, docs)
#   ./bin/start --local      # Start all services with config/local.env
#   ./bin/start --no-api     # Start everything except API (skip sync)
#   ./bin/start --list       # Show tmux session status
#   ./bin/start --stop       # Stop all Jarvis sessions
#
# Session names (same as jarvis-dashboard):
#   jarvis-api          - API server (port 8880) - does DB/evolution/tool-rag sync
#   jarvis-services     - Background services - does DB/evolution/tool-rag sync  
#   jarvis-web          - Web UI (port 5001)
#   jarvis-canvas       - Canvas viewer (port 8890)
#   jarvis-memory       - Memory Browser UI (port 5002)
#   jarvis-intelligence - Intelligence Dashboard (port 5003)
#   jarvis-docs         - Docs Reader (port 5004)
#
# Notes:
#   - API and Services both perform sync operations on startup
#   - Don't start them simultaneously (script waits between them)
#   - Attach to any session: tmux attach -t <session-name>
#   - Detach: Ctrl+B then D

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VENV_PATH="${JARVIS_VENV:-$HOME/jarvis-venv}"

MODE_EXPLICIT=""
ACTION=""
for arg in "$@"; do
    case "$arg" in
        --local)
            [ -z "$MODE_EXPLICIT" ] || { echo "Duplicate option: --local" >&2; exit 2; }
            MODE_EXPLICIT="local"
            ;;
        --ui-only|--no-api|--list|-l|--stop|-s|--help|-h|api|services|web|canvas|memory|intelligence|docs)
            [ -z "$ACTION" ] || { echo "Multiple actions specified: $ACTION and $arg" >&2; exit 2; }
            ACTION="$arg"
            ;;
        *)
            echo "Unknown option: $arg" >&2
            exit 2
            ;;
    esac
done

require_arg=()
case "$ACTION" in
    --list|-l|--stop|-s|--help|-h) ;;
    *) require_arg=(--require-config) ;;
esac
if [ -n "$MODE_EXPLICIT" ]; then
    MODE="$($PROJECT_ROOT/bin/resolve-jarvis-mode "$MODE_EXPLICIT" "${require_arg[@]}")"
else
    MODE="$($PROJECT_ROOT/bin/resolve-jarvis-mode "${require_arg[@]}")"
fi
ACTION="${ACTION:-all}"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Session names (must match jarvis-dashboard)
declare -A SESSIONS=(
    ["api"]="jarvis-api"
    ["services"]="jarvis-services"
    ["web"]="jarvis-web"
    ["canvas"]="jarvis-canvas"
    ["memory"]="jarvis-memory"
    ["intelligence"]="jarvis-intelligence"
    ["docs"]="jarvis-docs"
)

# Short-lived sessions created by the TUI while startup is in progress.
CONTROL_SESSIONS=(
    "jarvis-start-all"
    "jarvis-start-all-local"
    "jarvis-start-ui"
    "jarvis-start-ui-local"
    "🚀-start-all-services"  # Legacy dashboard session name
    "🚀-start-ui-only"       # Legacy dashboard session name
)

# Commands for each service
declare -A COMMANDS=(
    ["api"]="./bin/jarvis-api$([ "$MODE" = local ] && echo ' --local')"
    ["services"]="./bin/jarvis-services$([ "$MODE" = local ] && echo ' --local')"
    ["web"]="./bin/jarvis-web$([ "$MODE" = local ] && echo ' local')"
    ["canvas"]="./bin/jarvis-canvas$([ "$MODE" = local ] && echo ' local')"
    ["memory"]="./bin/jarvis-memory$([ "$MODE" = local ] && echo ' local')"
    ["intelligence"]="./bin/jarvis-intelligence$([ "$MODE" = local ] && echo ' local')"
    ["docs"]="./bin/jarvis-docs$([ "$MODE" = local ] && echo ' local')"
)

# Ports for health checks
declare -A PORTS=(
    ["api"]="8880"
    ["services"]=""
    ["web"]="5001"
    ["canvas"]="8890"
    ["memory"]="5002"
    ["intelligence"]="5003"
    ["docs"]="5004"
)

# Health check endpoints
declare -A HEALTH_ENDPOINTS=(
    ["api"]="/api/health"
    ["web"]="/api/status"
    ["canvas"]="/api/health"
    ["memory"]="/api/status"
    ["intelligence"]="/api/status"
    ["docs"]="/api/status"
)

log() {
    echo -e "${BLUE}[$(date '+%H:%M:%S')]${NC} $1"
}

success() {
    echo -e "${GREEN}✅ $1${NC}"
}

warn() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

error() {
    echo -e "${RED}❌ $1${NC}"
}

log_api_startup_error() {
    local service_name=$1
    local timeout_seconds=$2
    local message=$3

    JARVIS_START_ERROR_SERVICE="$service_name" \
    JARVIS_START_ERROR_TIMEOUT="$timeout_seconds" \
    JARVIS_START_ERROR_MESSAGE="$message" \
    JARVIS_START_ERROR_MODE="$MODE" \
    JARVIS_START_ERROR_SESSION="${SESSIONS[$service_name]:-unknown}" \
    JARVIS_START_ERROR_ROOT="$PROJECT_ROOT" \
    python3 - <<'PY' 2>/dev/null || true
import json
import os
from datetime import datetime
from pathlib import Path

service = os.environ["JARVIS_START_ERROR_SERVICE"]
timeout_seconds = int(os.environ["JARVIS_START_ERROR_TIMEOUT"])
log_dir = Path(os.environ["JARVIS_START_ERROR_ROOT"]) / "logs" / "api"
log_dir.mkdir(parents=True, exist_ok=True)
log_file = log_dir / f"errors-{datetime.now().strftime('%Y-%m-%d')}.jsonl"
entry = {
    "timestamp": datetime.now().isoformat(),
    "service": "jarvis-startup",
    "event": "service_health_timeout",
    "method": "START",
    "path": f"/startup/{service}",
    "query": None,
    "status": 504,
    "duration_ms": timeout_seconds * 1000,
    "client_ip": "localhost",
    "request_body": None,
    "error": os.environ["JARVIS_START_ERROR_MESSAGE"],
    "startup_mode": os.environ["JARVIS_START_ERROR_MODE"],
    "session": os.environ["JARVIS_START_ERROR_SESSION"],
    "timeout_seconds": timeout_seconds,
}
with log_file.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(entry) + "\n")
PY
}

is_session_running() {
    tmux has-session -t "$1" 2>/dev/null
}

reported_mode() {
    local name=$1
    if [ "$name" = "services" ]; then
        [ -f "$PROJECT_ROOT/logs/services_mode" ] && tr -d '[:space:]' < "$PROJECT_ROOT/logs/services_mode"
        return 0
    fi
    local port=${PORTS[$name]}
    local endpoint=${HEALTH_ENDPOINTS[$name]}
    curl -sf "http://localhost:${port}${endpoint}" 2>/dev/null | python3 -c \
        'import json,sys; d=json.load(sys.stdin); print(d.get("startup_mode") or d.get("env_mode") or "")' 2>/dev/null || true
}

verify_running_mode() {
    local name=$1
    local actual
    actual=$(reported_mode "$name")
    if [ "$actual" = "$MODE" ]; then
        success "${SESSIONS[$name]} already running in $MODE mode"
        return 0
    fi
    if [ -z "$actual" ] || [ "$actual" = "not set" ]; then
        error "${SESSIONS[$name]} is running, but its mode cannot be verified; stop and restart this service after the mode-plumbing upgrade."
    else
        error "${SESSIONS[$name]} is already running in $actual mode; stop it before starting $MODE mode."
    fi
    return 1
}

start_service() {
    local name=$1
    local session=${SESSIONS[$name]}
    local cmd=${COMMANDS[$name]}
    
    if is_session_running "$session"; then
        verify_running_mode "$name"
        return $?
    fi
    if [ "$name" = "services" ] && [ "$(check_services_pids)" -gt 0 ]; then
        verify_running_mode "$name"
        return $?
    fi
    
    log "Starting $session..."
    
    # Create tmux session with venv activation
    tmux new-session -d -s "$session" -n "$name" \
        "source $VENV_PATH/bin/activate && cd $PROJECT_ROOT && JARVIS_MODE=$MODE $cmd; read -p 'Press Enter to close...'"
    
    success "$session started"
}

wait_for_health() {
    local name=$1
    local port=${PORTS[$name]}
    local endpoint=${HEALTH_ENDPOINTS[$name]}
    local max_wait=${JARVIS_START_HEALTH_TIMEOUT_SECONDS:-300}
    local waited=0
    
    if [ -z "$port" ]; then
        return 0
    fi
    
    log "Waiting for $name to be ready (max ${max_wait}s)..."
    
    while [ $waited -lt $max_wait ]; do
        if [ "$(reported_mode "$name")" = "$MODE" ]; then
            success "$name is ready!"
            return 0
        fi
        sleep 2
        waited=$((waited + 2))
        echo -n "."
    done
    
    echo ""
    local timeout_message="$name did not become ready in $MODE mode within ${max_wait}s"
    error "$timeout_message"
    log_api_startup_error "$name" "$max_wait" "$timeout_message"
    return 1
}

stop_all() {
    log "Stopping all Jarvis sessions..."

    # Stop an in-progress dashboard launch before it can create more sessions.
    for session in "${CONTROL_SESSIONS[@]}"; do
        if is_session_running "$session"; then
            tmux kill-session -t "$session" 2>/dev/null && success "Stopped $session" || true
        fi
    done
    
    # Stop background service daemons first (they run via nohup, not just tmux)
    local running_daemons=$(check_services_pids)
    if [ "$running_daemons" -gt 0 ]; then
        "$PROJECT_ROOT/bin/jarvis-services" --stop 2>/dev/null || true
    fi
    
    # Stop all tmux sessions
    for name in "${!SESSIONS[@]}"; do
        local session=${SESSIONS[$name]}
        if is_session_running "$session"; then
            tmux kill-session -t "$session" 2>/dev/null && success "Stopped $session" || true
        fi
    done
    
    success "All sessions stopped"
}

check_services_pids() {
    # Check if background service daemons are running via PID files
    local running=0
    local piddir="$PROJECT_ROOT/logs"
    
    for pidfile in follow_up_daemon.pid self_healing_daemon.pid reminder_scheduler.pid scheduled_task_runner.pid; do
        if [ -f "$piddir/$pidfile" ]; then
            local pid=$(cat "$piddir/$pidfile")
            if kill -0 "$pid" 2>/dev/null; then
                running=$((running + 1))
            fi
        fi
    done
    
    echo $running
}

list_sessions() {
    echo ""
    echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}                    JARVIS SESSION STATUS                       ${NC}"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    for name in api services web canvas memory intelligence docs; do
        local session=${SESSIONS[$name]}
        local port=${PORTS[$name]}
        local status=""
        local health=""
        
        # Special handling for services - check PID files, not tmux session
        if [ "$name" == "services" ]; then
            local running_daemons=$(check_services_pids)
            if [ "$running_daemons" -eq 4 ]; then
                status="${GREEN}RUNNING${NC}"
                health="${GREEN}✓ 4/4 daemons${NC}"
            elif [ "$running_daemons" -gt 0 ]; then
                status="${YELLOW}PARTIAL${NC}"
                health="${YELLOW}$running_daemons/4 daemons${NC}"
            else
                status="${RED}STOPPED${NC}"
                health=""
            fi
        elif is_session_running "$session"; then
            status="${GREEN}RUNNING${NC}"
            
            # Check health if port exists
            if [ -n "$port" ]; then
                local endpoint=${HEALTH_ENDPOINTS[$name]}
                if curl -sf "http://localhost:${port}${endpoint}" > /dev/null 2>&1; then
                    health="${GREEN}✓ healthy${NC}"
                else
                    health="${YELLOW}? starting${NC}"
                fi
            else
                health="${BLUE}(background)${NC}"
            fi
        else
            status="${RED}STOPPED${NC}"
            health=""
        fi
        
        printf "  %-18s %b  %b\n" "$session" "$status" "$health"
    done
    
    echo ""
    echo -e "${BLUE}───────────────────────────────────────────────────────────────${NC}"
    echo "  Commands:"
    echo "    Attach:  tmux attach -t <session-name>"
    echo "    Detach:  Ctrl+B then D"
    echo "    List:    tmux ls"
    echo "    Stop:    ./bin/start --stop"
    echo "    Services: ./bin/jarvis-services --status"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
}

start_ui_only() {
    echo ""
    echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}              STARTING JARVIS UI SERVICES ONLY                  ${NC}"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    start_service "web"
    start_service "canvas"
    start_service "memory"
    start_service "intelligence"
    start_service "docs"
    
    echo ""
    success "UI services started!"
    echo ""
    echo "  Web UI:        http://localhost:5001"
    echo "  Canvas:        http://localhost:8890"
    echo "  Memory:        http://localhost:5002"
    echo "  Intelligence:  http://localhost:5003"
    echo "  Docs:          http://localhost:5004"
    echo ""
}

start_no_api() {
    echo ""
    echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}           STARTING JARVIS SERVICES (NO API/SYNC)               ${NC}"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    start_service "services"
    start_service "web"
    start_service "canvas"
    start_service "memory"
    start_service "intelligence"
    start_service "docs"
    
    echo ""
    success "Services started (no API sync)!"
    echo ""
}

start_all() {
    echo ""
    echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}                  STARTING ALL JARVIS SERVICES                  ${NC}"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    # Start API first (does sync operations)
    start_service "api"
    
    # Wait for API to be ready before starting services
    # (both do sync, so we don't want them running simultaneously)
    wait_for_health "api"
    
    echo ""
    log "API sync should be complete. Starting remaining services..."
    echo ""
    
    # Now start services (also does sync, but API is done)
    start_service "services"
    
    # Start UI services (lightweight, no sync)
    start_service "web"
    start_service "canvas"
    start_service "memory"
    start_service "intelligence"
    start_service "docs"
    
    echo ""
    echo -e "${GREEN}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}                    ALL SERVICES STARTED!                       ${NC}"
    echo -e "${GREEN}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo "  API:           http://localhost:8880"
    echo "  Web UI:        http://localhost:5001"
    echo "  Canvas:        http://localhost:8890"
    echo "  Memory:        http://localhost:5002"
    echo "  Intelligence:  http://localhost:5003"
    echo "  Docs:          http://localhost:5004"
    echo ""
    echo "  Attach to any session:  tmux attach -t <session-name>"
    echo "  Check status:           ./bin/start --list"
    echo "  Stop all:               ./bin/start --stop"
    echo ""
}

show_help() {
    echo ""
    echo "Jarvis Start Script"
    echo ""
    echo "Usage:"
    echo "  ./bin/start              Start all services (API first, wait for sync, then others)"
    echo "  ./bin/start [--local] [service]  Start all or one service in the selected startup mode"
    echo "  ./bin/start --ui-only    Start only UI services (web, canvas, memory, intelligence, docs)"
    echo "  ./bin/start --no-api     Start everything except API (skip sync wait)"
    echo "  ./bin/start --list       Show tmux session status"
    echo "  ./bin/start --stop       Stop all Jarvis sessions"
    echo "  ./bin/start --help       Show this help"
    echo "  --local may appear before or after an action; cloud remains the default"
    echo ""
    echo "Sessions:"
    echo "  jarvis-api          API server (port 8880) - does DB/evolution/tool-rag sync"
    echo "  jarvis-services     Background services - does DB/evolution/tool-rag sync"
    echo "  jarvis-web          Web UI (port 5001)"
    echo "  jarvis-canvas       Canvas viewer (port 8890)"
    echo "  jarvis-memory       Memory Browser UI (port 5002)"
    echo "  jarvis-intelligence Intelligence Dashboard (port 5003)"
    echo "  jarvis-docs         Docs Reader (port 5004)"
    echo ""
}

# Native launchers intentionally do not read the Compose-only root .env.
if [ "$MODE" = "cloud" ] && [ ! -f "$PROJECT_ROOT/config/cloud.env" ] && [ -f "$PROJECT_ROOT/config/local.env" ]; then
    warn "config/cloud.env not found but config/local.env exists."
    echo "    For a local-only setup use: ./bin/start --local"
fi

# Main
case "$ACTION" in
    --ui-only)
        start_ui_only
        ;;
    --no-api)
        start_no_api
        ;;
    --list|-l)
        list_sessions
        ;;
    --stop|-s)
        stop_all
        ;;
    --help|-h)
        show_help
        ;;
    api|services|web|canvas|memory|intelligence|docs)
        start_service "$ACTION"
        ;;
    all)
        start_all
        ;;
esac
