#!/usr/bin/env python3
"""
OpenCode Log Viewer
View and analyze OpenCode session activity logs.
"""
import sys
import os
import json
from datetime import datetime

# Add lib to path
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'lib'))
from opencode_logger import OpenCodeLogger


def print_log_entry(entry, verbose=False):
    """Pretty print a log entry."""
    timestamp = datetime.fromisoformat(entry["timestamp"]).strftime("%H:%M:%S")
    event = entry["event"]
    session_id = entry.get("session_id", "N/A")[:20] + "..."
    
    if event == "session_start":
        print(f"{timestamp} | 🚀 START | Session: {session_id}")
        if verbose:
            print(f"  Task: {entry.get('task', '')[:100]}...")
            print(f"  Type: {entry.get('task_type', 'general')}")
            print(f"  Model: {entry.get('model', {})}")
    
    elif event == "message_sent":
        msg_type = entry.get("message_type", "unknown")
        icon = "📤"
        if msg_type == "system":
            icon = "⚙️"
        elif msg_type == "context":
            icon = "📋"
        print(f"{timestamp} | {icon} SENT  | {msg_type.upper():8s} | {entry.get('message_preview', '')[:60]}...")
        if verbose:
            print(f"  Length: {entry.get('message_length', 0)} chars")
            print(f"  No reply: {entry.get('no_reply', False)}")
    
    elif event == "message_received":
        duration = entry.get("duration_ms", 0)
        has_error = entry.get("has_error", False)
        status = "❌" if has_error else "✅"
        resp_len = entry.get("response_length", 0)
        print(f"{timestamp} | {status} RECV  | Duration: {duration:.0f}ms | {resp_len} chars")
        if verbose:
            resp_info = entry.get("response_info", {})
            print(f"  Model: {resp_info.get('model_used', 'unknown')}")
            print(f"  Tokens: {resp_info.get('tokens', {})}")
            print(f"  Message ID: {resp_info.get('message_id', 'N/A')}")
            # Show actual response content
            if entry.get("response_preview"):
                print(f"  OpenCode Response:")
                print(f"  {entry['response_preview'][:300]}...")
    
    elif event == "session_complete":
        success = entry.get("success", False)
        status = "✅" if success else "❌"
        print(f"{timestamp} | {status} DONE  | Session: {session_id}")
        if verbose:
            if entry.get("result_summary"):
                print(f"  Summary: {entry['result_summary']}")
            if entry.get("error"):
                print(f"  Error: {entry['error']}")
    
    elif event == "error":
        print(f"{timestamp} | ❌ ERROR | {entry.get('error_type', 'Unknown')}: {entry.get('error_message', '')[:60]}")
        if verbose:
            print(f"  Session: {entry.get('session_id', 'N/A')}")
            print(f"  Context: {json.dumps(entry.get('context', {}), indent=2)}")
    
    if verbose:
        print()


def show_recent(limit=20, verbose=False):
    """Show recent OpenCode activity."""
    logger = OpenCodeLogger()
    logs = logger.get_recent_logs(limit)
    
    if not logs:
        print("No OpenCode activity logged yet.")
        return
    
    print(f"\n📊 Recent OpenCode Activity (last {limit})")
    print("=" * 100)
    print(f"{'Time':8s} | {'Event':10s} | {'Details'}")
    print("-" * 100)
    
    for entry in logs:
        print_log_entry(entry, verbose)


def show_session(session_id, verbose=False):
    """Show all activity for a specific session."""
    logger = OpenCodeLogger()
    logs = logger.get_session_logs(session_id)
    
    if not logs:
        print(f"No logs found for session: {session_id}")
        return
    
    print(f"\n📊 OpenCode Session: {session_id}")
    print("=" * 100)
    print(f"{'Time':8s} | {'Event':10s} | {'Details'}")
    print("-" * 100)
    
    for entry in logs:
        print_log_entry(entry, verbose)


if __name__ == "__main__":
    import argparse
    
    parser = argparse.ArgumentParser(description="View OpenCode activity logs")
    parser.add_argument("--session", help="Show logs for specific session ID")
    parser.add_argument("--limit", type=int, default=20, help="Number of recent logs to show")
    parser.add_argument("--verbose", "-v", action="store_true", help="Show detailed information")
    
    args = parser.parse_args()
    
    if args.session:
        show_session(args.session, args.verbose)
    else:
        show_recent(args.limit, args.verbose)

