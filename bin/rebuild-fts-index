#!/usr/bin/env python3
"""
Rebuild FTS5 Full-Text Search Index
Migrates existing databases to use FTS5 for faster, more accurate search.

Usage:
    ./bin/rebuild-fts-index.py              # Both databases
    ./bin/rebuild-fts-index.py cloud        # Cloud DB only
    ./bin/rebuild-fts-index.py local        # Local DB only
"""

import sys
import os
from pathlib import Path

# Add lib to path
project_root = Path(__file__).parent.parent
sys.path.insert(0, str(project_root / "lib"))

from memory_db import MemoryDB

def rebuild_database(db_path: str, name: str):
    """Rebuild FTS5 index for a database."""
    if not os.path.exists(db_path):
        print(f"⚠️  {name} database not found: {db_path}")
        return False
    
    print(f"📚 Rebuilding FTS5 index for {name} database...")
    print(f"   Path: {db_path}")
    
    try:
        db = MemoryDB(db_path=db_path)
        count = db.rebuild_fts_index()
        db.close()
        
        print(f"✅ Successfully indexed {count} memories in {name} database")
        return True
    except Exception as e:
        print(f"❌ Failed to rebuild {name} index: {e}")
        return False

def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "both"
    
    project_root = Path(__file__).parent.parent
    cloud_db = str(project_root / "data" / "jarvis_memory.db")
    local_db = str(project_root / "data" / "jarvis_memory_local.db")
    
    print("=" * 60)
    print("FTS5 Full-Text Search Index Migration")
    print("=" * 60)
    print()
    
    success = True
    
    if mode in ["both", "cloud"]:
        success &= rebuild_database(cloud_db, "Cloud")
        print()
    
    if mode in ["both", "local"]:
        success &= rebuild_database(local_db, "Local")
        print()
    
    if success:
        print("=" * 60)
        print("✅ FTS5 Migration Complete!")
        print("=" * 60)
        print()
        print("Benefits:")
        print("  • 10-100x faster text search")
        print("  • BM25 relevance ranking (industry standard)")
        print("  • Stemming ('running' matches 'run')")
        print("  • Phrase search (\"Flask API\")")
        print("  • Boolean operators (flask OR express)")
        print()
        print("Your search_memory tool now uses FTS5 automatically!")
        return 0
    else:
        print("⚠️  Some databases failed to migrate")
        return 1

if __name__ == "__main__":
    sys.exit(main())

