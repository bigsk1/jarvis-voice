# Blinko Environment Variables
# Copy this to .env and fill in your actual values
# DO NOT commit .env to git!

# Database Password (used by PostgreSQL and in DATABASE_URL)
POSTGRES_PASSWORD=your_secure_database_password_here

# NextAuth Secret (for session encryption - generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_secure_nextauth_secret_here

# Optional: AI Features (uncomment if using)
# OPENAI_API_KEY=sk-...
