{
  "server": {
    "host": "0.0.0.0",
    "port": 5001,
    "debug": false
  },
  "ui": {
    "theme": "dark",
    "show_tool_details": true,
    "auto_scroll": true,
    "sound_effects": true,
    "progress_events": true
  },
  "audio": {
    "tts_enabled": false,
    "tts_autoplay": true,
    "stt_enabled": false
  },
  "defaults": {
    "mode": "cloud"
  },
  "cloud": {
    "llm_provider": null,
    "llm_model": null,
    "router_prompt_version": null,
    "image_provider": null,
    "video_provider": null,
    "music_provider": null,
    "tts_provider": null,
    "response_style": null,
    "tool_rag_limit": null,
    "qa_word_limit": null,
    "multi_turn_word_limit": null,
    "status_llm_enabled": null,
    "status_phrase_mode": null,
    "completion_guard_enabled": null,
    "completion_guard_mode": null,
    "completion_guard_ticket_on_fail": null,
    "completion_guard_show_ui_prompt": null,
    "completion_guard_include_qa": null,
    "completion_guard_include_tool_tasks": null,
    "completion_guard_auto_threshold": null,
    "completion_guard_eval_provider": null,
    "completion_guard_eval_model": null
  },
  "local": {
    "llm_provider": null,
    "llm_model": null,
    "router_prompt_version": null,
    "image_provider": null,
    "video_provider": null,
    "music_provider": null,
    "tts_provider": null,
    "response_style": null,
    "tool_rag_limit": null,
    "qa_word_limit": null,
    "multi_turn_word_limit": null,
    "status_llm_enabled": null,
    "status_phrase_mode": null,
    "completion_guard_enabled": null,
    "completion_guard_mode": null,
    "completion_guard_ticket_on_fail": null,
    "completion_guard_show_ui_prompt": null,
    "completion_guard_include_qa": null,
    "completion_guard_include_tool_tasks": null,
    "completion_guard_auto_threshold": null,
    "completion_guard_eval_provider": null,
    "completion_guard_eval_model": null
  },
  "conversation": {
    "history_limit": 20,
    "notes": "Number of messages (user+assistant) to include as LLM context"
  },
  "tools": {
    "blocked": [
      "get_recent_conversations"
    ],
    "notes": "Tools listed here won't be available to LLM in web mode. Terminal/TUI unaffected."
  }
}
