{
  "server": {
    "host": "0.0.0.0",
    "port": 5001,
    "debug": false
  },
  "ui": {
    "theme": "dark",
    "show_tool_details": true,
    "auto_scroll": true,
    "sound_effects": true,
    "progress_events": true
  },
  "audio": {
    "tts_enabled": false,
    "tts_autoplay": true,
    "stt_enabled": false
  },
  "defaults": {
    "mode": "cloud"
  },
  "cloud": {
    "llm_provider": null,
    "llm_model": null,
    "image_provider": null,
    "video_provider": null
  },
  "local": {
    "llm_provider": null,
    "llm_model": null,
    "image_provider": null,
    "video_provider": null
  },
  "conversation": {
    "history_limit": 20,
    "notes": "Number of messages (user+assistant) to include as LLM context"
  },
  "tools": {
    "blocked": [
      "get_recent_conversations"
    ],
    "notes": "Tools listed here won't be available to LLM in web mode. Terminal/TUI unaffected."
  }
}