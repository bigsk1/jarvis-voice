{
  "server": {
    "host": "0.0.0.0",
    "port": 5001,
    "debug": false
  },
  "auth": {
    "enabled": false,
    "password_hash": null
  },
  "ui": {
    "theme": "dark",
    "show_tool_details": true,
    "auto_scroll": true,
    "sound_effects": true
  },
  "audio": {
    "tts_enabled": true,
    "tts_autoplay": true,
    "stt_enabled": false
  },
  "defaults": {
    "mode": "cloud"
  },
  "cloud": {
    "llm_provider": "xai",
    "llm_model": "grok-4-1-fast-non-reasoning-latest",
    "image_provider": null
  },
  "local": {
    "llm_provider": "ollama",
    "llm_model": "ministral-3:14b",
    "image_provider": null
  },
  "conversation": {
    "history_limit": 21,
    "notes": "Number of messages (user+assistant) to include as LLM context"
  },
  "tools": {
    "blocked": [
      "get_recent_conversations"
    ],
    "notes": "Tools listed here won't be available to LLM in web mode. Terminal/TUI unaffected."
  }
}