    "create_reminder": {
      "name": "create_reminder",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "schedule": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "relative",
                  "date",
                  "weekday",
                  "daily",
                  "weekly",
                  "monthly"
                ]
              },
              "time": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "weekday": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              },
              "delay_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 366
              },
              "start_offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "timezone": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "when"
        ],
        "additionalProperties": false
      },
      "description": "Synthetic simulator tool: create_reminder."
