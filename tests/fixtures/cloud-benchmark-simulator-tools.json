{
  "description": "Test-owned structural tool contracts for legacy simulator regressions. These do not track production schema hashes or descriptions. Update only when a simulator regression needs a changed test contract.",
  "tools": {
    "brave_llm_context": {
      "name": "brave_llm_context",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "search_lang": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "freshness": {
            "type": "string",
            "enum": [
              "pd",
              "pw",
              "pm",
              "py"
            ]
          },
          "freshness_range": {
            "type": "string"
          },
          "maximum_number_of_urls": {
            "type": "integer"
          },
          "maximum_number_of_tokens": {
            "type": "integer"
          },
          "maximum_number_of_snippets": {
            "type": "integer"
          },
          "maximum_number_of_tokens_per_url": {
            "type": "integer"
          },
          "maximum_number_of_snippets_per_url": {
            "type": "integer"
          },
          "context_threshold_mode": {
            "type": "string",
            "enum": [
              "strict",
              "balanced",
              "lenient",
              "disabled"
            ]
          },
          "enable_local": {
            "type": "boolean"
          },
          "enable_source_metadata": {
            "type": "boolean"
          },
          "loc_city": {
            "type": "string"
          },
          "loc_state": {
            "type": "string"
          },
          "loc_state_name": {
            "type": "string"
          },
          "loc_country": {
            "type": "string"
          },
          "loc_postal_code": {
            "type": "string"
          },
          "loc_lat": {
            "type": "number"
          },
          "loc_long": {
            "type": "number"
          },
          "goggles": {
            "type": "string"
          },
          "include_raw": {
            "type": "boolean"
          }
        },
        "required": [
          "query"
        ]
      },
      "description": "Synthetic simulator tool: brave_llm_context."
    },
    "crawl_url": {
      "name": "crawl_url",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1
          },
          "stealth": {
            "type": "boolean"
          },
          "wait_for": {
            "type": "string"
          },
          "wait_for_js": {
            "type": "boolean"
          },
          "wait_strategy": {
            "type": "string",
            "enum": [
              "fast",
              "normal",
              "full"
            ]
          },
          "page_timeout": {
            "type": "integer"
          },
          "delay_before_return_html": {
            "type": "number"
          },
          "css_selector": {
            "type": "string"
          },
          "exclude_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extraction_type": {
            "type": "string",
            "enum": [
              "cosine",
              "regex",
              "css"
            ]
          },
          "semantic_filter": {
            "type": "string"
          },
          "similarity_threshold": {
            "type": "number"
          },
          "top_k": {
            "type": "integer"
          },
          "regex_patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email",
                "phone",
                "url",
                "currency",
                "date",
                "percentage"
              ]
            },
            "minItems": 1,
            "maxItems": 6
          },
          "css_schema": {
            "type": "object"
          }
        },
        "required": []
      },
      "description": "Synthetic simulator tool: crawl_url."
    },
    "canvas": {
      "name": "canvas",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
