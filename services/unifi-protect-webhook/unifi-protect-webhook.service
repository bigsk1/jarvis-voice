# Template: render with ../../bin/render-systemd-unit.sh before installing so User/Group match the target account.
# Path specifiers use %h (that user's home) after User= is set.
[Unit]
Description=UniFi Protect Webhook Receiver for Jarvis
After=network.target jarvis-api.service
Wants=jarvis-api.service

[Service]
Type=simple
User=__JARVIS_USER__
Group=__JARVIS_GROUP__
WorkingDirectory=%h/jarvis-voice/services/unifi-protect-webhook
EnvironmentFile=%h/jarvis-voice/services/unifi-protect-webhook/config.env
ExecStart=%h/jarvis-venv/bin/python3 webhook_receiver.py
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/jarvis-voice/logs

[Install]
WantedBy=multi-user.target
