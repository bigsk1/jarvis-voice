# UniFi Protect Webhook Receiver Configuration
# Copy to config.env and customize

# Jarvis alerts API endpoint
JARVIS_ALERTS_URL=http://localhost:8880/api/alerts

# Jarvis API authentication (if JARVIS_API_AUTH=true on the API server)
# Leave empty if auth is disabled on your Jarvis API - see cloud.env and local.env
JARVIS_API_KEY=

# Port for webhook receiver
WEBHOOK_PORT=5050

# Alert time window (24h format)
# 0-24 = always alert
# 22-6 = alert from 10PM to 6AM only
ALERT_START_HOUR=0
ALERT_END_HOUR=24

# Object types to alert on (comma-separated)
# Options: person, vehicle, animal, package
ALERT_OBJECT_TYPES=person

# Default cooldown - ONLY used for event types without their own cooldown
# Each event type has its OWN cooldown defined in webhook_receiver.py:
#
#   person:              60s   (edit line ~72 to change)
#   package:            300s   (5 min)
#   vehicle:            120s   (2 min)
#   animal:             300s   (5 min)
#   audio_alarm_*:       60s
#   sensor_battery_low: 3600s  (1 hour)
#   sensor_water_leak:  300s   (5 min)
#   camera_offline:     900s   (15 min)
#   sensor_offline:    1800s   (30 min)
#
# To change a specific event type's cooldown, edit ALERT_RULES in webhook_receiver.py
# This env var is only a fallback for rules that don't specify their own cooldown
COOLDOWN_SECONDS=60

