# UniFi Protect Webhook Receiver Configuration
# Copy to config.env and customize

# Jarvis alerts API endpoint
JARVIS_ALERTS_URL=http://localhost:8880/api/alerts

# Jarvis API authentication (if JARVIS_API_AUTH=true on the API server)
# Leave empty if auth is disabled on your Jarvis API - see cloud.env and local.env
JARVIS_API_KEY=

# Port for webhook receiver
WEBHOOK_PORT=5050

# Alert time window (24h format)
# 0-24 = always alert
# 22-6 = alert from 10PM to 6AM only
ALERT_START_HOUR=0
ALERT_END_HOUR=24

# Object types to alert on (comma-separated)
# Options: person, vehicle, animal, package
ALERT_OBJECT_TYPES=person

# Cooldown between alerts per camera (seconds)
# Prevents alert storms from the same camera
COOLDOWN_SECONDS=120

