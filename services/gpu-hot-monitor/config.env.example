# GPU Hot monitor configuration
# Copy this file to config.env. Keep private hostnames, IPs, and API keys there.

# Required GPU Hot dashboard base URL
GPU_HOT_URL=http://gpu-host:1312
GPU_HOT_HOST_LABEL="GPU host"

# Polling and offline detection
GPU_HOT_POLL_SECONDS=30
GPU_HOT_REQUEST_TIMEOUT_SECONDS=8
GPU_HOT_FAILURE_SAMPLES=3
GPU_HOT_RECOVERY_SAMPLES=2

# Temperature alerts are enabled by default. Four 30-second samples means the
# temperature must remain high for roughly two minutes before Jarvis alerts.
GPU_HOT_TEMPERATURE_C=80
GPU_HOT_TEMPERATURE_RECOVERY_C=75
GPU_HOT_TEMPERATURE_SAMPLES=4

# Allocated VRAM capacity and GPU compute utilization are configurable but
# disabled by default. Set either alert threshold above 0 to enable it.
GPU_HOT_VRAM_PERCENT=0
GPU_HOT_VRAM_RECOVERY_PERCENT=0
GPU_HOT_VRAM_SAMPLES=4
GPU_HOT_UTILIZATION_PERCENT=0
GPU_HOT_UTILIZATION_RECOVERY_PERCENT=0
GPU_HOT_UTILIZATION_SAMPLES=10

# Optional host thresholds from GPU Hot's WebSocket snapshot. Disabled by default.
GPU_HOT_HOST_CPU_PERCENT=0
GPU_HOT_HOST_CPU_RECOVERY_PERCENT=0
GPU_HOT_HOST_CPU_SAMPLES=10
GPU_HOT_HOST_RAM_PERCENT=0
GPU_HOT_HOST_RAM_RECOVERY_PERCENT=0
GPU_HOT_HOST_RAM_SAMPLES=4

# All enabled conditions create high alerts so they speak through Jarvis.
GPU_HOT_ALERT_SEVERITY=high

# Jarvis alerts API. Add the API key only when JARVIS_API_AUTH=true.
JARVIS_ALERTS_URL=http://localhost:8880/api/alerts
JARVIS_API_KEY=
JARVIS_ALERT_TIMEOUT_SECONDS=10

# Leave blank to use logs/gpu-hot-monitor-state.json in the Jarvis checkout.
GPU_HOT_STATE_FILE=
