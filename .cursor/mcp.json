{
    "mcpServers": {
      "n8n-mcp": {
        "command": "docker",
        "args": [
          "run",
          "-i",
          "--rm",
          "--init",
          "-e",
          "MCP_MODE=stdio",
          "-e",
          "LOG_LEVEL=error",
          "-e",
          "DISABLE_CONSOLE_OUTPUT=true",
          "-e",
          "N8N_API_URL",
          "-e",
          "N8N_API_KEY",
          "-e",
          "N8N_MCP_TELEMETRY_DISABLED=true",
          "--network",
          "host",
          "ghcr.io/czlonkowski/n8n-mcp:latest"
        ],
        "env": {
          "N8N_API_URL": "{env:N8N_LOCAL_API_URL}",
          "N8N_API_KEY": "{env:N8N_LOCAL_API_KEY}",
          "N8N_MCP_TELEMETRY_DISABLED": "true"
        }
      }
    }
  }
  