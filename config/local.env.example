# Jarvis Voice Assistant - Local/Offline Configuration
# Copy this file to local.env and customize for your setup
# This mode uses Ollama for LLM and local TTS - no cloud API keys required for core functionality

# ===== Tool profiles (optional overlay on skills/**/*.tool.json enabled flags) =====
# JSON files: skills/profiles/<name>.json — see skills/README.md (Tool profiles) and skills/profiles/examples
# Profile overrides win over manifest enabled flags. "workflow": false disables
# autonomous workflow discovery/run, not direct slash or scheduled workflows.
# After changing profile: restart Jarvis services, then run ./bin/sync-tools.py local
JARVIS_TOOL_PROFILE=default
# JARVIS_TOOL_PROFILE=offline
# JARVIS_TOOL_PROFILE=local_minimal_assistant

# ===== Memory System =====
# Semantic search similarity threshold (0.0-1.0)
# Lower = more results (may include loosely related memories)
# Higher = fewer results (only close matches)
# Recommended: 0.35-0.45 range
# Default: 0.40 (balanced - catches paraphrased queries)
SEMANTIC_SIMILARITY_THRESHOLD=0.31

# Auto-Context (Short-Term Conversation Memory) - Good for CLI / wake word follow-ups; disable if using the web UI (it uses its own context).
# Automatically inject recent conversation history into each request
# Enables natural follow-up responses and self-learning from failures
AUTO_CONTEXT_ENABLED=false

# Number of recent conversations to include (2-5 recommended) - web has it's own data/web_conversations/
AUTO_CONTEXT_WINDOW=0

# Time window in minutes (only include conversations within this time)
# Recommended: 5-15 minutes (voice conversations are typically bursty)
AUTO_CONTEXT_MINUTES=0

# Auto-Memory Injection (CLI, WebUI, wake word - all entry points)
# Automatically inject relevant memories from vector DB into context before each LLM call
AUTO_MEMORY_INJECTION_ENABLED=true
AUTO_MEMORY_LIMIT=2
AUTO_MEMORY_SIMILARITY_THRESHOLD=0.375
AUTO_MEMORY_RECENCY_ENABLED=true
# Always-include: max addressing/response-style items (call me sir, tone, language)
# 0=disable, 2=recommended. Topic prefs use semantic search only.
AUTO_MEMORY_ALWAYS_INCLUDE_LIMIT=2

# Exclude artifact/transient rows from auto-inject (preference/fact only).
AUTO_MEMORY_TYPE_FILTER_ENABLED=true

# ===== Status Updates (Voice Progress Feedback) =====
# Enable voice status updates during long-running tasks
# Speaks tool and lifecycle progress using static phrases or the Status LLM
# Separate from the Web UI's "Thinking", "Working", and "Reviewing results" indicator
STATUS_UPDATES_ENABLED=true

# Minimum seconds between status updates (prevents spam)
STATUS_UPDATE_INTERVAL=18

# Wait this long before emitting status, so very fast tools can finish silently
STATUS_UPDATE_DEBOUNCE_MS=250

# Silence padding before status audio (ms) - helps speakers "wake up"
# Increase if first words are cut off (Bluetooth/wireless speakers need more)
STATUS_SILENCE_PAD_MS=250

# Cache generated status audio (instant playback for repeated phrases)
# Cache location: ~/.cache/jarvis/status-tts-local/
STATUS_CACHE_ENABLED=true

# Structured status LLM/lifecycle audit logs (logs/llm-calls-* and logs/status-llm/*)
STATUS_LOGGING_ENABLED=true

# Status phrase personality
# Options: 'normal' (professional), 'unhinged' (chaotic/funny)
STATUS_PHRASE_MODE=normal

# Include funny/witty phrases in normal mode
STATUS_HUMOR_ENABLED=true

# Include encouraging phrases
STATUS_ENCOURAGEMENT_ENABLED=true

# Sass level: 0=professional, 1=friendly with sass hint, 2=confidently sassy
STATUS_SASS_LEVEL=1

# Note: Status TTS uses say-status-local.sh with the same TTS_PROVIDER and
# KOKORO_TTS_* or QWEN3_TTS_* variables as main local TTS.

# ===== Status LLM (Dynamic Summaries) =====
# Optional native helper model on this host, independent of OLLAMA_BASE_URL.
# Run ./bin/setup-helper-llm --mode local, then select provider=helper per role.
# JARVIS_HELPER_LLM_BASE_URL="http://127.0.0.1:11434"
# JARVIS_HELPER_LLM_MODEL="bigsk1/jarvis-helper:minicpm5-1b-q4_k_m-v1"
# Device options: auto or cpu
# JARVIS_HELPER_LLM_DEVICE="auto"
# JARVIS_HELPER_LLM_KEEP_ALIVE="30m"
# JARVIS_HELPER_LLM_CONTEXT_WINDOW=8192
# JARVIS_HELPER_LLM_TEMPERATURE=0.2
# STASH_SUMMARIZE_LLM_PROVIDER=helper
# TEXT_SUMMARIZER_LLM_PROVIDER=helper

# Use a small/fast LLM for a bounded, sanitized execution snapshot.
# Enable only if local hardware/model can handle chat and status inference concurrently.
STATUS_LLM_ENABLED=false

# Provider: helper (host-local), ollama (mode-routed), openai, xai
STATUS_LLM_PROVIDER=ollama

# Model: Use small/fast models for local - make sure you pull these models first before trying to use
# qwen2.5:1.5b is very fast, phi3:mini also good, ministral-3:14b, qwen3.5:latest
STATUS_LLM_MODEL=qwen2.5:1.5b

# Dynamic phrase deadline only; tools start immediately and never wait for it
STATUS_LLM_DEADLINE_MS=1000

# Max tokens for summary
STATUS_LLM_MAX_TOKENS=30

# ===== OpenCode Integration =====
# Enable/disable OpenCode autonomous agent integration
# When enabled, Jarvis can use OpenCode for complex multi-step tasks
# OpenCode server must be running (systemd service or manual) the setup scripts for opencode are not meant for running local mode but cloud only.
OPENCODE_ENABLED=false
OPENCODE_BASE_URL="http://localhost:4096"
# Options: ollama, anthropic, openai, xai
OPENCODE_PROVIDER="ollama"
# Ollama: gemma4, qwen3.5:latest
# Anthropic: claude-sonnet-5
# OpenAI: gpt-5.4-mini
# xAI: grok-4.6, grok-build-0.1, grok-4.5
# Local models are less reliable for autonomous code execution unless the workspace is strongly isolated.
OPENCODE_MODEL="gemma4"
# Optional HTTP Basic auth for the OpenCode server and web UI.
# Username defaults to "opencode" when omitted.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=your-opencode-password

# ===== LLM Provider for Tool Calling and Chat for JARVIS =====
# Options: "ollama" only (structured prompting)
LLM_PROVIDER="ollama"

# ===== Local API Endpoints =====
# Point to your Ollama instance
# You can provide multiple hosts in priority order; Jarvis will append
# localhost as a final fallback automatically.
# Example:
# OLLAMA_BASE_URL="http://192.168.xx.xxx:11434,http://192.168.x.xxx:11434"
OLLAMA_BASE_URL="http://localhost:11434"

# Optional: include downloaded Ollama Cloud model cards (for example :cloud or
# *-cloud tags) in local-mode model selection. These still run through the
# configured daemon and require `ollama signin`; OLLAMA_API_KEY is cloud-mode-only.
ALLOW_OLLAMA_CLOUD=false

# Best models for tool calling on 16GB GPU (tested & verified):
# qwen3.5:latest is good, ministral-3:14b, kimi-k2.5:cloud, gemma4, gemma4:26b-a4b-it-qat, 
# OLLAMA_MODEL is the local-mode default. Keep it local unless
# ALLOW_OLLAMA_CLOUD=true; cloud-mode uses OLLAMA_CLOUD_MODEL in cloud.env.
OLLAMA_MODEL="gemma4"

# Vision model for image analysis (local mode only when LLM_PROVIDER=ollama).
# Cloud mode uses OLLAMA_CLOUD_MODEL instead — see docs/ollama/README.md § Vision.
# Options: llava:latest (7B), llava-llama3:latest (8B), llama3.2-vision:latest (10.7B), qwen3-vl:latest (8.8B)
OLLAMA_VISION_MODEL="gemma4"

# Unified cloud/local embedding contract. Pull this model on every configured
# OLLAMA_BASE_URL host before startup: ollama pull bigsk1/jarvis-embedding:bf16-v1
OLLAMA_EMBEDDING_MODEL="bigsk1/jarvis-embedding:bf16-v1"
OLLAMA_EMBEDDING_MODEL_DIGEST="85462619ee721b466c5927d109d4cb765861907d5417b9109caebc4e614679f1"

# Optional embedding context window override for Ollama embed requests.
# If unset, Jarvis falls back to OLLAMA_CONTEXT_WINDOW.
# Increase only if your embedding model/server supports it.
OLLAMA_EMBEDDING_CONTEXT_WINDOW=2048

# Ollama Context Window (num_ctx)
# How many tokens the model can process at once
# Default: 12288 (balanced - works on most 16GB GPUs)
# Options based on VRAM:
#   8192  = ~12GB VRAM (safe, but may truncate tool definitions)
#  12288  = ~13GB VRAM (recommended for 12GB cards)
#  16384  = ~14GB VRAM (if you have headroom)
#  24000  = 14GB VRAM 
#  32768  = ~15GB VRAM (can cause timeouts ON 5060 but best because of system prompt + tool schema)
# See bin/measure-baseline-tokens for current tool usage
OLLAMA_CONTEXT_WINDOW=32768

# ===== Response Style =====
# How Jarvis formats tool results for voice output
# Options: "casual", "detailed", "auto"
#   casual: Always format for voice - BEST FOR VOICE
#     - Q&A responses: up to JARVIS_QA_WORD_LIMIT (default 75 words)
#     - Multi-turn: up to JARVIS_MULTI_TURN_WORD_LIMIT (default 50 words)
#     - Tool confirmations: 35 words max (hardcoded)
#     - Strips stash:// refs, long URLs, file paths from speech
#   detailed: Raw LLM output with full context - BEST FOR CLI/DEBUGGING
#   auto: Smart adaptive mode (RECOMMENDED):
#     - Search tools → Format for voice (remove URLs, summarize)
#     - Simple tools (get_time, crypto_price) → Keep if short (<25 words)
#     - Complex tools (opencode) → Keep detailed if >50 words
#     - Multi-turn → Always format summary of ALL tools
# Versioned router instructions. Local mode may select a different tested version.
# v1=full baseline; v2=compact; v3=telegraphic Caveman; v4=Caveman-light hybrid ( good choice for local mode with smaller vram ).
# The Web UI AI Config panel can save a per-mode override without editing this file.
JARVIS_ROUTER_PROMPT_VERSION="v4"
JARVIS_RESPONSE_STYLE="auto"

# Wake word voice path override (question-orchestrator-local.sh / ./jarvis-local)
# Safety default is "auto" so wake word never inherits global "detailed" by accident.
# Allowed values here are only: "auto" or "casual". Any other value falls back to "auto".
# JARVIS_WAKE_RESPONSE_STYLE="auto"
# Optional tighter wake-word-only limits. When unset, normal JARVIS_QA_WORD_LIMIT /
# JARVIS_MULTI_TURN_WORD_LIMIT still apply.
# JARVIS_WAKE_QA_WORD_LIMIT=125
# JARVIS_WAKE_MULTI_TURN_WORD_LIMIT=125

# Word limit for Q&A/informational voice responses
# Tool confirmations stay short (35 words hardcoded)
# Q&A responses get more room for useful info
# Default 125, jarvis wake word only keep default, if using Ui only and tts off set to 200+ for more verbose anwsers or leave default and override in UI settings
JARVIS_QA_WORD_LIMIT=125

# Word limit for multi-turn/multi-tool summaries
# After using multiple tools, Jarvis summarizes results for voice
# Higher = more detail, Lower = more concise
# NOTE: Named entities (movie titles, business names, etc.) are ALWAYS preserved
# NOTE: stash:// refs and long URLs are stripped from speech
# Default: 75 words
JARVIS_MULTI_TURN_WORD_LIMIT=125

# ===== Completion Guard =====
# Ask "Completed correctly?" after responses in the Web UI.
# Helps catch incomplete or unsupported answers after the main task ends.
# Modes:
#   - manual: show a "Completed correctly?" card in the Web UI (you are the judge)
#   - auto: run a background evaluator on the raw final answer (uses EVAL_PROVIDER/MODEL below)
#       - accepted / tighten_only do NOT use the threshold
#       - only real repair escalation is gated by AUTO_THRESHOLD
#       - tighten_only means "basically correct, only minor wording/scope cleanup"
# Repair passes (manual "No" or auto-triggered) always use the main chat LLM/orchestrator,
# not the eval model below. Tickets are markdown files.
JARVIS_COMPLETION_GUARD_ENABLED=false
JARVIS_COMPLETION_GUARD_MODE="manual"
# Auto threshold for auto mode:
#   - higher = fewer repair passes
#   - lower = more aggressive repair triggering
#   - does NOT disable auto evaluation itself
#   - does NOT affect accepted or tighten_only outcomes
JARVIS_COMPLETION_GUARD_AUTO_THRESHOLD=0.89
JARVIS_COMPLETION_GUARD_TICKET_ON_FAIL=true
JARVIS_COMPLETION_GUARD_SHOW_UI_PROMPT=true
# Manual Web UI prompt countdown / expiry (seconds). Expired prompts settle neutrally.
JARVIS_COMPLETION_GUARD_MANUAL_TTL_SECONDS=600
JARVIS_COMPLETION_GUARD_INCLUDE_QA=true
JARVIS_COMPLETION_GUARD_INCLUDE_TOOL_TASKS=true
# Do not run Completion Guard repair after these tools were already used below
COMPLETION_GUARD_EXCLUDED_TOOLS="phone_call,send_email,create_reminder,create_alert,printer,send_webhook,ssh_remote,generate_video,generate_image,generate_music,workflow"
# AUTO MODE ONLY — background judge (manual mode uses the UI card instead; repair uses main chat LLM).
JARVIS_COMPLETION_GUARD_EVAL_PROVIDER=ollama
JARVIS_COMPLETION_GUARD_EVAL_MODEL=gemma4

# Jarvis timezone for date/time awareness in system prompt
# Uses IANA timezone names (e.g., America/Los_Angeles, America/New_York, Europe/London)
JARVIS_TIMEZONE="America/Los_Angeles"
SCHEDULED_TASK_MISSED_GRACE_SECONDS=300  # Run slightly late after short restarts; skip older occurrences

# Default location for weather and location-based queries when user does not specify one
# Examples: "Seattle, WA", "London, UK"
# Do NOT use for time/timezone - that uses JARVIS_TIMEZONE
JARVIS_DEFAULT_LOCATION=""
# Optional postal/ZIP code for tools that need a structured postal code
# Examples: "98101", "SW1A 1AA"
JARVIS_DEFAULT_POSTAL_CODE=""

# Enable thinking mode
# ./orchestrator/orchestrator_v2.py local --debug-thinking "Some questions"
# Ollama support and returned thinking text depend on the selected model.
JARVIS_DEBUG_THINKING=false

MCP_DEBUG=false
JARVIS_DEBUG=false

# ===== Tool RAG System (Dynamic Tool Retrieval) =====
# Ghost Tools: Core tools prioritized inside the final Tool RAG schema cap (comma-separated)
# These get first chance when vector search misses, but do not bypass LOCAL_TOOL_RAG_LIMIT.
# Recommended: memory, logs, time (essential for self-correction). Enabled
# tool_search and workflow discovery helpers are included separately; do not add below.
GHOST_TOOLS="search_memory,update_memory,semantic_recall,remember"

# Tool Retrieval Similarity Threshold (0.0-1.0) - missing tool calls lower 0.05 works for everything but huge context window
# **Local Mode**: Sends up to **6** tool schemas after retrieval, ghost tools, and exact signals are merged.
LOCAL_TOOL_RAG_LIMIT=6
# Minimum similarity score for a tool to be retrieved
# Lower = more tools retrieved (may include less relevant)
# Higher = fewer tools retrieved (only highly relevant)
# Set to 0.0 to disable threshold (use top-K only)
# Recommended: 0.15-0.25 for cloud, 0.20-0.30 for local
TOOL_SIMILARITY_THRESHOLD=0.28
# Optional: stricter cutoff only for true Tool RAG full_fallback. Unset = use TOOL_SIMILARITY_THRESHOLD for both.
TOOL_SIMILARITY_THRESHOLD_FULL=0.40
# Tool RAG compact retrieval keeps the full intelligence/memory prompt for the LLM,
# but embeds a smaller current-request query plus structured exact tool signals.
TOOL_RAG_COMPACT_QUERY_ENABLED=true
TOOL_RAG_CURRENT_QUERY_MAX_CHARS=1200
TOOL_RAG_CONTEXT_QUERY_MAX_CHARS=500
TOOL_RAG_APPEND_POSITIVE_SIGNALS=true
TOOL_RAG_EXCLUDE_NEGATIVE_SIGNALS=true
# Learned "PREFER: tool (+score)" signals must meet this score before they
# force-append a tool. UI-selected tool hints are still honored regardless.
TOOL_RAG_MIN_LEARNED_PREFER_BIAS=0.60
# Learned "AVOID: tool (-score)" signals must meet this score before they
# hard-filter a non-ghost tool. Explicit "DO NOT use:" remains honored.
TOOL_RAG_MIN_LEARNED_AVOID_BIAS=0.60
# Experimental: exact-match tool names in auto-memory/intel context can become
# structured prefer/avoid signals when nearby language says "always use" or "avoid".
# Keep off unless actively testing; memory prose is noisier than learned insights.
TOOL_RAG_MEMORY_TOOL_SIGNALS_ENABLED=false
# Live debugging trace for what Tool RAG ranked and sent to the LLM.
# Writes logs/tool-rag/tool-rag-YYYY-MM-DD.jsonl. Disable after tuning if noisy.
TOOL_RAG_TRACE_ENABLED=true
TOOL_RAG_TRACE_TOP_N=25
TOOL_RAG_TRACE_QUERY_CHARS=1200
TOOL_RAG_TRACE_SCHEMA_TOP_N=10

# Max turns for tool calls, default 15 for deep research
MAX_TOOL_TURNS=6

# ===== Local TTS =====
# Provider: "kokoro" or "qwen3-tts"
#   kokoro:    Fast, local kokoro TTS server (uses OpenAI-ish API)  https://github.com/remsky/Kokoro-FastAPI
#   qwen3-tts: Qwen3-TTS with 28 custom cloned voices (OpenAI-compatible API) https://github.com/bigsk1/Qwen3-TTS-Openai-Fastapi
# Use only KOKORO_TTS_* when provider is kokoro and QWEN3_TTS_* when qwen3-tts.
TTS_PROVIDER="kokoro"

# --- Kokoro TTS Settings ---
# Used when TTS_PROVIDER="kokoro"
KOKORO_TTS_URL="http://localhost:8880/v1/audio/speech"
# Voice IDs for KOKORO_TTS_VOICE (single id, or blend with + if your server supports it):
#   af_alloy, af_aoede, af_bella, af_heart, af_jadzia, af_jessica, af_kore, af_nicole,
#   af_nova, af_river, af_sarah, af_sky, af_v0, af_v0bella, af_v0irulan, af_v0nicole,
#   af_v0sarah, af_v0sky, am_adam, am_echo, am_eric, am_fenrir, am_liam, am_michael,
#   am_onyx, am_puck, am_santa, am_v0adam, am_v0gurney, am_v0michael, bf_alice, bf_emma,
#   bf_lily, bf_v0emma, bf_v0isabella, bm_daniel, bm_fable, bm_george, bm_lewis,
#   bm_v0george, bm_v0lewis
KOKORO_TTS_VOICE="af_sky"
KOKORO_TTS_SPEED="1.0"

# --- Qwen3-TTS Settings ---
# Used when TTS_PROVIDER="qwen3-tts"
# Server running on mini-ai host with RTX 5060 Ti
QWEN3_TTS_URL="http://localhost:8881/v1/audio/speech"
# Voices: Jarvis, Paddington, Professor, Victoria, Josh, John, Mark, Adam, Russell,
#         Lucy, Carmen, Caroline, Joanne, Natasha, Bianca, Curt, Eustis, General_Joe,
#         Grandpa, Nigel, Richard, Valentino, Wildebeest, Cecile, Emmaline, Monika, Tally, Villain, Samantha
QWEN3_TTS_VOICE="Jarvis"
# Audio format: mp3, opus, aac, flac, wav, pcm
QWEN3_TTS_FORMAT="mp3"
# Speed: 0.25 to 4.0
QWEN3_TTS_SPEED="1.0"

# Speech-to-text. Default stays on this host with faster-whisper.
# Options: "faster-whisper", "openai", "openai-compatible"
STT_PROVIDER="faster-whisper"
STT_MODEL="small.en"
STT_DEVICE="cpu"
STT_COMPUTE_TYPE="int8"
# STT_TIMEOUT_SECONDS="30"

# Opt-in OpenAI-compatible endpoint (uses its own URL/key, never OPENAI_API_KEY).
# Self-hosted Parakeet option: https://github.com/bigsk1/parakeet
# STT_PROVIDER="openai-compatible"
# STT_BASE_URL="http://192.168.1.50:5092/v1"
# STT_API_KEY="replace-with-the-gateway-key"
# STT_MODEL="parakeet-en"

# Hard fail is the default. Set a different provider only to opt into fallback.
# Fallback runs for connection/timeouts, HTTP 408/425/429, and upstream 5xx.
STT_FALLBACK_PROVIDER=""
# STT_FALLBACK_MODEL="small.en"

# ===== Audio Devices =====
# USB Microphone (capture) 
# YOU WILL NEED TO REPLACE BELOW VALUES WITH YOUR SPEAKER AND MIC BASED ON YOUR SETUP! see docs/INSTALL_GUIDE.md
# IN_DEV="plughw:CARD=microphone,DEV=0"
# DEVICE_NAME_HINT="TONOR"

# Analog Speaker (playback)
# OUT_DEV="plughw:CARD=Generic_1,DEV=0"

# ===== Audio Devices =====  WSL2 UBUNTU 24.04
# USB Microphone (capture)
IN_DEV="pulse"
DEVICE_NAME_HINT="WSL2-PULSE"

# Analog Speaker (playback)
OUT_DEV="pulse"

# Printer (for print tool)
PRINTER_NAME=""

# ===== Wake Word Settings =====
# These values are FINE-TUNED for your noisy office + far-field mic
# DO NOT change unless you're testing in a new environment
WAKE_MODEL="hey_jarvis"
SAMPLE_RATE=16000
BLOCK_SIZE=1024
CHANNELS=1

# Sensitivity tuning
TRIGGER_THRESHOLD=0.2    # 0.2-0.5 range; lower = more sensitive
HIT_FRAMES_REQUIRED=4    # consecutive frames needed to trigger
MIN_RMS=2e-4             # noise gate threshold
VAD_THRESHOLD=0.40       # Voice Activity Detection threshold

# Timing controls
ARM_GRACE_SEC=1.2        # ignore triggers after re-arming for this duration
COOLDOWN_AFTER_QA=2.8    # cooldown before re-arming after Q&A

# ===== Recording Settings (SoX) =====
RATE=48000
CHAN=1
THRESH="3%"              # silence threshold
PRE_SIL="0.1"            # silence before speech starts
POST_SIL="1.2"           # silence to stop recording
MAX_RECORD_TIME="20"     # hard timeout (seconds) - prevents infinite recording from background noise

# ===== n8n Integration (Google Calendar Sync) =====
# n8n local instance URL and API key
N8N_LOCAL_API_URL="http://localhost:5678"
N8N_LOCAL_API_KEY=""

# Webhook URL for Jarvis → Google Calendar sync
# This webhook is created by the "Jarvis → Google Calendar Sync" workflow
# N8N_JARVIS_WEBHOOK_URL="http://localhost:5678/webhook/jarvis-reminder"

# Cloudflare API Token (optional)  images cdn 
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Samantha Gateway Token (optional secondary AI)
# SAMANTHA_URL="https://your-vps.tailscale-hostname.ts.net/v1/chat/completions"
# SAMANTHA_GATEWAY_TOKEN=
# SAMANTHA_MODEL="openclaw/main"  # or "openclaw" / "openclaw/<agentId>"

# ===== System Prompt =====
SYSTEM_PROMPT="You are a helpful AI assistant called Jarvis. Reply in plain ASCII, no emoji, no markdown, no bullet points."

# Wake greeting
# Wake word greetings (pipe-separated list for variety)
WAKE_GREETINGS="What's up?|How can I serve you?|Yes?|Ready.|Go ahead.|I'm listening."

# =============================================================================
# EXTERNAL API KEY
# =============================================================================
# Used by mcp/brave-search and skills/brave_llm_context.py.
BRAVE_API_KEY=

# n8n Remote (public HTTPS) - Basic Auth for webhooks
# Used by webhook_registry.json via ${N8N_REMOTE_WEBHOOK_AUTH}
# N8N_REMOTE_WEBHOOK_AUTH=""

# Crawl4AI - Advanced web crawler for JavaScript-heavy sites
# CRAWL4AI_URL=https://your-crawl4ai-instance.com
# CRAWL4AI_USER=admin
# CRAWL4AI_PASS=
# CRAWL4AI_API_KEY=

# Supa-Crawl-Chat - Persistent crawled-site search/chat corpus  see https://github.com/bigsk1/supa-crawl-chat
# Read-only Jarvis tool: skills/supa_crawl_knowledge.py
# SUPA_CRAWL_CHAT_URL=http://192.168.X.X:8001
# Optional when your instance enables API auth:
# SUPA_API_KEY=
# SUPA_API_KEY_STYLE=bearer
# Use SUPA_API_KEY_STYLE=x-api-key if the server expects X-API-Key instead of Authorization: Bearer

# OVIS document OCR - optional self-hosted GPU OCR service. See https://github.com/bigsk1/ovis-fastapi
# Jarvis uploads policy-approved PDF/image files to this configured service only.
# The OVIS host owns any local Ollama or other /v1/generate backend settings.
# OVIS_OCR_URL="http://your-ovis-host:17860"
# OVIS_OCR_TIMEOUT_SECONDS=900
# OVIS_OCR_CONNECT_TIMEOUT_SECONDS=5

# COINGECKO_API_KEY=""

# Weather API (OpenWeatherMap free tier: 60 calls/min, 5-day forecast)
# Get your API key at: https://openweathermap.org/api
# Provider options: "openweathermap" (default), "wttr" (no key needed, fallback)
WEATHER_PROVIDER=openweathermap
# OPENWEATHER_API_KEY=""

# Serp api search tool  ( free sign up at https://serpapi.com/ )
# SERP_API_KEY=
# Optional: advertise serpapi_youtube as a fallback hint when yt-dlp YouTube tools fail
# SERPAPI_YOUTUBE_FALLBACK=false

# Canvas URLs
# CANVAS_INTERNAL_URL is used by tools running on the Jarvis host.
# CANVAS_PUBLIC_URL is shown to users in Canvas links; set to your LAN host/IP
# when Jarvis runs headless on another machine, e.g. http://192.168.70.XXX:8890
CANVAS_INTERNAL_URL="http://localhost:8890"
CANVAS_PUBLIC_URL="http://localhost:8890"
# Optional cloud egress from local mode: publish Canvas PDF snapshots through
# the xAI Files API. Requires XAI_API_KEY; leave false for fully local operation.
CANVAS_XAI_PDF_SHARE=false
CANVAS_XAI_PDF_SHARE_DEFAULT_TTL_DAYS=7
CANVAS_XAI_PDF_SHARE_MAX_BYTES=8388608
# Optional cloud egress for retained MP4 files in the Canvas video gallery.
# FastAPI uploads the reviewed local file to xAI; any original provider is supported.
CANVAS_XAI_VIDEO_SHARE=false
CANVAS_XAI_VIDEO_SHARE_DEFAULT_TTL_DAYS=7
CANVAS_XAI_VIDEO_SHARE_MAX_BYTES=48000000
# Optional cloud egress for retained Canvas audio. FastAPI converts the track
# to a temporary waveform MP4 because xAI public URLs do not accept audio.
CANVAS_XAI_AUDIO_SHARE=false
CANVAS_XAI_AUDIO_SHARE_DEFAULT_TTL_DAYS=7
CANVAS_XAI_AUDIO_SHARE_MAX_BYTES=48000000

# ===== Jarvis API Authentication =====
# Optional Bearer token authentication for the API (port 8880)
# When disabled (default): All requests allowed (for local network use)
# When enabled: External IPs require "Authorization: Bearer <api_key>"
# Localhost (127.0.0.1) is always trusted and doesn't need auth
JARVIS_API_AUTH=false
# Generate a secure key: openssl rand -hex 32
JARVIS_API_KEY="your-secure-api-key-here"

# Rate limit for /api/query (requests per minute per IP). 0 = disabled. Default: 30
QUERY_RATE_LIMIT_PER_MINUTE=15
# Global /api/* per-IP buckets (lib/rate_limiter.py). Set false to disable all API rate limits.
# API_RATE_LIMIT_ENABLED=true
# DOCS_API_RATE_LIMIT_PER_MINUTE=3
# API_RATE_LIMIT_DEFAULT_PER_MINUTE=120
# API_RATE_LIMIT_ALERTS_PER_MINUTE=60
# API_RATE_LIMIT_PRICE_ALERTS_PER_MINUTE=30
# API_RATE_LIMIT_GENERATED_MUSIC_PER_MINUTE=10

# ===== WebUI Authentication =====
# Optional password protection for web UIs (jarvis-web, canvas, intelligence, memory, docs)
# When set: Requires login to access any WebUI
# When empty/unset: No login required (for private networks)
# JWT tokens are shared across all UIs - login once, access all
WEBUI_PASSWORD=""
# Token expiry in days (default: 30)
WEBUI_TOKEN_EXPIRY_DAYS=30
# Optional: allow editing markdown files in the dedicated docs UI (default: disabled/read-only)
# DOCS_UI_EDIT_ENABLED=false
# Optional: Custom JWT signing secret (auto-generated if not set)
# WEBUI_SECRET="your-secret-here"

# Long-text summarization settings used by text_summarizer for large stash/transcript artifacts.
# Provider defaults to LLM_PROVIDER when unset. Model falls back to STASH_SUMMARIZE_MODEL for compatibility.
# TEXT_SUMMARIZER_LLM_PROVIDER=ollama
# TEXT_SUMMARIZER_LLM_MODEL=gemma4

# For over 2000 charcaters uses for saving in db, stash summary model used by stash metadata summaries and as a text_summarizer fallback model.
# STASH_SUMMARIZE_MODEL=gemma4

# Stash retention policy. Saved-conversation references and pinned spaces are protected.
# STASH_DEFAULT_TTL_DAYS=7
# STASH_GENERATED_MEDIA_TTL_DAYS=30
# STASH_SOURCE_ARTIFACT_TTL_DAYS=120
# STASH_CLEANUP_MAX_SPACES=100
# STASH_CLEANUP_MAX_BYTES_MB=512

# ===== Output Paths =====
# Use $HOME so a fresh install works for any Unix user (expanded when config loads).
AUDIO_DIR="$HOME/jarvis-voice/audio/local"

# ===== Proxy =====
# Optional: HTTP proxy for external API calls
# LOCAL_PROXY=http://user:pass@host:port
# Optional fallback if LOCAL_PROXY fails (lib/http_client tries primary → fallback → direct)
# LOCAL_PROXY2=http://user:pass@other-host:port
# Optional: stderr/info log when requests go direct with no proxy (default: DEBUG only)
# JARVIS_HTTP_LOG_DIRECT=true

# Tool RAG typo hints (embedding query only; see docs/TOOL_RAG_STRATEGY.md section E)
TOOL_RAG_TYPO_ENABLED=true
TOOL_RAG_TYPO_MAX_DISTANCE=1
TOOL_RAG_TYPO_MIN_TOKEN_LEN=4
TOOL_RAG_TYPO_MAX_HINTS=5

# ===== Intelligence Layer (Self-Learning) =====
# Intelligence is a core feature and is enabled by default.
# Advanced emergency opt-out: JARVIS_INTELLIGENCE=false

# Cross-turn user-correction learning:
# shadow = record correction candidates only (default); apply = retroactively downgrade prior experience
USER_CORRECTION_LEARNING_MODE=shadow

# Keep false unless every detected apply-mode correction should be appended to
# the Git-tracked, system-wide jarvis-learned-lessons.md document.
USER_CORRECTION_APPEND_LESSONS=false

# Inject ## Profile Card from jarvis-intel/user-profile.md at synthesis/QA prompts only
USER_PROFILE_CARD_ENABLED=true

# Learning parameters (advanced, optional)
INTELLIGENCE_LEARNING_RATE=0.1      # How fast to update beliefs
INTELLIGENCE_DECAY_RATE=0.95        # How fast old knowledge fades
INTELLIGENCE_ANOMALY_THRESHOLD=2.5  # Outlier detection sensitivity
INTELLIGENCE_MIN_CONFIDENCE=0.40    # Minimum confidence to apply insight
INTELLIGENCE_RELEVANCE_THRESHOLD=0.20 # Minimum cosine x confidence score for a matching insight
INTELLIGENCE_NEGATIVE_WEIGHT=1.5
INTELLIGENCE_DECAY_INTERVAL_DAYS=14 # Run decay every 2 weeks

# ===== Feedback System (LLM-as-QA) =====
# Use a DIFFERENT LLM to grade task performance (avoids self-grading bias)
# For local mode, you can use a cloud provider for better analysis
#
# Recommended: Use a powerful cloud model even in local mode
# Example: Ollama does tasks, Claude grades them
# Supported providers: anthropic, openai, xai, ollama
#
# FEEDBACK_PROVIDER=anthropic
# FEEDBACK_MODEL=claude-sonnet-5
#
# Or use the same Ollama but different model:
FEEDBACK_PROVIDER=ollama
FEEDBACK_MODEL=qwen3:32b
# FEEDBACK_MODEL=gemma4:26b-a4b-it-qat
#
# --- Random Feedback (Passive Learning) ---
# Enable random feedback collection during normal orchestrator operation.
# Jarvis Web disables this random path while Completion Guard is enabled so
# feedback grades the settled answer instead of a pre-guard draft.
FEEDBACK_RANDOM_ENABLED=false
# Chance of triggering feedback (0.1 = 10%, 0.05 = 5%)
FEEDBACK_RANDOM_CHANCE=0.05

# --- Self-Play Safety Overrides ---
# Built-in action-tool exclusions and the fail-closed read-only allowlist apply
# automatically. Add installation-specific exclusions here if needed.
# SELF_PLAY_EXCLUDED_TOOLS="custom_internal_tool"
# Opt in only additional tools you have reviewed as read-only. This cannot
# override built-in exclusions or tools marked dangerous.
# SELF_PLAY_ALLOWED_TOOLS="custom_read_only_tool"

# ============================================================================
# TOOL BUILDER (Dynamic Tool Creation)
# ============================================================================
# Provider for autonomous tool creation
# For true local mode, set to ollama. Otherwise falls back to FEEDBACK_PROVIDER
#
# TOOL_BUILDER_PROVIDER=anthropic
# TOOL_BUILDER_MODEL=claude-sonnet-5
# TOOL_BUILDER_MAX_TOKENS=8192
#
# Or use Ollama for full local mode:
TOOL_BUILDER_PROVIDER=ollama
TOOL_BUILDER_MODEL=gemma4
TOOL_BUILDER_MAX_TOKENS=8192

# ============================================================================
# PROMPT EVOLUTION SYSTEM
# ============================================================================
# Self-evolving prompts based on feedback. See docs/ADVANCED_AI_TECHNIQUES.md, not currently using anymore, intellegence system surpasses it. 
#
# --- Thresholds ---
# Minimum low ratings before triggering evolution (default: 2, production: 5)
EVOLUTION_MIN_LOW_RATINGS=2
#
# Rating threshold - ratings below this are "low" on the 1-5 feedback scale
EVOLUTION_LOW_THRESHOLD=3
#
# Days to look back for feedback (default: 3, production: 7)
EVOLUTION_WINDOW_DAYS=3
#
# --- Rate Limits ---
# Max evolutions per day (default: 5, production: 3)
EVOLUTION_MAX_PER_DAY=5
#
# --- Automation ---
# Enable auto-evolution after feedback threshold (default: false)
EVOLUTION_AUTO_ENABLED=false
#
# Run evolution check after this many new feedback entries (default: 10)
EVOLUTION_AUTO_CHECK_AFTER=10
#
# --- Auto Sync on API/Service Start ---
# Sync evolution data between cloud/local when jarvis-api starts
EVOLUTION_AUTO_SYNC=false

# ========================================
# TOOL BLOCKLIST
# ========================================
# Comma-separated tool names excluded from sync (LLM won't see them).
# Tools stay enabled in skills/*.tool.json — this only hides them until you
# configure the external service, then remove the name from this list.
#
# Default blocklist (custom / external infra — not needed for a fresh clone):
#   samantha          — OpenClaw gateway on remote VPS (SAMANTHA_URL, SAMANTHA_GATEWAY_TOKEN)
#   ssh_remote        — Personal SSH hosts (copy config/ssh.json.example → config/ssh.json)
#   phone_call        — Vapi.ai outbound calls (VAPI_API_KEY, VAPI_PHONE_NUMBER_ID)
#   spotify           — Spotify OAuth (run ./bin/spotify-auth after credentials)
#   create_social_clip — MoneyPrinterTurbo server (MONEYPRINTER_API_URL)
#   crawl_url         — Crawl4AI scraper service (CRAWL4AI_URL)
#   screenshot_url    — Crawl4AI screenshot service (CRAWL4AI_URL)
#   upload_cloudflare — Cloudflare Images CDN (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID)
#   send_email        — Email webhook in config/webhook_registry.json
#   printer           — Local CUPS printer
#   serpapi_amazon_search    — SerpApi paid Amazon search (SERP_API_KEY); add other serpapi_* if needed
#   brave_llm_context — Brave Search API (BRAVE_API_KEY)
#
# Example: BLOCKED_TOOLS="mcp_some_server_heavyTool,mcp_some_server_slowTool"
BLOCKED_TOOLS="samantha,ssh_remote,phone_call,spotify,create_social_clip,crawl_url,screenshot_url,upload_cloudflare,send_email,printer,serpapi_amazon_search,brave_llm_context"

# ========================================
# VAPI.AI PHONE CALLS
# ========================================
# Make AI phone calls via Vapi.ai
# Sign up at https://vapi.ai and get your API key
#
# Private API Key (from Vapi dashboard > Organization Settings > API Keys)
# VAPI_API_KEY=""
#
# Phone Number ID (from Vapi dashboard > Phone Numbers)
# You need to purchase or import a phone number in Vapi
# VAPI_PHONE_NUMBER_ID=""
#
# Optional: Default Assistant ID (if you create one in dashboard)
# If not set, tool will create temporary assistants per-call
# VAPI_ASSISTANT_ID=""
#
# VAPI_ELEVENLABS_KEY="true"
# Optional: ElevenLabs Voice ID for phone calls
# Falls back to ELEVENLABS_TTS_VOICE if not set
# VAPI_VOICE_ID=""
# Female voice ID for "female" persona
# VAPI_FEMALE_VOICE_ID=""
#
# LLM provider for phone call AI (Vapi supports: xai, anthropic, openai, groq, together)
# VAPI_LLM_PROVIDER="xai"
# VAPI_LLM_MODEL="grok-4.20-0309-non-reasoning"
# Owner name (how Jarvis identifies who it's calling on behalf of)
OWNER_NAME="Boss"
#
# Phone contacts as JSON (optional - can also save via memory)
# Example: PHONE_CONTACTS='{"boss": "+15551234567", "andrew": "+15559876543"}'
PHONE_CONTACTS='{}'
# Wait for call completion?
# true = Jarvis waits during call, gives instant results (best for CLI/testing)
# false = Fire and forget, ask "what happened on that call?" later (best for voice mode)
VAPI_WAIT_FOR_CALL=true
# Max seconds to poll Vapi when waiting for call end (orchestrator phone_call timeout is 900s)
# VAPI_WAIT_TIMEOUT=900
# Voicemail handling: "hangup" (detect & end), "message" (leave msg), "disabled"
VAPI_VOICEMAIL_ACTION="hangup"

# =============================================================================
# IMAGE GENERATION TOOL
# =============================================================================
# Provider: gemini, openai, or xai
IMAGE_TOOL_PROVIDER="xai"
# OpenAI image model (if using openai provider)
#   gpt-image-2     = State of the art (flexible sizes, high-fidelity edits; no transparent backgrounds)
#   gpt-image-1.5   = Previous state of the art (transparent backgrounds)
#   gpt-image-1     = Previous gen (still excellent)
#   gpt-image-1-mini = Faster, lower cost
# Optional model pin; leave unset to follow lib/model_catalog.py.
# OPENAI_IMAGE_MODEL="gpt-image-2"
OPENAI_API_KEY=""

# Google Gemini API Key (for image generation)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=""
# Gemini image model options:
#   gemini-3.1-flash-image     = Best all-around price/latency, grounding, up to 4K
#   gemini-3-pro-image         = Best quality, grounding, up to 4K
#   gemini-2.5-flash-image     = Older efficient model, 1K output
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# xAI Image Generation Model
# XAI_IMAGE_MODEL="grok-imagine-image"
XAI_API_KEY=""

# ===== Social Clip Tool (MoneyPrinterTurbo B-roll) =====
# Stock footage + voiceover + subtitles + BGM. NOT AI video generation. https://github.com/harry0703/MoneyPrinterTurbo
# MONEYPRINTER_API_URL="http://192.168.x.xx:8080"
# MONEYPRINTER_MAX_WAIT_SEC=1200
# MONEYPRINTER_VOICE="en-CA-LiamNeural-Male"

# =============================================================================
# MUSIC GENERATION TOOL
# =============================================================================
# Provider abstraction for generate_music and /api/generated-music/generate.
# Supported: elevenlabs (ELEVENLABS_API_KEY) or gemini (GEMINI_API_KEY).
MUSIC_TOOL_PROVIDER="elevenlabs"
ELEVENLABS_MUSIC_MODEL="music_v1"
# Optional full-song Gemini model: lyria-3-pro-preview
GEMINI_MUSIC_MODEL="lyria-3-clip-preview"

# =============================================================================
# VIDEO GENERATION TOOL
# =============================================================================
# xai, openai, or gemini (default: xai)
VIDEO_TOOL_PROVIDER="xai"

# xAI Grok Imagine Video - $0.05-0.07/second (resolution-dependent)
# Optional model pins; leave unset to follow lib/model_catalog.py.
# XAI_VIDEO_MODEL="grok-imagine-video"

# OpenAI Sora - $0.10/second (sora-2) or $0.30-0.50/second (sora-2-pro)
# sora-2: 720p, sora-2-pro: up to 1080p
# OPENAI_VIDEO_MODEL="sora-2"

# Google Gemini - Veo Fast is the catalog default; Omni Flash is opt-in at 720p
# veo-3.1-fast-generate-preview, veo-3.1-generate-preview, or gemini-omni-flash-preview
# GEMINI_VIDEO_MODEL="veo-3.1-fast-generate-preview"

# ===================================================================
# SSH Remote Tool - Sudo Passwords
# ===================================================================
# These are sudo passwords for remote hosts configured in config/ssh.json
# Only used by ssh_remote tool when running sudo commands
# Each host can have its own sudo password env var (e.g., VPS2_SUDO_PASS)
# VPS2_SUDO_PASS=""

# Github Token for git_release_notes tool
# GITHUB_TOKEN=""

# Trakt application Client ID for public movie and TV-show metadata (no OAuth required).
# Create an app at https://app.trakt.tv/settings/apps/api
# TRAKT_API_KEY=""
# Optional read-only Trakt account access. Register the exact redirect URI,
# then run: ./bin/trakt-auth --mode local
# TRAKT_CLIENT_SECRET=""
# TRAKT_REDIRECT_URI="urn:ietf:wg:oauth:2.0:oob"

# TMDB public movie/TV metadata and artwork. The API Read Access Token is preferred;
# the v3 API key is supported as a fallback. Either one enables both TMDB tools. see https://www.themoviedb.org
# TMDB_ACCESS_TOKEN=""
# TMDB_API_KEY=""

# ============================================================================
# FULL LOCAL MODE (No Cloud Dependencies)
# ============================================================================
# To run Jarvis completely offline with no cloud API calls, set ALL providers to ollama:
#
# FEEDBACK_PROVIDER=ollama
# FEEDBACK_MODEL=gemma4
# TOOL_BUILDER_PROVIDER=ollama
# TOOL_BUILDER_MODEL=gemma4
# OPENCODE_PROVIDER=ollama
# OPENCODE_MODEL=gemma4
#
# Note: Local models may have lower quality for complex tasks like feedback grading
# and tool generation, but provide full privacy and offline capability.
