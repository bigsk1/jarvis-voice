# Jarvis Voice Assistant - Local/Offline Configuration

# ===== OpenCode Integration =====
# Enable/disable OpenCode autonomous agent integration
# When enabled, Jarvis can use OpenCode for complex multi-step tasks
# OpenCode server must be running (systemd service or manual)
OPENCODE_ENABLED=true
OPENCODE_BASE_URL="http://localhost:4096"
# claude-sonnet-4-20250514 ,  claude-3-7-sonnet-20250219 , claude-sonnet-4-5-20250929 , qwen-vl
# dangerous currently to trust without sandbox enviroment using ollama small models
# OpenAI Models
# gpt-5.1 , gpt-4o , gpt-4.1 , gpt-5.1-codex-mini , gpt-5.1-codex , gpt-5-mini , gpt-5-codex , gpt-5.1-chat-latest
OPENCODE_MODEL="claude-sonnet-4-5-20250929"
# ollama , anthropic 
OPENCODE_PROVIDER="anthropic"

# ===== LLM Provider for Tool Calling and Chat for JARVIS =====
# Options: "ollama" (structured prompting)
LLM_PROVIDER="ollama"

# ===== Local API Endpoints =====
OLLAMA_BASE_URL="http://192.168.70.226:11434"
# Best models for tool calling on 16GB GPU (tested & verified):
# 1. qwen3-vl:8b ⭐ WINNER - Excellent tool calling, 256K context, NO LOOPS!
#    Released 2 weeks ago, best balance of speed and accuracy
#    Context: 256K native (32K used by default for VRAM safety)
# 2. mistral-nemo - Good 128K context, decent tool calling (sometimes loops)
# 3. qwen2.5:7b - Good structured output but loops on simple queries
# 4. llama3-groq-tool-use - Lightweight but inconsistent, skips tools
OLLAMA_MODEL="qwen3-vl"

# Embedding model for semantic memory search
# nomic-embed-text: 768 dimensions, fast, works offline
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# ===== Response Style =====
# How Jarvis formats tool results for voice output
# Options: "casual", "detailed", "auto"
#   casual: Always format with LLM for natural conversation (best for voice)
#   detailed: Use raw tool output (good for debugging)
#   auto: Smart mode - format search results, keep other tools raw
JARVIS_RESPONSE_STYLE="casual"

# Jarvis timezone for date/time awareness in system prompt
# Uses IANA timezone names (e.g., America/Los_Angeles, America/New_York, Europe/London)
JARVIS_TIMEZONE="America/Los_Angeles"

# ===== Memory System =====
# Semantic search similarity threshold (0.0-1.0)
# Lower = more results (may include loosely related memories)
# Higher = fewer results (only close matches)
# Recommended: 0.35-0.45 range
# Default: 0.40 (balanced - catches paraphrased queries)
SEMANTIC_SIMILARITY_THRESHOLD=0.40

# ===== Tool RAG System (Dynamic Tool Retrieval) =====
# Ghost Tools: Core tools ALWAYS available to LLM (comma-separated)
# These ensure basic functionality never fails even if vector search misses
# Recommended: memory, logs, time (essential for self-correction)
GHOST_TOOLS="search_memory,semantic_recall,remember,check_tool_logs,get_recent_conversations,get_time,send_email,send_webhook"

# Tool Retrieval Similarity Threshold (0.0-1.0)
# Minimum similarity score for a tool to be retrieved
# Lower = more tools retrieved (may include less relevant)
# Higher = fewer tools retrieved (only highly relevant)
# Set to 0.0 to disable threshold (use top-K only)
# Recommended: 0.15-0.25 for cloud, 0.20-0.30 for local
TOOL_SIMILARITY_THRESHOLD=0.20

TTS_URL="http://192.168.70.226:8880/v1/audio/speech"
TTS_VOICE="am_v0michael"
TTS_SPEED="1.0"

# faster-whisper model: tiny.en, small.en, base.en, medium.en
STT_MODEL="small.en"
STT_DEVICE="cpu"
STT_COMPUTE_TYPE="int8"

# ===== Audio Devices =====
# USB Microphone (capture)
IN_DEV="plughw:CARD=microphone,DEV=0"
DEVICE_NAME_HINT="TONOR"

# Analog Speaker (playback)
OUT_DEV="plughw:CARD=Generic_1,DEV=0"

# ===== Wake Word Settings =====
# These values are FINE-TUNED for your noisy office + far-field mic
# DO NOT change unless you're testing in a new environment
WAKE_MODEL="hey_jarvis"
SAMPLE_RATE=16000
BLOCK_SIZE=1024
CHANNELS=1

# Sensitivity tuning
TRIGGER_THRESHOLD=0.2    # 0.2-0.5 range; lower = more sensitive
HIT_FRAMES_REQUIRED=4    # consecutive frames needed to trigger
MIN_RMS=2e-4             # noise gate threshold
VAD_THRESHOLD=0.40       # Voice Activity Detection threshold

# Timing controls
ARM_GRACE_SEC=1.2        # ignore triggers after re-arming for this duration
COOLDOWN_AFTER_QA=2.8    # cooldown before re-arming after Q&A

# ===== Recording Settings (SoX) =====
RATE=48000
CHAN=1
THRESH="3%"              # silence threshold
PRE_SIL="0.1"            # silence before speech starts
POST_SIL="1.2"           # silence to stop recording
MAX_RECORD_TIME="30"     # hard timeout (seconds) - prevents infinite recording from background noise

# ===== System Prompt =====
SYSTEM_PROMPT="You are a role playing helpful AI assistant called Jarvis. Reply in plain ASCII, no emoji, no markdown, no bullet points."

# Wake greeting
# Wake word greetings (pipe-separated list for variety)
WAKE_GREETINGS="What's up?|How can I serve you?|Yes?|Ready.|Go ahead.|I'm listening."

# ===== Output Paths =====
AUDIO_DIR="/home/boss/jarvis-voice/audio/local"


# Ollama Context Window (num_ctx)
# How many tokens the model can process at once
# Default: 12288 (balanced - works on most 16GB GPUs)
# Options based on VRAM:
#   8192  = ~12GB VRAM (safe, but may truncate tool definitions)
#  12288  = ~13GB VRAM (recommended for 16GB cards)
#  16384  = ~14GB VRAM (if you have headroom)
#  32768  = ~15GB VRAM (risky, can cause timeouts)
# See bin/measure-baseline-tokens for current tool usage
OLLAMA_CONTEXT_WINDOW=12288

# ===== n8n Integration (Google Calendar Sync) =====
# n8n local instance URL and API key
N8N_LOCAL_API_URL="http://192.168.70.226:5678"
N8N_LOCAL_API_KEY=""
# Webhook URL for Jarvis → Google Calendar sync
# This webhook is created by the "Jarvis → Google Calendar Sync" workflow
N8N_JARVIS_WEBHOOK_URL="http://192.168.70.226:5678/webhook/jarvis-reminder"

# ===== External API Keys =====
# COINGECKO_API_KEY=
# BRAVE_API_KEY=

# Weather API (OpenWeatherMap free tier: 60 calls/min, 5-day forecast)
# Get your API key at: https://openweathermap.org/api
# Provider options: "openweathermap" (default), "wttr" (no key needed, fallback)
# WEATHER_PROVIDER=openweathermap
# OPENWEATHER_API_KEY=

# ===== Status Updates (Voice Progress Feedback) =====
# Enable voice status updates during long-running tasks
STATUS_UPDATES_ENABLED=true
STATUS_UPDATE_INTERVAL=20
# Phrase mode: 'normal' (professional) or 'unhinged' (chaotic/funny)
STATUS_PHRASE_MODE=normal
STATUS_HUMOR_ENABLED=true
STATUS_ENCOURAGEMENT_ENABLED=true

# Sass level: 0=professional, 1=friendly with sass hint, 2=confidently sassy
STATUS_SASS_LEVEL=1

# Silence padding before status audio (ms) - helps speakers "wake up"
# Increase if first words are cut off (Bluetooth/wireless speakers need more)
STATUS_SILENCE_PAD_MS=250

# Status LLM (dynamic summaries - uses local Ollama)
STATUS_LLM_ENABLED=true
STATUS_LLM_PROVIDER=ollama
STATUS_LLM_MODEL=qwen2.5:1.5b
STATUS_LLM_MAX_TOKENS=30

# ===== Intelligence Layer (Self-Learning) =====
# Enable self-learning from interactions (default: true)
JARVIS_INTELLIGENCE=true

# Learning parameters (advanced, optional)
INTELLIGENCE_LEARNING_RATE=0.1      # How fast to update beliefs
INTELLIGENCE_DECAY_RATE=0.95        # How fast old knowledge fades
INTELLIGENCE_ANOMALY_THRESHOLD=2.5  # Outlier detection sensitivity
INTELLIGENCE_MIN_CONFIDENCE=0.3     # Minimum confidence to apply insight
INTELLIGENCE_NEGATIVE_WEIGHT=1.5

# Optional: HTTP proxy for external API calls
# LOCAL_PROXY=http://user:pass@host:port

# ===== Feedback System (LLM-as-QA) =====
# Use a DIFFERENT LLM to grade task performance (avoids self-grading bias)
# If not set, uses the same LLM as the task (not recommended)
#
# Recommended: Use your most capable model for feedback (it reviews everything)
# Example: If using xAI for tasks, use Claude for grading
#
FEEDBACK_PROVIDER=anthropic
FEEDBACK_MODEL=claude-sonnet-4-5-20250929
#
# Or use OpenAI:
# FEEDBACK_PROVIDER=openai
# FEEDBACK_MODEL=gpt-4o
#
# Supported providers: anthropic, openai, xai, ollama

# ============================================================================
# PROMPT EVOLUTION SYSTEM
# ============================================================================
# Self-evolving prompts based on feedback. See docs/ADVANCED_AI_TECHNIQUES.md
#
# --- Thresholds (Testing Mode - Lower values for faster feedback) ---
# Minimum low ratings before triggering evolution (default: 2, production: 5)
EVOLUTION_MIN_LOW_RATINGS=2
#
# Rating threshold - ratings below this are "low" (default: 7, production: 6)
EVOLUTION_LOW_THRESHOLD=7
#
# Days to look back for feedback (default: 3, production: 7)
EVOLUTION_WINDOW_DAYS=3
#
# --- Rate Limits ---
# Max evolutions per day (default: 5, production: 3)
EVOLUTION_MAX_PER_DAY=5
#
# --- Automation ---
# Enable auto-evolution after feedback threshold (default: false)
# When true, evolution check runs automatically after EVOLUTION_AUTO_CHECK_AFTER feedback entries
EVOLUTION_AUTO_ENABLED=false
#
# Run evolution check after this many new feedback entries (default: 10)
EVOLUTION_AUTO_CHECK_AFTER=10
#
# --- Degradation Detection ---
# Alert when performance drops by this % (default: 15)
# EVOLUTION_DEGRADATION_ALERT_PCT=15
#
# Auto-rollback when performance drops by this % (default: 25)
# EVOLUTION_DEGRADATION_ROLLBACK_PCT=25
#
# --- A/B Testing ---
# Sample size for A/B tests (default: 10, production: 20)
# EVOLUTION_AB_TEST_SIZE=10
#
# --- Auto Sync on API/Service Start ---
# Sync evolution data between cloud/local when jarvis-api starts
# Default: false (manual sync recommended until system is proven stable)
# Set to true after you've verified evolution is working correctly
EVOLUTION_AUTO_SYNC=false