{
  "$schema": "https://opencode.ai/config.json",
  "model": "xai/grok-4.7",
  "agents": {
    "title": { "model": "xai/grok-4.7" }
  },
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "settings": { "baseURL": "http://localhost:11434/v1" },
      "models": { "gemma4": { "name": "Gemma4" } }
    },
    "openai": {
      "settings": { "apiKey": "{env:OPENAI_API_KEY}" },
      "models": { "gpt-6.1-sol": { "name": "GPT-6.1 Sol" } }
    },
    "anthropic": {
      "settings": { "apiKey": "{env:ANTHROPIC_API_KEY}" },
      "models": { "claude-sonnet-5-5": { "name": "Claude Sonnet 5.5" } }
    },
    "xai": { "settings": { "apiKey": "{env:XAI_API_KEY}" } }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "ollama", "effect": "allow" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
    { "action": "provider.use", "resource": "anthropic", "effect": "allow" },
    { "action": "provider.use", "resource": "xai", "effect": "allow" }
  ],
  "update": "notify",
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ]
}
