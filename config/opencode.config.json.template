{
  "$schema": "https://opencode.ai/config.json",
  "model": "xai/grok-build-0.1",
  "small_model": "ollama/gemma4",
  "enabled_providers": ["ollama", "openai", "anthropic", "xai"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://<OLLAMA_HOST>:11434/v1"
      },
      "models": {
        "mistral-nemo": {
          "name": "Mistral Nemo"
        }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini"
        }
      }
    },
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic",
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6"
        }
      }
    }
  },
  "disabled_providers": ["cloudflare-workers", "amazon-bedrock", "nvidia", "workers-ai", "bedrock", "huggingface"],
  "autoupdate": true,
  "permission": {
    "edit": "allow",
    "bash": "allow"
  }
}
