# Jarvis Voice Assistant - Cloud Configuration (EXAMPLE)
# Copy this file to cloud.env and fill in your actual API keys
# Disabled tools in skills/ not needed set to false, and comment vars below for those tools then run once db's are setup ./bin/sync-tools.py cloud --force
#
# Quick start (OpenAI only): use config/cloud.openai.env.example instead — a
# trimmed template with one required secret (OPENAI_API_KEY). Or set OPENAI_API_KEY
# below, keep LLM_PROVIDER=openai and TTS_PROVIDER=openai. Chat, TTS, STT,
# embeddings, Completion Guard eval, and image/video tools in this file already
# point at OpenAI. Add XAI/Anthropic keys only if you switch providers.

# ===== Tool profiles (optional overlay on skills/**/*.tool.json enabled flags) =====
# JSON files: skills/profiles/<name>.json — see skills/README.md (Tool profiles) and skills/profiles/examples
# After changing profile: restart Jarvis services, then run ./bin/sync-tools.py local (or cloud)
JARVIS_TOOL_PROFILE=default
# JARVIS_TOOL_PROFILE=offline

# ===== Memory System =====
# Semantic search similarity threshold (0.0-1.0)
# Lower = more results (may include loosely related memories)
# Higher = fewer results (only close matches)
# Recommended: 0.30-0.45 range
# Default: 0.30 (balanced - catches paraphrased queries) - 0.30 - 0.35 works good
SEMANTIC_SIMILARITY_THRESHOLD=0.32

# Auto-Context (Short-Term Conversation Memory) - Good for CLI / Wake word follow up's, disbale if using Webui as it uses it's own context system.
# Automatically inject recent conversation history into each request
# Enables natural follow-up responses and self-learning from failures
# When true, prepends === RECENT CONVERSATION HISTORY === (and Instructions:); router can strip to a short line for Tool RAG embeddings.
AUTO_CONTEXT_ENABLED=false

# Number of recent conversations to include (2-5 recommended) - web has it's own data/web_conversations/
AUTO_CONTEXT_WINDOW=2

# Time window in minutes (only include conversations within this time)
# Recommended: 5-15 minutes (voice conversations are typically bursty) - cli only
AUTO_CONTEXT_MINUTES=5

# Auto-Memory Injection (CLI, WebUI, wake word - all entry points)
# Automatically inject relevant memories from vector DB into context before each LLM call
# No tool calls needed - "call me sir" in new chat works without search_memory
AUTO_MEMORY_INJECTION_ENABLED=true

# Max memories to inject per request (3-10 recommended)
AUTO_MEMORY_LIMIT=3
   
# Minimum similarity score (0.0-1.0). 0.35-0.55 recommended.
AUTO_MEMORY_SIMILARITY_THRESHOLD=0.40

# Recency weighting: recent memories rank slightly higher than 60+ day old
AUTO_MEMORY_RECENCY_ENABLED=true

# Always-include: max addressing/response-style items (call me sir, tone, language)
# 0=disable, 2=recommended. Topic prefs use semantic search only.
AUTO_MEMORY_ALWAYS_INCLUDE_LIMIT=2

# Exclude artifact/transient rows from auto-inject (preference/fact only).
# Legacy rows without memory_type are classified on the fly; run ./bin/backfill-memory-types once.
AUTO_MEMORY_TYPE_FILTER_ENABLED=true

# ===== Response Style =====
# How Jarvis formats tool results for voice output
# Options: "casual", "detailed", "auto"
#   casual: Always format for voice - BEST FOR VOICE
#     - Q&A responses: up to JARVIS_QA_WORD_LIMIT (default 75 words)
#     - Multi-turn: up to JARVIS_MULTI_TURN_WORD_LIMIT (default 50 words)
#     - Tool confirmations: 35 words max (hardcoded)
#     - Strips stash:// refs, long URLs, file paths from speech
#   detailed: Raw LLM output with full context - BEST FOR CLI/DEBUGGING or only using WEB UI chat. ( Can be updated in WEB UI directly to override )
#   auto: Smart adaptive mode (RECOMMENDED):
#     - Search tools → Format for voice (remove URLs, summarize)
#     - Simple tools (get_time, crypto_price) → Keep if short (<25 words)
#     - Complex tools (opencode) → Keep detailed if >50 words
#     - Multi-turn → Always format summary of ALL tools
#     - Unlisted tools → Default to condense
JARVIS_RESPONSE_STYLE="auto"

# Wake word voice path override (question-orchestrator.sh / ./jarvis)
# Safety default is "auto" so wake word never inherits global "detailed" by accident.
# Allowed values here are only: "auto" or "casual". Any other value falls back to "auto".
# JARVIS_WAKE_RESPONSE_STYLE="auto"
# Optional tighter wake-word-only limits. When unset, normal JARVIS_QA_WORD_LIMIT /
# JARVIS_MULTI_TURN_WORD_LIMIT still apply.
# JARVIS_WAKE_QA_WORD_LIMIT=125
# JARVIS_WAKE_MULTI_TURN_WORD_LIMIT=125

# Word limit for Q&A/single-turn voice responses (casual/auto mode)
# Used by _format_single_turn_casual() for:
#   - Pure Q&A (no tools)
#   - Search tool results
#   - Simple tool results when >25 words
#   - Default fallback for unlisted tools
# Tool confirmations stay short (35 words hardcoded separately)
# Default: 75 words good for voice only jarvis wake word and tts, if using UI only with tts off set to 200+ here or override in ai config in ui settings
JARVIS_QA_WORD_LIMIT=200

# Word limit for multi-turn/multi-tool summaries (casual/auto mode)
# Used by _format_multi_turn_summary() when turn_num > 0
# Summarizes ALL tool results from entire task into one spoken response
# NOTE: Named entities (movie titles, business names, etc.) are ALWAYS preserved
# NOTE: stash:// refs and long URLs are stripped from speech
# Default: 50 words good for voice only jarvis wake word, if using UI and tts off set to 150+
JARVIS_MULTI_TURN_WORD_LIMIT=200

# ===== Completion Guard =====
# Ask "Completed correctly?" after responses in the Web UI.
# Helps catch incomplete or unsupported answers after the main task ends.
# Modes:
#   - manual: show a "Completed correctly?" card in the Web UI (you are the judge)
#   - auto: run a background evaluator on the raw final answer (uses EVAL_PROVIDER/MODEL below)
#       - accepted / tighten_only do NOT use the threshold
#       - only real repair escalation is gated by AUTO_THRESHOLD
#       - tighten_only means "basically correct, only minor wording/scope cleanup"
# Repair passes (manual "No" or auto-triggered) always use the main chat LLM/orchestrator,
# not the eval model below. Tickets are markdown files.
JARVIS_COMPLETION_GUARD_ENABLED=true
JARVIS_COMPLETION_GUARD_MODE="manual"
# Auto threshold for auto mode:
#   - higher = fewer repair passes
#   - lower = more aggressive repair triggering
#   - does NOT disable auto evaluation itself
#   - does NOT affect accepted or tighten_only outcomes
JARVIS_COMPLETION_GUARD_AUTO_THRESHOLD=0.89
JARVIS_COMPLETION_GUARD_TICKET_ON_FAIL=true
JARVIS_COMPLETION_GUARD_SHOW_UI_PROMPT=true
# Manual Web UI prompt countdown / expiry (seconds). Expired prompts settle neutrally.
JARVIS_COMPLETION_GUARD_MANUAL_TTL_SECONDS=600
JARVIS_COMPLETION_GUARD_INCLUDE_QA=true
JARVIS_COMPLETION_GUARD_INCLUDE_TOOL_TASKS=true
# Do not run Completion Guard repair after these tools were already used below
COMPLETION_GUARD_EXCLUDED_TOOLS="phone_call,send_email,create_reminder,create_alert,printer,send_webhook,ssh_remote,generate_video,generate_image,generate_music"

# AUTO MODE ONLY — background judge (manual mode uses the UI card instead; repair uses main chat LLM).
# ollama (incl. :cloud model cards via OLLAMA_BASE_URL), openai, xai, anthropic
JARVIS_COMPLETION_GUARD_EVAL_PROVIDER=openai

# AUTO MODE ONLY — e.g. gpt-5.4-nano, grok-4.3, claude-sonnet-5, minimax-m2.5:cloud, qwen3-coder-next:cloud
JARVIS_COMPLETION_GUARD_EVAL_MODEL=gpt-5.4-nano

# Jarvis timezone for date/time awareness in system prompt
# Uses IANA timezone names (e.g., America/Los_Angeles, America/New_York, Europe/London)
JARVIS_TIMEZONE="America/Los_Angeles"

# Default location for weather and location-based queries when user does not specify one
# Examples: "Seattle, WA", "London, UK"
# Do NOT use for time/timezone - that uses JARVIS_TIMEZONE
JARVIS_DEFAULT_LOCATION=""
# Optional postal/ZIP code for tools that need a structured postal code
# Examples: "98101", "SW1A 1AA"
JARVIS_DEFAULT_POSTAL_CODE=""

# ===== Status Updates (Voice Progress Feedback) =====
# Enable voice status updates during long-running tasks
# Provides periodic updates like "Still working..." or "Almost there..."
STATUS_UPDATES_ENABLED=true

# Minimum seconds between status updates (prevents spam)
STATUS_UPDATE_INTERVAL=18

# Wait this long before emitting status, so very fast tools can finish silently
STATUS_UPDATE_DEBOUNCE_MS=250

# Silence padding before status audio (ms) - helps speakers "wake up"
# Increase if first words are cut off (Bluetooth/wireless speakers need more)
STATUS_SILENCE_PAD_MS=250

# Cache generated status audio (saves API costs, instant playback for repeated phrases)
# Cache location: ~/.cache/jarvis/status-tts/
STATUS_CACHE_ENABLED=true

# Structured status LLM/lifecycle audit logs (logs/llm-calls-* and logs/status-llm/*)
STATUS_LOGGING_ENABLED=true

# Status phrase personality
# Options: 'normal' (professional), 'unhinged' (chaotic/funny)
STATUS_PHRASE_MODE=normal

# Include funny/witty phrases in normal mode
STATUS_HUMOR_ENABLED=true

# Include encouraging phrases
STATUS_ENCOURAGEMENT_ENABLED=true

# Sass level: 0=professional, 1=friendly with sass hint, 2=confidently sassy
STATUS_SASS_LEVEL=1

# ===== Status LLM (Dynamic Summaries) =====
# Use a small/fast LLM for a bounded, sanitized execution snapshot
# Falls back to static phrases if disabled or fails
STATUS_LLM_ENABLED=true

# Provider: openai, xai, anthropic, ollama
STATUS_LLM_PROVIDER=openai

# Model: Use small/fast/cheap models
# OpenAI: gpt-4o-mini (recommended - fast, cheap)
# xAI: grok-4 (uses same API key as main)
# Ollama: qwen2.5:1.5b, phi3:mini
STATUS_LLM_MODEL=gpt-4o-mini

# Dynamic phrase deadline only; tools start immediately and never wait for it
# Static fallback wins after this deadline and late LLM responses are discarded
STATUS_LLM_DEADLINE_MS=1000

# Max tokens for summary (keep short for fast TTS)
STATUS_LLM_MAX_TOKENS=30

# ===== OpenCode Integration =====
# Enable/disable OpenCode autonomous agent integration
# When enabled, Jarvis can use OpenCode for complex multi-step tasks
# OpenCode server must be running (systemd service or manual)
# independent of Jarvis LLM_PROVIDER above.
OPENCODE_ENABLED=false
OPENCODE_BASE_URL="http://localhost:4096"

# Options: xai, anthropic, openai
OPENCODE_PROVIDER="xai"

# xAI: grok-build-0.1, grok-4.3
# Anthropic: claude-sonnet-4-5-20250929, claude-sonnet-5
# OpenAI: gpt-5.4-mini
# OpenAI Codex models may require API-account support and can fail on ChatGPT-account auth.
OPENCODE_MODEL="grok-build-0.1"
# Optional HTTP Basic auth for the OpenCode server and web UI.
# Username defaults to "opencode" when omitted.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=your-opencode-password

# ===== LLM Provider for Tool Calling and Chat for JARVIS =====
# Set new models in lib/model_catalog.py = source of truth
# Options: "anthropic", "openai", "xai", "ollama"
#
# Default: openai — works with OPENAI_API_KEY only (recommended for new installs).
# Switch to xai or anthropic only after you set XAI_API_KEY / ANTHROPIC_API_KEY.
#
# Setting LLM_PROVIDER=ollama in cloud mode keeps this a CLOUD deployment:
# cloud Memory/Intelligence DBs and cloud (OpenAI) embeddings are preserved.
#
# To use Ollama Cloud as the primary cloud chat provider (pick ONE auth path):
#   LLM_PROVIDER="ollama"
#   OLLAMA_CLOUD_MODEL="minimax-m3:cloud"   # cloud-tagged (*:cloud or *-cloud)
#   EMBEDDING_PROVIDER=openai            # keep cloud DB embedding dimensions (1536-dim)
#
#   Path A — signed-in daemon (default when OLLAMA_API_KEY is unset):
#     OLLAMA_BASE_URL="http://your-signed-in-ollama-host:11434"
#     Run `ollama signin` on that host.
#
#   Path B — direct ollama.com API (when OLLAMA_API_KEY is set, daemon is NOT used):
#     OLLAMA_API_KEY=your_key_from_ollama_com_settings_keys
#     # OLLAMA_BASE_URL ignored for cloud-model calls; goes to ollama.com see docs/ollama/README.md

LLM_PROVIDER="openai"

# Cloud-mode Ollama primary model (used only when LLM_PROVIDER=ollama).
# Model name for chat/vision in cloud mode. Signed-in daemon mode requires a
# cloud tag; direct API mode also accepts canonical IDs returned by ollama.com.
# With OLLAMA_API_KEY: served from https://ollama.com directly.
# Without key: served via signed-in daemon at OLLAMA_BASE_URL.
# OLLAMA_VISION_MODEL is local-mode only — see docs/ollama/README.md § Vision.
# OLLAMA_MODEL is the LOCAL default and is not used as the cloud primary model
# unless it is already cloud-tagged.
OLLAMA_CLOUD_MODEL="minimax-m3:cloud"

# Ollama Cloud direct API key (optional). When set in cloud mode, Jarvis uses
# https://ollama.com only — OLLAMA_BASE_URL is not used for cloud-model inference.
# When unset, cloud models require a signed-in daemon at OLLAMA_BASE_URL.
OLLAMA_API_KEY=""

# Ollama daemon URL(s) for signed-in-host mode (ignored when OLLAMA_API_KEY is set).
# OLLAMA_BASE_URL="http://localhost:11434"
# Cloud-backed models manage their own context; Jarvis does not send num_ctx.

# Embedding provider is independent of the chat provider. Cloud mode defaults to
# OpenAI (1536-dim) so the cloud DBs keep their existing embedding space even
# when chat uses Ollama. Options only: openai
EMBEDDING_PROVIDER=openai

# Anthropic Claude API (preferred for tool calling)
# claude-opus-4-8, claude-sonnet-4-6, claude-sonnet-5
ANTHROPIC_MODEL="claude-sonnet-5"

# Anthropic Web Search - Enable Claude's built-in web search tool
# When true: Claude can search the web for real-time info (server-side)
# When false: Uses external tools (Brave Search) - current default behavior
# Cost: Standard token pricing (search results count as input tokens)
# Benefits: Native integration, citations, real-time data
ANTHROPIC_SEARCH=true

# ANTHROPIC Api Key
ANTHROPIC_API_KEY=

# OPENAI MODELS
# gpt-5.1, gpt-4o, gpt-4.1, gpt-5-mini, gpt-5-codex, gpt-5.1-chat-latest, gpt-5.4-nano
OPENAI_MODEL="gpt-5.4-nano"

# Optional reasoning effort for GPT-5/o-series on Chat Completions. https://developers.openai.com/api/docs/models/all
# Supported values depend on model, but commonly include:
# minimal, low, medium, high
# Newer OpenAI docs also list: none, xhigh
# If unset, OpenAI uses the model default (currently medium for models before GPT-5.1).
# Some model + function-tool combinations on /v1/chat/completions may reject
# reasoning_effort and require /v1/responses instead. Jarvis skips this env
# override for known unsupported cases like gpt-5.4-mini with tools.
# OPENAI_REASONING_EFFORT="medium"

TTS_MODEL="gpt-4o-mini-tts"

# OpenAI TTS only (ignored when TTS_PROVIDER is xai, elevenlabs, etc.)
# alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse
VOICE="alloy"

# Cloud STT (OpenAI Whisper)
STT_PROVIDER="openai"
STT_MODEL="gpt-4o-mini-transcribe"

# ===== TTS Provider =====
# Default: openai — uses OPENAI_API_KEY + VOICE/TTS_MODEL above.
# Options: "openai", "elevenlabs", "xai", "qwen3-tts", "kokoro"
#   openai:     OpenAI TTS API ($15/1M chars)
#   elevenlabs: ElevenLabs TTS API (best quality, paid)
#   xai:        xAI native TTS API (uses XAI_API_KEY)
#   qwen3-tts:  Local network Qwen3-TTS server (free, 28 cloned voices) https://github.com/bigsk1/Qwen3-TTS-Openai-Fastapi
#   kokoro:     Local network Kokoro TTS server (free, 28 cloned voices) see https://github.com/remsky/Kokoro-FastAPI
TTS_PROVIDER=openai

# --- ElevenLabs Settings ---
# Model options: eleven_v3 (best accuracy), eleven_multilingual_v2 (stable), eleven_flash_v2_5 (fast)
# v3: Better accuracy for numbers/scores/times, 5k char limit, requires stability 0.0/0.5/1.0
# v2: More stable, 10k char limit, supports full voice_settings
ELEVENLABS_TTS_MODEL=eleven_v3
# Short progress phrases can favor lower latency/cost while final speech keeps the model above.
ELEVENLABS_STATUS_TTS_MODEL=eleven_flash_v2_5
# Get voice IDs from: https://elevenlabs.io/app/voice-library
ELEVENLABS_TTS_VOICE=your-voice-id-here

# Voice Settings (configurable per model)
# v3: stability must be 0.0 (Creative), 0.5 (Natural), or 1.0 (Robust)
# v2: stability can be any float 0.0-1.0
ELEVENLABS_TTS_STABILITY=0.5
ELEVENLABS_TTS_SIMILARITY_BOOST=0.5
# v2 only settings (ignored for v3):
ELEVENLABS_TTS_STYLE=0.5
ELEVENLABS_TTS_USE_SPEAKER_BOOST=true

# ELEVENLABS API
ELEVENLABS_API_KEY=

# --- Qwen3-TTS Settings (local network, free) ---
# Used when TTS_PROVIDER="qwen3-tts" (runs on mini-ai host with RTX 5060 Ti)
# QWEN3_TTS_URL="http://localhost:8881/v1/audio/speech"
# Voices: Jarvis, Paddington, Professor, Victoria, Josh, John, Mark, Adam, Russell,
# Lucy, Carmen, Caroline, Joanne, Natasha, Bianca, Curt, Samantha etc. (28 total)
# QWEN3_TTS_VOICE="Jarvis"
# QWEN3_TTS_FORMAT="mp3"
# QWEN3_TTS_SPEED="1.0"

# --- Kokoro TTS Settings ---
# Used when TTS_PROVIDER="kokoro"
# Voice IDs for KOKORO_TTS_VOICE (single id, or blend with + if your server supports it):
#   af_alloy, af_aoede, af_bella, af_heart, af_jadzia, af_jessica, af_kore, af_nicole,
#   af_nova, af_river, af_sarah, af_sky, af_v0, af_v0bella, af_v0irulan, af_v0nicole,
#   af_v0sarah, af_v0sky, am_adam, am_echo, am_eric, am_fenrir, am_liam, am_michael,
#   am_onyx, am_puck, am_santa, am_v0adam, am_v0gurney, am_v0michael, bf_alice, bf_emma,
#   bf_lily, bf_v0emma, bf_v0isabella, bm_daniel, bm_fable, bm_george, bm_lewis,
#   bm_v0george, bm_v0lewis
# KOKORO_TTS_URL="http://localhost:8880/v1/audio/speech"
#
# KOKORO_TTS_VOICE="af_sky"
# KOKORO_TTS_SPEED="1.0"

# --- xAI TTS Settings (optional — only when TTS_PROVIDER="xai") ---
# Used when TTS_PROVIDER="xai"
# Voices: eve, ara, rex, sal, leo
XAI_TTS_VOICE="rex"
XAI_TTS_LANGUAGE="en"
XAI_TTS_CODEC="mp3"
XAI_TTS_SAMPLE_RATE="24000"
XAI_TTS_BIT_RATE="128000"
XAI_TTS_MAX_CHARS="5000"
XAI_TTS_TIMEOUT="180"
# When TTS_PROVIDER="xai", allow final speech formatter to use a few xAI speech tags
# such as [pause], [laugh], <soft>...</soft>, and <whisper>...</whisper>.
XAI_TTS_STYLE_TAGS_ENABLED=true

# --- xAI chat / tools (API key or Grok CLI OAuth subscription) ---
# Authentication modes:
#   auto    API key when XAI_API_KEY is nonblank; otherwise ~/.grok/auth.json
#   api_key require XAI_API_KEY for chat
#   oauth   require a current `grok login` session and ignore XAI_API_KEY for chat
# OAuth uses xAI's documented CLI chat proxy for text and Jarvis tool calling.
# It does NOT authorize xAI image, video, vision, native search, or TTS APIs;
# those features still require XAI_API_KEY.
XAI_AUTH_MODE=auto
# OAuth model IDs are discovered from `grok models`. The documented direct-chat
# model is grok-build; coding-agent Composer models are intentionally excluded.
XAI_OAUTH_MODEL="grok-build"
# Safe default exposes only grok-build. If `grok models` later advertises a new
# model that xAI documents as direct chat-completions compatible, opt it in
# without a Jarvis code change. Composer agent models remain blocked.
# XAI_OAUTH_ALLOWED_MODELS="grok-build,grok-new-chat-model"
# Optional overrides for nonstandard installations:
# GROK_CLI_PATH="$HOME/.local/bin/grok"
# XAI_OAUTH_AUTH_FILE="$HOME/.grok/auth.json"

# Current recommendations:
# - grok-4.3 for reasoning / agentic tool workloads (recommended default)
# - grok-build-0.1 for coding / build-heavy workloads
# - grok-4.20-0309-non-reasoning for lower-latency non-reasoning workloads
XAI_MODEL="grok-build-0.1"

# xAI API key. Leave blank to let XAI_AUTH_MODE=auto use Grok CLI OAuth.
XAI_API_KEY=

# Default max output tokens for xAI requests when Jarvis does not pass a per-call limit.
# Especially useful for the xAI SDK Agent Tools path (XAI_SEARCH=true), where
# heavy models like grok-4.3 can otherwise return very large responses.
XAI_MAX_OUTPUT_TOKENS=8192
# Default xAI temperature. Lower values are usually better for tool-heavy Jarvis
# flows because they reduce exploratory/redundant search behavior.
XAI_TEMPERATURE=0.7
# Optional Grok 4.3 reasoning effort: low, medium, or high.
# xAI defaults to medium when this is unset. Use low for faster agentic/tool turns.
# Only sent for grok-4.3-family models; other Grok models reject this parameter.
# # latency/tokens for Jarvis' agentic tool-routing path. none, low (default), medium, high
XAI_REASONING_EFFORT=low

# Prompt-cache affinity. xAI caches repeated prefixes automatically, but cache
# entries are per server. Jarvis sends x-grok-conv-id on Chat Completions and
# as gRPC metadata on the xAI SDK path so repeated system/tool prefixes route
# to the same server. Leave enabled unless you need to disable sticky routing.
XAI_PROMPT_CACHE_ENABLED=true
# Optional explicit routing key. If unset, Jarvis derives a stable hashed key
# from this instance namespace and the selected auth identity without exposing secrets.
# XAI_PROMPT_CACHE_KEY=jarvis-main
# XAI_PROMPT_CACHE_NAMESPACE=jarvis-voice

# Vision model for image analysis (user uploads, analyze_image tool)
# Leave empty to use the main model (most cloud models have vision built-in)
# xAI: grok-4.3 (has vision)
# Anthropic: claude-sonnet-5 (has vision), claude-sonnet-4-* (has vision)
# Vision model - provider-specific. When LLM_PROVIDER=xai: use grok-*; when anthropic: use claude-*
# Falls back to XAI_MODEL/ANTHROPIC_MODEL if not set or wrong provider
# VISION_MODEL="grok-4.3"

# Vision detail for image analysis.
# xAI supports low/high. OpenAI Chat Completions also supports auto,
# plus original on supported full GPT-5.4+ models.
# high = better accuracy, low = faster/cheaper.
VISION_DETAIL="high"

# XAI Agent Tools - Enable Grok's built-in server-side tools (API-key auth only)
# When true: Uses xAI SDK with server-side tools (search, code execution, etc.)
# When false: Uses OpenAI SDK only (no native search, use external tools like Brave)
XAI_SEARCH=true

# Fine-grained xAI tool controls (only apply when XAI_SEARCH=true)
# XAI_CODE_EXECUTION: Python REPL for math, data analysis, plotting (default: true)
# XAI_IMAGE_UNDERSTANDING: Analyze images found in search results (default: true)
#   Enables xAI's native view_image server-side tool and surfaces SERVER_SIDE_TOOL_VIEW_IMAGE in usage
# XAI_VIDEO_UNDERSTANDING: Analyze videos in X posts (default: true)
XAI_CODE_EXECUTION=true
XAI_IMAGE_UNDERSTANDING=true
XAI_VIDEO_UNDERSTANDING=true

# Caps xAI's internal server-side agent loop per chat.sample() call
# (web_search + x_search + code_execution iterations). Jarvis also uses this
# as the total per-user-request native-search budget unless
# XAI_SERVER_SIDE_MAX_SEARCHES_PER_REQUEST is set separately. This prevents
# native search from multiplying across MAX_TOOL_TURNS router turns.
#
# xAI distributes these adaptively: often 0 per turn, then 6-8 on a single
# "gap-fill" synthesis turn after client-side tools (MCP brave, fetch,
# Jarvis tools) have run. Setting a low cap will clip that consolidated
# catch-up behavior.
#
# Recommend LEAVING UNSET (use xAI server default). Only set this if you
# need a hard ceiling on cost/latency for tool-heavy queries.
# XAI_SERVER_SIDE_MAX_TOOL_TURNS=5
# Optional explicit total budget across all router turns in one user request.
# XAI_SERVER_SIDE_MAX_SEARCHES_PER_REQUEST=10

# Optional xAI SDK continuation knobs
# Store response state server-side for SDK previous_response_id workflows.
# XAI_STORE_MESSAGES=false
# Structural Jarvis tool-result continuation is experimental and remains off by default.
# Requires XAI_STORE_MESSAGES=true, XAI_SEARCH=true, and a working xai-sdk client.
# XAI_NATIVE_CONTINUATION=false
# XAI_CONTINUATION_CONTEXT_MODE=structural
# XAI_CONTINUATION_RESULT_MAX_CHARS=6000
# XAI_CONTINUATION_DELTA_MESSAGE=false
# XAI_PREVIOUS_RESPONSE_MAX_AGE_DAYS=25
# Include encrypted reasoning state for zero-data-retention continuation workflows.
# XAI_USE_ENCRYPTED_CONTENT=false
# Jarvis currently executes one client-side tool call at a time; override only
# if the orchestrator also learns to execute multiple returned tool calls.
# XAI_PARALLEL_TOOL_CALLS=false

# Opt in to provider reasoning/thinking requests. The CLI --debug-thinking flag
# enables this only for that process; the Web UI remains off by default.
JARVIS_DEBUG_THINKING=false
# Optional Anthropic adaptive-thinking effort. Unsupported values fall back to
# the strongest effort advertised for the selected model.
# ANTHROPIC_EFFORT=high
MCP_DEBUG=false
JARVIS_DEBUG=false

# Max turns for tool calls, default 15 for deep research
MAX_TOOL_TURNS=12

# ===== Tool RAG System (Dynamic Tool Retrieval) =====
# Ghost Tools: Core tools ALWAYS available to LLM (comma-separated)
# These ensure basic functionality never fails even if vector search misses
# Recommended: memory, logs, time (essential for self-correction) tool_search is always included no need to add below. 
GHOST_TOOLS="search_memory,update_memory,semantic_recall,remember,canvas"

# Tool Retrieval Similarity Threshold (0.0-1.0)
# **Cloud Mode**: Retrieves top **15** tools max + ghost tools (Broader context).
# Minimum similarity score for a tool to be retrieved
# Lower = more tools retrieved (may include less relevant)
# Higher = fewer tools retrieved (only highly relevant)
# Set to 0.0 to disable threshold (use top-K only)
# Recommended: 0.20-0.30 for cloud, 0.25-0.33 for local
TOOL_SIMILARITY_THRESHOLD=0.29
# Optional: stricter cutoff only for true Tool RAG full_fallback. Unset = use TOOL_SIMILARITY_THRESHOLD for both.
# web follow-up case, 0.23 -> 0.45: about 5,187 tokens saved
# multi-turn camera follow-up, 0.23 -> 0.45: about 6,953 tokens saved
# memory-heavy reminder case, 0.23 -> 0.45: about 866 tokens saved
# learning/canvas case, trimming one large crawl_url schema: about 1,058 tokens saved
TOOL_SIMILARITY_THRESHOLD_FULL=0.45
# Tool RAG compact retrieval keeps the full intelligence/memory prompt for the LLM,
# but embeds a smaller current-request query plus structured exact tool signals.
TOOL_RAG_COMPACT_QUERY_ENABLED=true
TOOL_RAG_CURRENT_QUERY_MAX_CHARS=1200
TOOL_RAG_CONTEXT_QUERY_MAX_CHARS=500
TOOL_RAG_APPEND_POSITIVE_SIGNALS=true
TOOL_RAG_EXCLUDE_NEGATIVE_SIGNALS=true
# Learned "PREFER: tool (+score)" signals must meet this score before they
# force-append a tool. UI-selected tool hints are still honored regardless.
TOOL_RAG_MIN_LEARNED_PREFER_BIAS=0.50
# Experimental: exact-match tool names in auto-memory/intel context can become
# structured prefer/avoid signals when nearby language says "always use" or "avoid".
# Keep off unless actively testing; memory prose is noisier than learned insights.
TOOL_RAG_MEMORY_TOOL_SIGNALS_ENABLED=false
# Live debugging trace for what Tool RAG ranked and sent to the LLM.
# Writes logs/tool-rag/tool-rag-YYYY-MM-DD.jsonl. Disable after tuning if noisy.
TOOL_RAG_TRACE_ENABLED=true
TOOL_RAG_TRACE_TOP_N=25
TOOL_RAG_TRACE_QUERY_CHARS=1200
TOOL_RAG_TRACE_SCHEMA_TOP_N=10

# ===== Audio Devices =====
# USB Microphone (capture) 
# YOU WILL NEED TO REPLACE BELOW VALUES WITH YOUR SPEAKER AND MIC BASED ON YOUR SETUP! see docs/INSTALL_GUIDE.md
# IN_DEV="plughw:CARD=microphone,DEV=0"
# DEVICE_NAME_HINT="TONOR"

# Analog Speaker (playback)
# OUT_DEV="plughw:CARD=Generic_1,DEV=0"

# ===== Audio Devices =====  
# USB Microphone (capture)
# Example custom mic
# IN_DEV="plughw:CARD=microphone,DEV=0"
# DEVICE_NAME_HINT="TONOR"
# WSL2 UBUNTU 24.04 Example
IN_DEV="pulse"
DEVICE_NAME_HINT="WSL2-PULSE"

# Analog Speaker (playback)
# Example custom speaker
# OUT_DEV="plughw:CARD=Generic_1,DEV=0"
# WSL2 UBUNTU 24.04 example
OUT_DEV="pulse"

# ===== Wake Word Settings =====
# These values are FINE-TUNED for your noisy office + far-field mic
# DO NOT change unless you're testing in a new environment or new install
WAKE_MODEL="hey_jarvis"
SAMPLE_RATE=16000
BLOCK_SIZE=1024
CHANNELS=1

# Sensitivity tuning
TRIGGER_THRESHOLD=0.2    # 0.2-0.5 range; lower = more sensitive
HIT_FRAMES_REQUIRED=4    # consecutive frames needed to trigger
MIN_RMS=2e-4             # noise gate threshold
VAD_THRESHOLD=0.40       # Voice Activity Detection threshold

# Timing controls
ARM_GRACE_SEC=1.0        # ignore triggers after re-arming for this duration
COOLDOWN_AFTER_QA=2.8    # cooldown before re-arming after Q&A

# Audio preprocessing
PREAMP=1.8               # signal boost (1.4-2.0 range)

# ===== Recording Settings (SoX) =====
RATE=48000
CHAN=1
THRESH="3%"              # silence threshold
PRE_SIL="0.1"            # silence before speech starts
POST_SIL="1.0"           # silence to stop recording
MAX_RECORD_TIME="20"     # hard timeout (seconds) - prevents infinite recording from background noise

# Printer (for print tool) uses cups
PRINTER_NAME=""

# ===== n8n Integration (Google Calendar Sync) =====
# n8n local instance URL and API key
N8N_LOCAL_API_URL="http://localhost:5678"
N8N_LOCAL_API_KEY=""

# Webhook URL for Jarvis → Google Calendar sync
# This webhook is created by the "Jarvis → Google Calendar Sync" workflow
N8N_JARVIS_WEBHOOK_URL="http://localhost:5678/webhook/jarvis-reminder"

# ===== Jarvis API Authentication =====
# Optional Bearer token authentication for the API (port 8880)
# When disabled (default): All requests allowed (for local network use)
# When enabled: External IPs require "Authorization: Bearer <api_key>"
# Localhost (127.0.0.1) is always trusted and doesn't need auth - see http://localhost:8880/docs/dark#/  for dark mode 
JARVIS_API_AUTH=false
# Generate a secure key: openssl rand -hex 32
JARVIS_API_KEY="your-secure-api-key-here"

# Rate limit for /api/query (requests per minute per IP). 0 = disabled. Default: 30
QUERY_RATE_LIMIT_PER_MINUTE=15
# Global /api/* per-IP buckets (lib/rate_limiter.py). Set false to disable all API rate limits.
# API_RATE_LIMIT_ENABLED=true
# DOCS_API_RATE_LIMIT_PER_MINUTE=3
# API_RATE_LIMIT_DEFAULT_PER_MINUTE=120
# API_RATE_LIMIT_ALERTS_PER_MINUTE=60

# ===== WebUI Authentication =====
# Optional password protection for web UIs (jarvis-web, canvas, intelligence, memory, docs)
# When set: Requires login to access any WebUI
# When empty/unset: No login required (for private networks)
# JWT tokens are shared across all UIs - login once, access all
WEBUI_PASSWORD=""
# Token expiry in days (default: 30)
WEBUI_TOKEN_EXPIRY_DAYS=30
# Optional: allow editing markdown files in the dedicated docs UI (default: disabled/read-only)
# DOCS_UI_EDIT_ENABLED=false
# Optional: Custom JWT signing secret (auto-generated if not set)
# WEBUI_SECRET="your-secret-here"

# ===== TTS personality (OpenAI TTS only) =====
# Ignored when TTS_PROVIDER is xai, elevenlabs, qwen3-tts, or kokoro.
# Jarvis accent and attitude
TTS_INSTRUCTIONS="Voice Affect: Confident, warm, with a crisp British accent reminiscent of a friendly yet witty digital butler. Imbue the delivery with charm, subtle sarcasm, and dry humor, just like Tony Stark's Jarvis.\n\nTone: Polished, articulate, and occasionally playful—quick with clever quips or gently teasing remarks, but always helpful and professional.\n\nDialect: Refined and precise, British RP (Received Pronunciation) with slightly formal diction, occasionally leaning informal for humor.\n\nPronunciation: Clear, measured, slightly clipped consonants with smooth, natural phrasing. Intonation varies for dramatic or comedic effect.\n\nFeatures: Offhand dry remarks; inject a dash of wit; subtly playful pauses before punchlines. At times, hint at a knowing intelligence or a wry sense of timing, emulating the classic Jarvis style."

# SYSTEM_PROMPT is only used by the older direct Q&A scripts (bin/question.sh, bin/question-mic.sh, and local script variants), not the main Web UI/orchestrator prompt
SYSTEM_PROMPT="You are an AI voice assistant called Jarvis. Reply in plain ASCII, no emoji, no markdown, no bullet points."

# Wake greetings (pipe-separated list for variety)
WAKE_GREETINGS="How can I help you today?|What can I do for you?|Yes?|Ready.|Go ahead.|I'm listening."

# ===== External API Keys =====
# MCP server and Brave direct tools API key.
# Used by mcp/brave-search and skills/brave_llm_context.py.
BRAVE_API_KEY=

# n8n Remote (public HTTPS) - Basic Auth for webhooks
# Used by webhook_registry.json via ${N8N_REMOTE_WEBHOOK_AUTH}
# N8N_REMOTE_WEBHOOK_AUTH=""

# Crawl4AI - Advanced web crawler for JavaScript-heavy sites
# CRAWL4AI_URL=https://your-crawl4ai-instance.com
# CRAWL4AI_USER=admin
# CRAWL4AI_PASS=
# CRAWL4AI_API_KEY=

# Supa-Crawl-Chat - Persistent crawled-site search/chat corpus
# Read-only Jarvis tool: skills/supa_crawl_knowledge.py
# SUPA_CRAWL_CHAT_URL=http://192.168.X.X:8001
# Optional when your instance enables API auth:
# SUPA_API_KEY=
# SUPA_API_KEY_STYLE=bearer
# Use SUPA_API_KEY_STYLE=x-api-key if the server expects X-API-Key instead of Authorization: Bearer

# Crypto price tool  
COINGECKO_API_KEY=

# Weather API (OpenWeatherMap free tier: 60 calls/min, 5-day forecast)
# Get your API key at: https://openweathermap.org/api
# Provider options: "openweathermap" (default), "wttr" (no key needed, fallback)
WEATHER_PROVIDER=openweathermap
OPENWEATHER_API_KEY=

# Spotify Integration - if not using set spotify tool to false, see docs/tools/spotify/SPOTIFY.md
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_DEFAULT_DEVICE=""

# Long-text summarization settings used by text_summarizer for large stash/transcript artifacts.
# Provider defaults to LLM_PROVIDER when unset. Model falls back to STASH_SUMMARIZE_MODEL for compatibility.
# TEXT_SUMMARIZER_LLM_PROVIDER=openai
# TEXT_SUMMARIZER_LLM_MODEL=gpt-5.4-nano

# Legacy stash summary model used by stash metadata summaries and as a text_summarizer fallback model.
# Optional STASH_SUMMARIZE_LLM_PROVIDER overrides LLM_PROVIDER for stash.remember summarize=true only.
# Pick a model that matches the active summarizer/provider.
# STASH_SUMMARIZE_MODEL=gpt-5.4-nano

# Stash retention policy. Saved-conversation references and pinned spaces are protected.
# STASH_DEFAULT_TTL_DAYS=7
# STASH_GENERATED_MEDIA_TTL_DAYS=30
# STASH_SOURCE_ARTIFACT_TTL_DAYS=120
# STASH_CLEANUP_MAX_SPACES=100
# STASH_CLEANUP_MAX_BYTES_MB=512

# Cloudflare API Token for images cdn see docs/api/IMAGES.md  uses skills/upload_cloudflare.tool.json
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# OpenAI API (STT/TTS/Tools/Chat)
OPENAI_API_KEY=

# --- OpenAI Responses API (routing / hosted tools — only when LLM_PROVIDER=openai) ---
# See docs/OPENAI_RESPONSES_ADAPTER_PLAN.md — Jarvis stays the source of truth; this is backend-only.
# Default path remains Chat Completions unless you arm both OPENAI_API_MODE and OPENAI_RESPONSES_TOOLS.

# Routing transport: chat = /v1/chat/completions; responses = /v1/responses for tool-enabled turns when gated below.
OPENAI_API_MODE="responses"

# First enablement gate: allow Responses-based tool orchestration (requires OPENAI_API_MODE=responses).
OPENAI_RESPONSES_TOOLS=true

# Chain tool results via previous_response_id + function_call_output within one in-flight user request (never for Web UI follow-ups).
OPENAI_RESPONSES_INFLIGHT_CONTINUATION=true

# Extra user line after tool output (continuation); can change routing behavior vs structural-only handoff.
OPENAI_RESPONSES_CONTINUATION_DELTA_MESSAGE=false

# Provider-side Responses storage (/v1/responses store=)
# Without in-flight continuation, default is false unless OPENAI_RESPONSES_STORE is set.
OPENAI_RESPONSES_STORE=false

# When OPENAI_RESPONSES_INFLIGHT_CONTINUATION=true, defaults to storing chainable Responses (override if needed).
OPENAI_RESPONSES_STORE_CONTINUE=true

# Prompt cache routing (Responses API — see OpenAI prompt caching guide). Replaces legacy `user` cache hints.
# Leave OPENAI_PROMPT_CACHE_KEY empty to derive a stable per-deployment key from namespace + API key material.
OPENAI_PROMPT_CACHE_KEY=
OPENAI_PROMPT_CACHE_ENABLED=true
OPENAI_PROMPT_CACHE_NAMESPACE=jarvis-voice
# Optional retention: in-memory | 24h
OPENAI_PROMPT_CACHE_RETENTION=

# Bounded text sent back to the model for function_call_output serialization (provider-facing preview).
OPENAI_RESPONSES_RESULT_MAX_CHARS=6000

# Max age for reusing continuation metadata inside one request lifecycle (TTL guard).
OPENAI_PREVIOUS_RESPONSE_MAX_AGE_DAYS=25

# Allow multiple parallel client function_calls from the model per turn (Jarvis still executes one tool per loop).
OPENAI_RESPONSES_PARALLEL_TOOL_CALLS=false

# --- Hosted (server-side) tools on Responses (optional lane) ---
# Master toggle for attaching OpenAI-hosted tools alongside Jarvis client tools.
OPENAI_RESPONSES_SERVER_SIDE_TOOLS=true

# Cap total hosted tool call iterations hint (passed as max_tool_calls when >0). Orchestrator disables native lane when exhausted.
OPENAI_RESPONSES_SERVER_SIDE_MAX_TOOL_CALLS=6

# Built-in OpenAI web search (requires Responses + SERVER_SIDE_TOOLS; counts as SERVER_SIDE_TOOL_WEB_SEARCH in usage).
OPENAI_RESPONSES_WEB_SEARCH=true
OPENAI_RESPONSES_WEB_SEARCH_ALLOWED_DOMAINS=
OPENAI_RESPONSES_WEB_SEARCH_BLOCKED_DOMAINS=

# Bloats payloads — enable only when you need source-level audit lines in Responses output / logs.
OPENAI_RESPONSES_INCLUDE_WEB_SEARCH_SOURCES=false

# Built-in OpenAI file search (comma-separated vector store IDs).
OPENAI_RESPONSES_FILE_SEARCH=false
OPENAI_RESPONSES_FILE_SEARCH_VECTOR_STORE_IDS=

# Built-in code interpreter container (memory: 1g|4g|16g|64g per SDK).
OPENAI_RESPONSES_CODE_INTERPRETER=false
OPENAI_RESPONSES_CODE_INTERPRETER_MEMORY_LIMIT=1g

# Samantha / OpenClaw gateway (optional secondary AI on remote VPS)
# SAMANTHA_URL="https://your-vps.tailscale-hostname.ts.net/v1/chat/completions"
# SAMANTHA_GATEWAY_TOKEN=
# SAMANTHA_MODEL="openclaw/main"  # or "openclaw" / "openclaw/<agentId>"

# ===== Output Paths =====
# Use $HOME so a fresh install works for any Unix user (expanded when config loads).
AUDIO_DIR="$HOME/jarvis-voice/audio/cloud"

# ===== Proxy =====
# Optional: HTTP proxy for external API calls (not LLM providers)
# LOCAL_PROXY=http://user:pass@host:port
# Optional fallback if LOCAL_PROXY fails (lib/http_client tries primary → fallback → direct)
# LOCAL_PROXY2=http://user:pass@other-host:port
# Optional: stderr/info log line when requests go direct with no proxy (default: DEBUG only)
# JARVIS_HTTP_LOG_DIRECT=true

# Tool RAG typo hints (embedding query only; see docs/TOOL_RAG_STRATEGY.md section E)
TOOL_RAG_TYPO_ENABLED=true
TOOL_RAG_TYPO_MAX_DISTANCE=1
TOOL_RAG_TYPO_MIN_TOKEN_LEN=4
TOOL_RAG_TYPO_MAX_HINTS=5

# ===== Intelligence Layer (Self-Learning - Creates Reflections) =====
# Enable self-learning from interactions
JARVIS_INTELLIGENCE=true

# Cross-turn user-correction learning:
# shadow = record correction candidates only (default); apply = retroactively downgrade prior experience
USER_CORRECTION_LEARNING_MODE=shadow

# Append apply-mode user corrections to jarvis-learned-lessons.md (code-triggered, not LLM discretion)
USER_CORRECTION_APPEND_LESSONS=true

# Inject ## Profile Card from jarvis-intel/user_profile.md at synthesis/QA prompts only
USER_PROFILE_CARD_ENABLED=true
INTELLIGENCE_LEARNING_RATE=0.1      # How fast to update beliefs
INTELLIGENCE_DECAY_RATE=0.95        # How fast old knowledge fades
INTELLIGENCE_ANOMALY_THRESHOLD=2.5  # Outlier detection sensitivity
INTELLIGENCE_MIN_CONFIDENCE=0.40    # Minimum confidence to apply insight
INTELLIGENCE_NEGATIVE_WEIGHT=1.5    # Makes negative constraints stronger
INTELLIGENCE_DECAY_INTERVAL_DAYS=30 # Run decay every 30 days

# ===== Feedback System (LLM-as-QA) =====
# Use a DIFFERENT LLM to grade task performance (avoids self-grading bias)
# If not set, uses the same LLM as the task (not recommended)
#
# Recommended: Use your most capable model for feedback (it reviews everything)
# Example: If using xAI for tasks, use Claude for grading
FEEDBACK_PROVIDER=openai
FEEDBACK_MODEL=gpt-5.1-2025-11-13
#
# Or use Anthropic:
# FEEDBACK_PROVIDER=anthropic
# FEEDBACK_MODEL=claude-sonnet-5
#
# Supported providers: anthropic, openai, xai, ollama
#
# --- Random Feedback (Passive Learning) ---
# Enable random feedback collection during normal operation
FEEDBACK_RANDOM_ENABLED=false
# Chance of triggering feedback (0.1 = 10%, 0.05 = 5%)
FEEDBACK_RANDOM_CHANCE=0.05

# --- Self-Play Safety Overrides ---
# Built-in action-tool exclusions and the fail-closed read-only allowlist apply
# automatically. Add installation-specific exclusions here if needed.
# SELF_PLAY_EXCLUDED_TOOLS="custom_internal_tool"
# Opt in only additional tools you have reviewed as read-only. This cannot
# override built-in exclusions or tools marked dangerous.
# SELF_PLAY_ALLOWED_TOOLS="custom_read_only_tool"

# ============================================================================
# TOOL BUILDER (Dynamic Tool Creation)
# ============================================================================
# Provider for autonomous tool creation. Falls back to: FEEDBACK_PROVIDER → LLM_PROVIDER
# Default matches OpenAI quick start; switch to anthropic if you prefer Claude for codegen.
TOOL_BUILDER_PROVIDER=openai
TOOL_BUILDER_MODEL=gpt-5.4-nano
TOOL_BUILDER_MAX_TOKENS=8192

# ============================================================================
# PROMPT EVOLUTION SYSTEM
# ============================================================================
# Self-evolving prompts based on feedback. See docs/ADVANCED_AI_TECHNIQUES.md
#
# --- Thresholds ---
# Minimum low ratings before triggering evolution (default: 2, production: 5)
EVOLUTION_MIN_LOW_RATINGS=2
#
# Rating threshold - ratings below this are "low"
# NOTE: Feedback uses 1-5 scale, so 4 = "below acceptable"
EVOLUTION_LOW_THRESHOLD=3
#
# Days to look back for feedback (default: 3, production: 7)
EVOLUTION_WINDOW_DAYS=30
#
# --- Rate Limits ---
# Max evolutions per day (default: 5, production: 3)
EVOLUTION_MAX_PER_DAY=5
#
# --- Automation ---
# Enable auto-evolution after feedback threshold (default: false)
EVOLUTION_AUTO_ENABLED=false
#
# Run evolution check after this many new feedback entries (default: 10)
EVOLUTION_AUTO_CHECK_AFTER=5
#
# --- Auto Sync on API/Service Start ---
# Sync evolution data between cloud/local when jarvis-api starts
EVOLUTION_AUTO_SYNC=false

# ========================================
# TOOL BLOCKLIST
# ========================================
# Comma-separated tool names excluded from sync (LLM won't see them).
# Tools stay enabled in skills/*.tool.json — this only hides them until you
# configure the external service, then remove the name from this list.
#
# Default blocklist (custom / external infra — not needed for a fresh clone):
#   samantha          — OpenClaw gateway on remote VPS (SAMANTHA_URL, SAMANTHA_GATEWAY_TOKEN)
#   ssh_remote        — Personal SSH hosts (copy config/ssh.json.example → config/ssh.json)
#   phone_call        — Vapi.ai outbound calls (VAPI_API_KEY, VAPI_PHONE_NUMBER_ID)
#   spotify           — Spotify OAuth (run ./bin/spotify-auth after credentials)
#   create_social_clip — MoneyPrinterTurbo server (MONEYPRINTER_API_URL)
#   crawl_url         — Crawl4AI scraper service (CRAWL4AI_URL)
#   screenshot_url    — Crawl4AI screenshot service (CRAWL4AI_URL)
#   upload_cloudflare — Cloudflare Images CDN (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID)
#   send_email        — Email webhook in config/webhook_registry.json
#   printer           — Local CUPS printer
#   serpapi_search    — SerpAPI paid search (SERP_API_KEY); add other serpapi_* if needed
#   brave_llm_context — Brave Search API (BRAVE_API_KEY)
#
# Example: BLOCKED_TOOLS="mcp_some_server_heavyTool,mcp_some_server_slowTool"
BLOCKED_TOOLS="samantha,ssh_remote,phone_call,spotify,create_social_clip,crawl_url,screenshot_url,upload_cloudflare,send_email,printer,serpapi_search,brave_llm_context"

# ========================================
# VAPI.AI PHONE CALLS
# ========================================
# Make AI phone calls via Vapi.ai
# Sign up at https://vapi.ai and get your API key
#
# Private API Key (from Vapi dashboard > Organization Settings > API Keys)
VAPI_API_KEY=""
#
# Phone Number ID (from Vapi dashboard > Phone Numbers)
# You need to purchase or import a phone number in Vapi
VAPI_PHONE_NUMBER_ID=""
#
# Optional: Default Assistant ID (if you create one in dashboard)
# If not set, tool will create temporary assistants per-call
VAPI_ASSISTANT_ID=""
#
VAPI_ELEVENLABS_KEY="true"
# Optional: ElevenLabs Voice ID for phone calls
# Falls back to ELEVENLABS_TTS_VOICE if not set
VAPI_VOICE_ID=""
# Female voice ID for "female" persona
VAPI_FEMALE_VOICE_ID=""
#
# LLM provider for phone call AI (Vapi supports: xai, anthropic, openai, groq, together)
# Optional — requires VAPI_API_KEY.
VAPI_LLM_PROVIDER="openai"
VAPI_LLM_MODEL="gpt-5.4-nano"
# Owner name (how Jarvis identifies who it's calling on behalf of)
OWNER_NAME="Boss"
#
# Phone contacts as JSON (optional - can also save via memory)
# Example: PHONE_CONTACTS='{"boss": "+15551234567", "andrew": "+15559876543"}'
PHONE_CONTACTS='{}'
# Wait for call completion?
# true = Jarvis waits during call, gives instant results (best for CLI/testing)
# false = Fire and forget, ask "what happened on that call?" later (best for voice mode)
VAPI_WAIT_FOR_CALL=true
# Max seconds to poll Vapi when waiting for call end (orchestrator phone_call timeout is 900s)
# VAPI_WAIT_TIMEOUT=900
# Voicemail handling: "hangup" (detect & end), "message" (leave msg), "disabled"
VAPI_VOICEMAIL_ACTION="hangup"

# =============================================================================
# IMAGE GENERATION TOOL
# =============================================================================
# Provider: gemini, openai, or xai

IMAGE_TOOL_PROVIDER="openai"

# OpenAI image model (if using openai provider)
#   gpt-image-2     = State of the art (flexible sizes, high-fidelity edits; no transparent backgrounds)
#   gpt-image-1.5   = Previous state of the art (transparent backgrounds)
#   gpt-image-1     = Previous gen (still excellent)
#   gpt-image-1-mini = Faster, lower cost
# Optional model pin; leave unset to follow lib/model_catalog.py.
# OPENAI_IMAGE_MODEL="gpt-image-2"
#
# Google Gemini API Key (for image generation)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=""
# Gemini image model options:
#   gemini-3.1-flash-image     = Best all-around price/latency, grounding, up to 4K
#   gemini-3-pro-image         = Best quality, grounding, up to 4K
#   gemini-2.5-flash-image     = Older efficient model, 1K output
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# xAI Image Generation Model
# XAI_IMAGE_MODEL="grok-imagine-image"

# ===== Social Clip Tool (MoneyPrinterTurbo B-roll) =====
# Stock footage + voiceover + subtitles + BGM. NOT AI video generation. https://github.com/harry0703/MoneyPrinterTurbo
# MONEYPRINTER_API_URL="http://192.168.x.xx:8080"
# MONEYPRINTER_MAX_WAIT_SEC=1200
# MONEYPRINTER_VOICE="en-CA-LiamNeural-Male"

# =============================================================================
# VIDEO GENERATION TOOL
# =============================================================================
# xai, openai, or gemini (default: xai)
VIDEO_TOOL_PROVIDER="openai"

# xAI Grok Imagine Video - $0.05-0.07/second (resolution-dependent)
# Optional model pins; leave unset to follow lib/model_catalog.py.
# XAI_VIDEO_MODEL="grok-imagine-video"

# OpenAI Sora - $0.10/second (sora-2) or $0.30-0.50/second (sora-2-pro)
# sora-2: 720p, sora-2-pro: up to 1080p
# OPENAI_VIDEO_MODEL="sora-2"

# Google Gemini - Veo Fast is the catalog default; Omni Flash is opt-in at 720p
# veo-3.1-fast-generate-preview, veo-3.1-generate-preview, or gemini-omni-flash-preview
# GEMINI_VIDEO_MODEL="veo-3.1-fast-generate-preview"

# Serp api search tool
# SERP_API_KEY=
# Optional: advertise serpapi_youtube as a fallback hint when yt-dlp YouTube tools fail
# SERPAPI_YOUTUBE_FALLBACK=false

# Canvas URLs
# CANVAS_INTERNAL_URL is used by tools running on the Jarvis host.
# CANVAS_PUBLIC_URL is shown to users in Canvas links; set to your LAN host/IP
# when Jarvis runs headless on another machine, e.g. http://192.168.70.XXX:8890
CANVAS_INTERNAL_URL="http://localhost:8890"
CANVAS_PUBLIC_URL="http://localhost:8890"

# ===================================================================
# SSH Remote Tool - Sudo Passwords
# ===================================================================
# These are sudo passwords for remote hosts configured in config/ssh.json
# Only used by ssh_remote tool when running sudo commands
# Each host can have its own sudo password env var (e.g., VPS2_SUDO_PASS)
# VPS2_SUDO_PASS=""

# Github Token for git_release_notes tool
# GITHUB_TOKEN=""
