# Jarvis Voice Assistant - Cloud Configuration (EXAMPLE)
# Copy this file to cloud.env and fill in your actual API keys
# WARNING: Never commit cloud.env with real API keys!

# ===== OpenCode Integration =====
# Enable/disable OpenCode autonomous agent integration
# When enabled, Jarvis can use OpenCode for complex multi-step tasks
# OpenCode server must be running (systemd service or manual)
OPENCODE_ENABLED=true
OPENCODE_BASE_URL="http://localhost:4096"
# claude-sonnet-4-20250514 ,  claude-3-7-sonnet-20250219 , claude-sonnet-4-5-20250929
OPENCODE_MODEL="claude-sonnet-4-20250514"
# openai ,  anthropic 
OPENCODE_PROVIDER="anthropic"

# ===== LLM Provider for Tool Calling and Chat for JARVIS =====
# Options: "anthropic", "openai", "xai"
LLM_PROVIDER="anthropic"

# ===== Memory System =====
# Semantic search similarity threshold (0.0-1.0)
# Lower = more results (may include loosely related memories)
# Higher = fewer results (only close matches)
# Recommended: 0.28-0.40 range
# Default: 0.30 (balanced - catches paraphrased queries)
SEMANTIC_SIMILARITY_THRESHOLD=0.30

# ===== Tool RAG System (Dynamic Tool Retrieval) =====
# Ghost Tools: Core tools ALWAYS available to LLM (comma-separated)
# These ensure basic functionality never fails even if vector search misses
# Recommended: memory, logs, time (essential for self-correction)
GHOST_TOOLS="search_memory,semantic_recall,remember,check_tool_logs,get_recent_conversations,get_time,send_email,send_webhook"

# Tool Retrieval Similarity Threshold (0.0-1.0)
# Minimum similarity score for a tool to be retrieved
# Lower = more tools retrieved (may include less relevant)
# Higher = fewer tools retrieved (only highly relevant)
# Set to 0.0 to disable threshold (use top-K only)
# Recommended: 0.15-0.25 for cloud, 0.20-0.30 for local
TOOL_SIMILARITY_THRESHOLD=0.15

# Auto-Context (Short-Term Conversation Memory)
# Automatically inject recent conversation history into each request
# Enables natural follow-up responses and self-learning from failures
AUTO_CONTEXT_ENABLED=true

# Number of recent conversations to include (2-5 recommended)
AUTO_CONTEXT_WINDOW=3

# Time window in minutes (only include conversations within this time)
# Recommended: 5-15 minutes (voice conversations are typically bursty)
AUTO_CONTEXT_MINUTES=10

# Anthropic Claude API (preferred for tool calling)
# claude-sonnet-4-20250514 ,  claude-3-7-sonnet-20250219 , claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# Anthropic Web Search - Enable Claude's built-in web search tool
# When true: Claude can search the web for real-time info (server-side)
# When false: Uses external tools (Brave Search) - current default
# Cost: Standard token pricing (search results count as input tokens)
ANTHROPIC_SEARCH=false

# ===== Response Style =====
# How Jarvis formats tool results for voice output
# Options: "casual", "detailed", "auto"
#   casual: Always format for voice (8-12 words, no explanations) - BEST FOR VOICE
#   detailed: Raw LLM output with full context - BEST FOR CLI/DEBUGGING
#   auto: Smart adaptive mode:
#     - Search tools (duckduckgo, search_memory) → Format for voice (remove URLs)
#     - Simple tools (get_time, crypto_price) → Keep concise
#     - Complex tools (opencode) → Detailed if >50 words, condensed if shorter
#     - Multi-turn → Always format summary
JARVIS_RESPONSE_STYLE="auto"

# Jarvis timezone for date/time awareness in system prompt
# Uses IANA timezone names (e.g., America/Los_Angeles, America/New_York, Europe/London)
JARVIS_TIMEZONE="America/Los_Angeles"

# Enable thinking mode
# JARVIS_DEBUG_THINKING=true

# JARVIS_DEBUG=false

# OpenAI API (for STT/TTS and fallback)
OPENAI_API_KEY=""

# OpenAI Models
# gpt-5.1 , gpt-4o , gpt-4.1 , gpt-5.1-codex-mini , gpt-5.1-codex , gpt-5-mini , gpt-5-codex , gpt-5.1-chat-latest
OPENAI_MODEL="gpt-5.1-chat-latest"

TTS_MODEL="gpt-4o-mini-tts"
STT_MODEL="gpt-4o-mini-transcribe"

# xAI (Grok) API - OpenAI-compatible with reasoning support
# Supports function calling, structured outputs, and reasoning mode
# Models: grok-4-fast, grok-4-1-fast-non-reasoning-latest, grok-4-fast-reasoning-latest
XAI_API_KEY=""
XAI_MODEL="grok-4-1-fast-non-reasoning-latest"

# xAI Live Search - Enable Grok's built-in real-time web/X search
# When true: Grok searches web/X internally (mode=auto) and returns grounded answers
# When false: Uses external tools (Brave Search) - current default behavior
# Cost: ~$5/1K search-enabled calls (auto mode only searches when relevant)
# Benefits: Cleaner context, better synthesis, real-time data, X post integration
XAI_SEARCH=false

# ===== Audio Devices =====
# USB Microphone (capture)
IN_DEV="plughw:CARD=microphone,DEV=0"
DEVICE_NAME_HINT="TONOR"

# Analog Speaker (playback)
OUT_DEV="plughw:CARD=Generic_1,DEV=0"

# ===== Wake Word Settings =====
# These values are FINE-TUNED for your noisy office + far-field mic
# DO NOT change unless you're testing in a new environment
WAKE_MODEL="hey_jarvis"
SAMPLE_RATE=16000
BLOCK_SIZE=1024
CHANNELS=1

# Sensitivity tuning
TRIGGER_THRESHOLD=0.2    # 0.2-0.5 range; lower = more sensitive
HIT_FRAMES_REQUIRED=4    # consecutive frames needed to trigger
MIN_RMS=2e-4             # noise gate threshold
VAD_THRESHOLD=0.40       # Voice Activity Detection threshold

# Timing controls
ARM_GRACE_SEC=1.0        # ignore triggers after re-arming for this duration
COOLDOWN_AFTER_QA=2.8    # cooldown before re-arming after Q&A

# Audio preprocessing
PREAMP=1.8               # signal boost (1.4-2.0 range)

# ===== Recording Settings (SoX) =====
RATE=48000
CHAN=1
THRESH="3%"              # silence threshold
PRE_SIL="0.1"            # silence before speech starts
POST_SIL="1.2"           # silence to stop recording
MAX_RECORD_TIME="30"     # hard timeout (seconds) - prevents infinite recording from background noise

# ===== TTS Settings =====
# TTS Provider: "openai" or "elevenlabs"
TTS_PROVIDER="openai"

# ----- OpenAI TTS -----
VOICE="onyx"            # alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse

# TTS Voice Instructions (OpenAI only)
TTS_INSTRUCTIONS="Voice: Confident, warm, with a crisp British accent reminiscent of a friendly yet witty digital butler. Imbue the delivery with charm, subtle sarcasm, and dry humor, just like Tony Stark's Jarvis.\n\nTone: Polished, articulate, and occasionally playful—quick with clever quips or gently teasing remarks, but always helpful and professional.\n\nDialect: Refined and precise, British RP (Received Pronunciation) with slightly formal diction, occasionally leaning informal for humor.\n\nPronunciation: Clear, measured, slightly clipped consonants with smooth, natural phrasing. Intonation varies for dramatic or comediate effect.\n\nFeatures: Offhand dry remarks; inject a dash of wit; subtly playful pauses before punchlines. At times, hint at a knowing intelligence or a wry sense of timing, emulating the classic \"Jarvis\" style."

# ----- ElevenLabs TTS -----
# Get API key from: https://elevenlabs.io/app/settings/api-keys
# Get voice IDs from: https://elevenlabs.io/app/voice-library or config/elevenlabs_voices.json
ELEVENLABS_API_KEY=""
ELEVENLABS_TTS_MODEL="eleven_multilingual_v2"   # or eleven_monolingual_v1, eleven_turbo_v2
ELEVENLABS_TTS_VOICE="pgCnBQgKPGkIP8fJuita"     # "Jarvis - Calm and soothing" from voices list

# System prompt for chat
SYSTEM_PROMPT="You are an AI voice assistant called Jarvis. Reply in plain ASCII, no emoji, no markdown, no bullet points. Keep your tone professional, playful, and a little chilling. At most six sentences (<= 100 words total)."

# Wake greeting
# Wake word greetings (pipe-separated list for variety)
WAKE_GREETINGS="How can I help you today?|What can I do for you?|Yes?|Ready.|Go ahead.|I'm listening."

# ===== n8n Integration (Google Calendar Sync) =====
# n8n local instance URL and API key
N8N_LOCAL_API_URL="http://192.168.70.226:5678"
N8N_LOCAL_API_KEY=""
# Webhook URL for Jarvis → Google Calendar sync
# This webhook is created by the "Jarvis → Google Calendar Sync" workflow
N8N_JARVIS_WEBHOOK_URL="http://192.168.70.226:5678/webhook/jarvis-reminder"

# ===== Output Paths =====
AUDIO_DIR="/home/boss/jarvis-voice/audio/cloud"

# ===== External API Keys =====
# COINGECKO_API_KEY=
# BRAVE_API_KEY=
# BLINKO_API_KEY=

# Weather API (OpenWeatherMap free tier: 60 calls/min, 5-day forecast)
# Get your API key at: https://openweathermap.org/api
# Provider options: "openweathermap" (default), "wttr" (no key needed, fallback)
# WEATHER_PROVIDER=openweathermap
# OPENWEATHER_API_KEY=

# ===== Status Updates (Voice Progress Feedback) =====
# Enable voice status updates during long-running tasks
STATUS_UPDATES_ENABLED=true
STATUS_UPDATE_INTERVAL=20
# Phrase mode: 'normal' (professional) or 'unhinged' (chaotic/funny)
STATUS_PHRASE_MODE=normal
STATUS_HUMOR_ENABLED=true
STATUS_ENCOURAGEMENT_ENABLED=true
# Sass level: 0=professional, 1=friendly with sass hint, 2=confidently sassy
STATUS_SASS_LEVEL=1

# Silence padding before status audio (ms) - helps speakers "wake up"
# Increase if first words are cut off (Bluetooth/wireless speakers need more)
STATUS_SILENCE_PAD_MS=250

# Status LLM (dynamic summaries from tool output)
STATUS_LLM_ENABLED=true
STATUS_LLM_PROVIDER=openai
STATUS_LLM_MODEL=gpt-4o-mini
STATUS_LLM_MAX_TOKENS=30

# ===== Intelligence Layer (Self-Learning) =====
# Enable self-learning from interactions (default: true)
JARVIS_INTELLIGENCE=true

# Learning parameters (advanced, optional)
INTELLIGENCE_LEARNING_RATE=0.1      # How fast to update beliefs
INTELLIGENCE_DECAY_RATE=0.95        # How fast old knowledge fades
INTELLIGENCE_ANOMALY_THRESHOLD=2.5  # Outlier detection sensitivity
INTELLIGENCE_MIN_CONFIDENCE=0.40    # Minimum confidence to apply insight
INTELLIGENCE_NEGATIVE_WEIGHT=1.5

# Optional: HTTP proxy for external API calls (not LLM providers)
# LOCAL_PROXY=http://user:pass@host:port

# ===== Feedback System (LLM-as-QA) =====
# Use a DIFFERENT LLM to grade task performance (avoids self-grading bias)
# If not set, uses the same LLM as the task (not recommended)
#
# Recommended: Use your most capable model for feedback (it reviews everything)
# Example: If using xAI for tasks, use Claude for grading
#
FEEDBACK_PROVIDER=anthropic
FEEDBACK_MODEL=claude-sonnet-4-5-20250929
#
# Or use OpenAI:
# FEEDBACK_PROVIDER=openai
# FEEDBACK_MODEL=gpt-4o
#
# --- Random Feedback (Passive Learning) ---
# Enable random feedback collection during normal operation
FEEDBACK_RANDOM_ENABLED=false
# Chance of triggering feedback (0.1 = 10%, 0.05 = 5%)
FEEDBACK_RANDOM_CHANCE=0.1

# Supported providers: anthropic, openai, xai, ollama
# ============================================================================
# TOOL BUILDER (Dynamic Tool Creation)
# ============================================================================
# Provider for autonomous tool creation. Falls back to: FEEDBACK_PROVIDER → LLM_PROVIDER
# Set explicitly for consistency across cloud/local modes
#
TOOL_BUILDER_PROVIDER=anthropic
TOOL_BUILDER_MODEL=claude-sonnet-4-5-20250929
#
# Or use xAI for tool building:
# TOOL_BUILDER_PROVIDER=xai
# TOOL_BUILDER_MODEL=grok-4-1-fast-non-reasoning-latest

# ============================================================================
# PROMPT EVOLUTION SYSTEM
# ============================================================================
# Self-evolving prompts based on feedback. See docs/ADVANCED_AI_TECHNIQUES.md
#
# --- Thresholds (Testing Mode - Lower values for faster feedback) ---
# Minimum low ratings before triggering evolution (default: 2, production: 5)
EVOLUTION_MIN_LOW_RATINGS=2
#
# Rating threshold - ratings below this are "low" (default: 7, production: 6)
EVOLUTION_LOW_THRESHOLD=7
#
# Days to look back for feedback (default: 3, production: 7)
EVOLUTION_WINDOW_DAYS=3
#
# --- Rate Limits ---
# Max evolutions per day (default: 5, production: 3)
EVOLUTION_MAX_PER_DAY=5
#
# --- Automation ---
# Enable auto-evolution after feedback threshold (default: false)
# When true, evolution check runs automatically after EVOLUTION_AUTO_CHECK_AFTER feedback entries
EVOLUTION_AUTO_ENABLED=false
#
# Run evolution check after this many new feedback entries (default: 10)
EVOLUTION_AUTO_CHECK_AFTER=10
#
# --- Degradation Detection ---
# Alert when performance drops by this % (default: 15)
# EVOLUTION_DEGRADATION_ALERT_PCT=15
#
# Auto-rollback when performance drops by this % (default: 25)
# EVOLUTION_DEGRADATION_ROLLBACK_PCT=25
#
# --- A/B Testing ---
# Sample size for A/B tests (default: 10, production: 20)
# EVOLUTION_AB_TEST_SIZE=10
#
# --- Auto Sync on API/Service Start ---
# Sync evolution data between cloud/local when jarvis-api starts
# Default: false (manual sync recommended until system is proven stable)
# Set to true after you've verified evolution is working correctly
EVOLUTION_AUTO_SYNC=false
# Printer (for print tool)
PRINTER_NAME=""

# ========================================
# VAPI.AI PHONE CALLS
# ========================================
# Make AI phone calls via Vapi.ai
# Sign up at https://vapi.ai and get your API key
# 
# Private API Key (from Vapi dashboard > Organization Settings > API Keys)
VAPI_API_KEY=""
#
# Phone Number ID (from Vapi dashboard > Phone Numbers)
# You need to purchase or import a phone number in Vapi
VAPI_PHONE_NUMBER_ID=""
#
# Optional: Default Assistant ID (if you create one in dashboard)
# If not set, tool will create temporary assistants per-call
VAPI_ASSISTANT_ID=""
#
# Optional: ElevenLabs Voice ID for phone calls (male personas)
# Falls back to ELEVENLABS_TTS_VOICE if not set
VAPI_VOICE_ID=""
#
# Female voice ID for "female" persona (Aria)
# If not set, uses OpenAI's "nova" voice
VAPI_FEMALE_VOICE_ID=""
#
# LLM provider for phone call AI (Vapi supports: xai, anthropic, openai, groq, together)
VAPI_LLM_PROVIDER="xai"
VAPI_LLM_MODEL="grok-4-1-fast-non-reasoning-latest"
#
# Wait for call completion? 
# true = Jarvis waits during call, gives instant results (best for CLI/testing)
# false = Fire and forget, ask "what happened on that call?" later (best for voice mode)
VAPI_WAIT_FOR_CALL=false
#
# Voicemail handling: what to do when call goes to voicemail
# "hangup" = Detect voicemail and hang up (no message left)
# "message" = Detect voicemail and leave a short message
# "disabled" = Don't detect (AI talks to voicemail like a person - weird)
VAPI_VOICEMAIL_ACTION="hangup"
#
# Owner name (how Jarvis identifies who it's calling on behalf of)
OWNER_NAME="Boss"
#
# Phone contacts as JSON (optional - can also save via memory)
# Example: PHONE_CONTACTS='{"boss": "+15551234567", "andrew": "+15559876543"}'
PHONE_CONTACTS='{}'
# ========================================
# TOOL BLOCKLIST
# ========================================
# Comma-separated list of tool names to exclude from sync
# These tools will not be available to the LLM
# Useful for: removing redundant MCP tools, optimizing context window
# Example: BLOCKED_TOOLS="mcp_blinko_webSearch,mcp_blinko_webExtra"
BLOCKED_TOOLS="mcp_blinko_webSearch,mcp_blinko_webExtra"
# =============================================================================
# IMAGE GENERATION TOOL
# =============================================================================
# Provider: gemini (default) or openai
#   gemini = Google Gemini (has Google Search grounding for real-time data)
#   openai = OpenAI gpt-image-1 (best text rendering, transparent backgrounds)
IMAGE_TOOL_PROVIDER="gemini"
# OpenAI image model (if using openai provider)
#   gpt-image-1 = Latest GPT Image model (superior quality, text, real-world knowledge)
OPENAI_IMAGE_MODEL="gpt-image-1"
# Google Gemini API Key (for image generation with Nano Banana Pro)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=""
# Gemini image model options:
#   gemini-3-pro-image-preview         = Nano Banana Pro (best quality, grounding support)
#   gemini-2.0-flash-preview-image-generation  = Free tier, good quality
#   gemini-2.0-flash-exp               = Free tier, experimental
GEMINI_IMAGE_MODEL="gemini-3-pro-image-preview"