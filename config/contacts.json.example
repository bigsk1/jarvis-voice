{
  "_description": "Contact list for Jarvis. Used by send_email and Google Workspace Gmail sends/drafts to resolve names to emails.",
  "_usage": "Say 'send email to Mom' or 'use Gmail to email Boss' and Jarvis looks up the recipient here. Gmail also resolves CC and BCC names.",
  
  "jarvis_email": {
    "enabled": false,
    "mode": "cloud",
    "approved_senders": ["boss"],
    "max_messages_per_poll": 1,
    "lookback_days": 1,
    "attachments_enabled": true,
    "max_attachment_bytes": 52428800,
    "max_attachments": 500
  },
  "contacts": {
    "boss": {
      "name": "dude",
      "email": "example@example.com",
      "notes": "Example contact - update with real email"
    },
    "mom": {
      "name": "Mom",
      "email": "mom@example.com",
      "notes": "Example contact"
    },
    "work": {
      "name": "Work",
      "email": "work@example.com",
      "notes": "Work email alias"
    },
    "restricted_contact": {
      "name": "Restricted Contact",
      "email": "robot@example.com",
      "allowed_tools_limited": ["printer"],
      "notes": "Optional inbound policy: built-in email tools plus printer. Approval in jarvis_email.approved_senders is still required."
    }
  },
  
  "_default_from": {
    "name": "Jarvis Assistant",
    "email": "jarvis@example.com"
  }
}
