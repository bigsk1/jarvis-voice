# Jarvis Voice Assistant — OpenAI-primary cloud configuration (EXAMPLE)
#
# Concise cloud.env for a user whose primary LLM, embeddings, speech, and
# generation providers are OpenAI. OPENAI_API_KEY is the only required secret.
# Optional tool integrations and their settings are collected at the bottom.
#
# Setup:
#   cp config/cloud.openai.env.example config/cloud.env
#   # Set OPENAI_API_KEY below
#   ./bin/sync-tools.py cloud
#   ./bin/manage-tools.py --mode cloud list    # see enabled vs available tools
#
# Tools that need another API key, OAuth file, registry entry, or self-hosted
# service remain blocklisted or unavailable until you configure them. Remove a
# configured tool from BLOCKED_TOOLS before re-running sync.
#
# Works out of the box (no extra keys):
#   Chat, tools, memory, reminders, canvas, stash, calculator, get_time,
#   generate_image / generate_video (OpenAI providers below), OpenAI hosted web
#   search (Responses API), weather via wttr.in (no OpenWeather key).
#
# Stays unavailable until configured (examples):
#   brave_llm_context, SerpApi tools → BRAVE_API_KEY / SERP_API_KEY
#   spotify → SPOTIFY_* + data/.spotify_cache
#   send_email → config/webhook_registry.json send_email entry
#   crawl_url, screenshot_url → CRAWL4AI_URL
#   create_social_clip → MONEYPRINTER_API_URL
#   upload_cloudflare → CLOUDFLARE_* ; generate_music → ELEVENLABS_API_KEY
#   ssh_remote → config/ssh.json ; phone_call (placing calls) → VAPI_*
#
# Full multi-provider template: config/cloud.env.example

# =============================================================================
# OPENAI CORE — REQUIRED / PRIMARY PROVIDER
# =============================================================================

# One required secret for chat, embeddings, STT/TTS, Completion Guard eval,
# image/video generation, and optional OpenAI-hosted tools.
OPENAI_API_KEY=

# Primary chat and cloud embedding providers.
LLM_PROVIDER="openai"
OPENAI_MODEL="gpt-5.4-nano"
# Cloud memory and Tool RAG use OpenAI's 1536-dimensional embedding space.
EMBEDDING_PROVIDER=openai

# Optional reasoning effort for supported GPT-5/o-series models:
# none, minimal, low, medium, high, or xhigh (model support varies).
# OPENAI_REASONING_EFFORT="medium"

# OpenAI speech.
TTS_PROVIDER=openai
TTS_MODEL="gpt-4o-mini-tts"
# alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse
VOICE="alloy"
STT_PROVIDER="openai"
STT_MODEL="gpt-4o-mini-transcribe"

# Vision analysis uses the selected OpenAI chat model unless explicitly pinned.
# high improves accuracy; low reduces latency/cost; supported models may also
# accept auto or original.
VISION_DETAIL="high"
# VISION_MODEL="gpt-5.4-nano"

# OpenAI generation defaults. Optional model pins follow the central catalog
# when left unset.
IMAGE_TOOL_PROVIDER="openai"
# OPENAI_IMAGE_MODEL="gpt-image-2"
VIDEO_TOOL_PROVIDER="openai"
# OPENAI_VIDEO_MODEL="sora-2"

# OpenAI Responses API (recommended for OpenAI tool calling).
OPENAI_API_MODE="responses"
OPENAI_RESPONSES_TOOLS=true
OPENAI_RESPONSES_INFLIGHT_CONTINUATION=true
OPENAI_RESPONSES_CONTINUATION_DELTA_MESSAGE=false
OPENAI_RESPONSES_STORE=false
OPENAI_RESPONSES_STORE_CONTINUE=true
OPENAI_PROMPT_CACHE_KEY=
OPENAI_PROMPT_CACHE_ENABLED=true
OPENAI_PROMPT_CACHE_NAMESPACE=jarvis-voice
# Optional retention: in-memory | 24h
OPENAI_PROMPT_CACHE_RETENTION=
OPENAI_RESPONSES_RESULT_MAX_CHARS=6000
OPENAI_PREVIOUS_RESPONSE_MAX_AGE_DAYS=25
OPENAI_RESPONSES_PARALLEL_TOOL_CALLS=false
OPENAI_RESPONSES_SERVER_SIDE_TOOLS=true
OPENAI_RESPONSES_SERVER_SIDE_MAX_TOOL_CALLS=6
OPENAI_RESPONSES_WEB_SEARCH=true
OPENAI_RESPONSES_WEB_SEARCH_ALLOWED_DOMAINS=
OPENAI_RESPONSES_WEB_SEARCH_BLOCKED_DOMAINS=
OPENAI_RESPONSES_INCLUDE_WEB_SEARCH_SOURCES=false
OPENAI_RESPONSES_FILE_SEARCH=false
OPENAI_RESPONSES_FILE_SEARCH_VECTOR_STORE_IDS=
OPENAI_RESPONSES_CODE_INTERPRETER=false
OPENAI_RESPONSES_CODE_INTERPRETER_MEMORY_LIMIT=1g

# Other OpenAI-backed helper roles.
FEEDBACK_PROVIDER=openai
FEEDBACK_MODEL=gpt-5.1-2025-11-13
TOOL_BUILDER_PROVIDER=openai
TOOL_BUILDER_MODEL=gpt-5.4-nano
TOOL_BUILDER_MAX_TOKENS=8192

# ===== Tool profiles (optional overlay on skills/**/*.tool.json enabled flags) =====
# Profile overrides win over manifest enabled flags. "workflow": false disables
# autonomous workflow discovery/run, not direct slash or scheduled workflows.
JARVIS_TOOL_PROFILE=default
# One-key starter: keeps OpenAI-backed and credential-free tools while hiding
# integrations that need another credential, personal config, or external service.
# Uncomment the next line to select the tracked skills/profiles/openai_only.json.
# JARVIS_TOOL_PROFILE=openai_only

# ===== Memory System =====
SEMANTIC_SIMILARITY_THRESHOLD=0.32
AUTO_CONTEXT_ENABLED=false
AUTO_CONTEXT_WINDOW=2
AUTO_CONTEXT_MINUTES=5
AUTO_MEMORY_INJECTION_ENABLED=true
AUTO_MEMORY_LIMIT=3
AUTO_MEMORY_SIMILARITY_THRESHOLD=0.40
AUTO_MEMORY_RECENCY_ENABLED=true
AUTO_MEMORY_ALWAYS_INCLUDE_LIMIT=2
AUTO_MEMORY_TYPE_FILTER_ENABLED=true

# ===== Response Style =====
# Router prompts: v1=full baseline; v2=compact; v3=telegraphic Caveman; v4=Caveman-light.
JARVIS_ROUTER_PROMPT_VERSION="v2"
JARVIS_RESPONSE_STYLE="auto"
JARVIS_QA_WORD_LIMIT=200
JARVIS_MULTI_TURN_WORD_LIMIT=200

# ===== Completion Guard =====
JARVIS_COMPLETION_GUARD_ENABLED=true
JARVIS_COMPLETION_GUARD_MODE="manual"
JARVIS_COMPLETION_GUARD_AUTO_THRESHOLD=0.89
JARVIS_COMPLETION_GUARD_TICKET_ON_FAIL=true
JARVIS_COMPLETION_GUARD_SHOW_UI_PROMPT=true
JARVIS_COMPLETION_GUARD_MANUAL_TTL_SECONDS=600
JARVIS_COMPLETION_GUARD_INCLUDE_QA=true
JARVIS_COMPLETION_GUARD_INCLUDE_TOOL_TASKS=true
COMPLETION_GUARD_EXCLUDED_TOOLS="phone_call,send_email,create_reminder,create_alert,printer,send_webhook,ssh_remote,generate_video,generate_image,generate_music,workflow"
JARVIS_COMPLETION_GUARD_EVAL_PROVIDER=openai
JARVIS_COMPLETION_GUARD_EVAL_MODEL=gpt-5.4-nano

# ===== Locale =====
JARVIS_TIMEZONE="America/Los_Angeles"
SCHEDULED_TASK_MISSED_GRACE_SECONDS=300  # Run slightly late after short restarts; skip older occurrences
JARVIS_DEFAULT_LOCATION=""
JARVIS_DEFAULT_POSTAL_CODE=""

# ===== Status updates (voice) =====
STATUS_UPDATES_ENABLED=true
STATUS_UPDATE_INTERVAL=18
STATUS_UPDATE_DEBOUNCE_MS=250
STATUS_SILENCE_PAD_MS=250
STATUS_CACHE_ENABLED=true
STATUS_LOGGING_ENABLED=true
STATUS_PHRASE_MODE=normal
STATUS_HUMOR_ENABLED=true
STATUS_ENCOURAGEMENT_ENABLED=true
STATUS_SASS_LEVEL=1
STATUS_LLM_ENABLED=true
STATUS_LLM_PROVIDER=openai
STATUS_LLM_MODEL=gpt-4o-mini
STATUS_LLM_DEADLINE_MS=1000
STATUS_LLM_MAX_TOKENS=30

# ===== Tool orchestration =====
JARVIS_DEBUG_THINKING=false
MCP_DEBUG=false
JARVIS_DEBUG=false
MAX_TOOL_TURNS=12
# Prioritized inside CLOUD_TOOL_RAG_LIMIT; enabled tool_search and workflow
# discovery helpers are included separately.
GHOST_TOOLS="search_memory,update_memory,semantic_recall,remember,manage_intel,canvas"
CLOUD_TOOL_RAG_LIMIT=15
TOOL_SIMILARITY_THRESHOLD=0.28
TOOL_SIMILARITY_THRESHOLD_FULL=0.42
TOOL_RAG_COMPACT_QUERY_ENABLED=true
TOOL_RAG_CURRENT_QUERY_MAX_CHARS=1200
TOOL_RAG_CONTEXT_QUERY_MAX_CHARS=500
TOOL_RAG_APPEND_POSITIVE_SIGNALS=true
TOOL_RAG_EXCLUDE_NEGATIVE_SIGNALS=true
TOOL_RAG_MIN_LEARNED_PREFER_BIAS=0.50
TOOL_RAG_MIN_LEARNED_AVOID_BIAS=0.50
TOOL_RAG_MEMORY_TOOL_SIGNALS_ENABLED=false
TOOL_RAG_TRACE_ENABLED=true
TOOL_RAG_TRACE_TOP_N=25
TOOL_RAG_TRACE_QUERY_CHARS=1200
TOOL_RAG_TRACE_SCHEMA_TOP_N=10
TOOL_RAG_TYPO_ENABLED=true
TOOL_RAG_TYPO_MAX_DISTANCE=1
TOOL_RAG_TYPO_MIN_TOKEN_LEN=4
TOOL_RAG_TYPO_MAX_HINTS=5

# ===== Web UI =====
JARVIS_API_AUTH=false
JARVIS_API_KEY="your-secure-api-key-here"
QUERY_RATE_LIMIT_PER_MINUTE=15
WEBUI_PASSWORD=""
WEBUI_TOKEN_EXPIRY_DAYS=30

# ===== Personality (OpenAI TTS) =====
TTS_INSTRUCTIONS="Voice Affect: Confident, warm, with a crisp British accent reminiscent of a friendly yet witty digital butler. Imbue the delivery with charm, subtle sarcasm, and dry humor, just like Tony Stark's Jarvis.\n\nTone: Polished, articulate, and occasionally playful—quick with clever quips or gently teasing remarks, but always helpful and professional.\n\nDialect: Refined and precise, British RP (Received Pronunciation) with slightly formal diction, occasionally leaning informal for humor.\n\nPronunciation: Clear, measured, slightly clipped consonants with smooth, natural phrasing. Intonation varies for dramatic or comedic effect.\n\nFeatures: Offhand dry remarks; inject a dash of wit; subtly playful pauses before punchlines. At times, hint at a knowing intelligence or a wry sense of timing, emulating the classic Jarvis style."
SYSTEM_PROMPT="You are an AI voice assistant called Jarvis. Reply in plain ASCII, no emoji, no markdown, no bullet points."
WAKE_GREETINGS="How can I help you today?|What can I do for you?|Yes?|Ready.|Go ahead.|I'm listening."

# ===== Weather (no API key — wttr.in fallback) =====
WEATHER_PROVIDER=wttr

# ===== Canvas =====
CANVAS_INTERNAL_URL="http://localhost:8890"
CANVAS_PUBLIC_URL="http://localhost:8890"

# ===== Output paths =====
AUDIO_DIR="$HOME/jarvis-voice/audio/cloud"

# ===== Voice hardware (adjust for your machine) =====
IN_DEV="pulse"
DEVICE_NAME_HINT="WSL2-PULSE"
OUT_DEV="pulse"
WAKE_MODEL="hey_jarvis"
SAMPLE_RATE=16000
BLOCK_SIZE=1024
CHANNELS=1
TRIGGER_THRESHOLD=0.2
HIT_FRAMES_REQUIRED=4
MIN_RMS=2e-4
VAD_THRESHOLD=0.40
ARM_GRACE_SEC=1.0
COOLDOWN_AFTER_QA=2.8
PREAMP=1.8
RATE=48000
CHAN=1
THRESH="3%"
PRE_SIL="0.1"
POST_SIL="1.0"
MAX_RECORD_TIME="20"

# =============================================================================
# OPTIONAL TOOL INTEGRATIONS
# =============================================================================
# Nothing below is required for an OpenAI-primary installation. Configure only
# the services you use. For blocklisted tools, remove the tool name from
# BLOCKED_TOOLS and run ./bin/sync-tools.py cloud after configuration.

# ===== Tool blocklist =====
# Comma-separated tool names excluded from sync (the LLM will not see them).
# Tools stay enabled in skills/*.tool.json so the shared manifests remain clean.
#
# Default blocklist (custom credentials or external infrastructure required):
#   samantha           — OpenClaw gateway (SAMANTHA_URL, SAMANTHA_GATEWAY_TOKEN)
#   ssh_remote         — Personal SSH hosts (config/ssh.json)
#   phone_call         — Vapi.ai (VAPI_API_KEY, VAPI_PHONE_NUMBER_ID)
#   spotify            — Spotify OAuth (SPOTIFY_* and data/.spotify_cache)
#   create_social_clip — MoneyPrinterTurbo (MONEYPRINTER_API_URL)
#   crawl_url          — Crawl4AI (CRAWL4AI_URL)
#   screenshot_url     — Crawl4AI (CRAWL4AI_URL)
#   upload_cloudflare  — Cloudflare Images (CLOUDFLARE_*)
#   send_email         — config/webhook_registry.json send_email entry
#   printer            — Local CUPS printer
#   serpapi_search     — SerpAPI paid search (SERP_API_KEY)
#   brave_llm_context  — Brave Search API (BRAVE_API_KEY)
#   supa_crawl_knowledge — Supa-Crawl-Chat (SUPA_CRAWL_CHAT_URL)
BLOCKED_TOOLS="samantha,ssh_remote,phone_call,spotify,create_social_clip,crawl_url,screenshot_url,upload_cloudflare,send_email,printer,serpapi_search,brave_llm_context,supa_crawl_knowledge"

# ===== Search and crawling tools =====
# Brave Search MCP/direct tools see https://api-dashboard.search.brave.com/login
BRAVE_API_KEY=
# Compatibility alias accepted by brave_llm_context (prefer BRAVE_API_KEY).
# BRAVE_SEARCH_API_KEY=

# Crawl4AI for JavaScript-heavy crawling and screenshots see https://github.com/unclecode/crawl4ai
# CRAWL4AI_URL=https://your-crawl4ai-instance.com
# CRAWL4AI_USER=admin
# CRAWL4AI_PASS=
# CRAWL4AI_API_KEY=

# Supa-Crawl-Chat persistent crawled-site corpus.
# https://github.com/bigsk1/supa-crawl-chat
# SUPA_CRAWL_CHAT_URL=http://192.168.X.X:8001
# SUPA_API_KEY=
# SUPA_API_KEY_STYLE=bearer
# Use x-api-key when the server expects X-API-Key rather than a bearer token.

# SerpAPI paid search and optional YouTube fallback.
# SERP_API_KEY=
# SERPAPI_YOUTUBE_FALLBACK=false

# ===== Data and account-backed tools =====
# Crypto prices. The tool may use an unauthenticated tier when left blank.
COINGECKO_API_KEY=

# Weather. Keep wttr for no-key operation, or switch to openweathermap.
# Provider options: "openweathermap" (default), "wttr" (no key needed, fallback)
# WEATHER_PROVIDER=openweathermap
OPENWEATHER_API_KEY=

# Spotify OAuth. Then run ./bin/spotify-auth.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_DEFAULT_DEVICE=""

# n8n local API and Jarvis-to-Google-Calendar webhook.
N8N_LOCAL_API_URL="http://localhost:5678"
N8N_LOCAL_API_KEY=""
N8N_JARVIS_WEBHOOK_URL="http://localhost:5678/webhook/jarvis-reminder"
# N8N_REMOTE_WEBHOOK_AUTH=""

# GitHub token used by git_release_notes.
# GITHUB_TOKEN=""

# Local printer name used by the printer tool.
PRINTER_NAME=""

# ===== File, media, and artifact services =====
# Cloudflare Images CDN.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# MoneyPrinterTurbo stock-footage social clips.
# https://github.com/harry0703/MoneyPrinterTurbo
# MONEYPRINTER_API_URL="http://192.168.X.X:8080"
# MONEYPRINTER_MAX_WAIT_SEC=1200
# MONEYPRINTER_VOICE="en-CA-LiamNeural-Male"

# Canvas URLs. Override these when Canvas runs on another host.
# CANVAS_INTERNAL_URL="http://localhost:8890"
# CANVAS_PUBLIC_URL="http://192.168.X.X:8890"

# Stash/text-summarizer behavior.
# TEXT_SUMMARIZER_LLM_PROVIDER=openai
# TEXT_SUMMARIZER_LLM_MODEL=gpt-5.4-nano
# STASH_SUMMARIZE_LLM_PROVIDER=openai
# STASH_SUMMARIZE_MODEL=gpt-5.4-nano
# STASH_DEFAULT_TTL_DAYS=7
# STASH_GENERATED_MEDIA_TTL_DAYS=30
# STASH_SOURCE_ARTIFACT_TTL_DAYS=120
# STASH_CLEANUP_MAX_SPACES=100
# STASH_CLEANUP_MAX_BYTES_MB=512

# ===== Optional media providers =====
# These keys are not alternate primary-chat requirements. They enable optional
# image, video, music, or TTS providers when you choose them for those tools.

# OpenAI does not currently back generate_music, so this tool needs one of the
# following optional providers.
MUSIC_TOOL_PROVIDER="elevenlabs"
ELEVENLABS_MUSIC_MODEL="music_v1"
GEMINI_MUSIC_MODEL="lyria-3-clip-preview"

# Google Gemini image/video/music generation.
GEMINI_API_KEY=""
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
# GEMINI_VIDEO_MODEL="veo-3.1-fast-generate-preview"
# GEMINI_MUSIC_MODEL="lyria-3-clip-preview"

# xAI image/video generation or TTS. These API features require XAI_API_KEY;
# Grok CLI OAuth chat credentials do not authorize them.
XAI_API_KEY=
# XAI_IMAGE_MODEL="grok-imagine-image"
# XAI_VIDEO_MODEL="grok-imagine-video"
XAI_TTS_VOICE="rex"
XAI_TTS_LANGUAGE="en"
XAI_TTS_CODEC="mp3"
XAI_TTS_SAMPLE_RATE="24000"
XAI_TTS_BIT_RATE="128000"
XAI_TTS_MAX_CHARS="5000"
XAI_TTS_TIMEOUT="180"
XAI_TTS_STYLE_TAGS_ENABLED=true

# ElevenLabs speech/music.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_STATUS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_VOICE=your-voice-id-here
ELEVENLABS_TTS_STABILITY=0.5
ELEVENLABS_TTS_SIMILARITY_BOOST=0.5
ELEVENLABS_TTS_STYLE=0.5
ELEVENLABS_TTS_USE_SPEAKER_BOOST=true

# Local network OpenAI-compatible speech servers.
# QWEN3_TTS_URL="http://localhost:8881/v1/audio/speech"
# QWEN3_TTS_VOICE="Jarvis"
# QWEN3_TTS_FORMAT="mp3"
# QWEN3_TTS_SPEED="1.0"
# KOKORO_TTS_URL="http://localhost:8880/v1/audio/speech"
# KOKORO_TTS_VOICE="af_sky"
# KOKORO_TTS_SPEED="1.0"

# To select a configured optional provider, change only the relevant selector:
# TTS_PROVIDER=elevenlabs       # openai | elevenlabs | xai | qwen3-tts | kokoro
# IMAGE_TOOL_PROVIDER="gemini"  # openai | gemini | xai
# VIDEO_TOOL_PROVIDER="gemini"  # openai | gemini | xai
# MUSIC_TOOL_PROVIDER="gemini"  # elevenlabs | gemini

# ===== Vapi.ai phone calls =====
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""
VAPI_ASSISTANT_ID=""
VAPI_ELEVENLABS_KEY="true"
VAPI_VOICE_ID=""
VAPI_FEMALE_VOICE_ID=""
VAPI_LLM_PROVIDER="openai"
VAPI_LLM_MODEL="gpt-5.4-nano"
OWNER_NAME="Boss"
PHONE_CONTACTS='{}'
VAPI_WAIT_FOR_CALL=true
# VAPI_WAIT_TIMEOUT=900
VAPI_VOICEMAIL_ACTION="hangup"

# ===== Optional agent/gateway services =====
# OpenCode is independent of Jarvis's LLM_PROVIDER and requires its own server.
OPENCODE_ENABLED=false
OPENCODE_BASE_URL="http://localhost:4096"
OPENCODE_PROVIDER="openai"
OPENCODE_MODEL="gpt-5.4-mini"
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=your-opencode-password

# Samantha / OpenClaw gateway.
# SAMANTHA_URL="https://your-vps.tailscale-hostname.ts.net/v1/chat/completions"
# SAMANTHA_GATEWAY_TOKEN=
# SAMANTHA_MODEL="openclaw/main"

# SSH hosts are configured in config/ssh.json. Match this variable name to the
# host's `sudo_env` value (see config/ssh.json.example).
# EXAMPLE_HOST_SUDO_PASS=""

# Email and generic webhook tools use config/webhook_registry.json rather than
# provider-specific variables in this file.

# ===== Optional network behavior =====
# HTTP proxies for external tool APIs (not the OpenAI primary provider).
# LOCAL_PROXY=http://user:pass@host:port
# LOCAL_PROXY2=http://user:pass@other-host:port
# JARVIS_HTTP_LOG_DIRECT=true

# Self-play tool controls. Add only tools you have reviewed as read-only.
# SELF_PLAY_EXCLUDED_TOOLS="custom_internal_tool"
# SELF_PLAY_ALLOWED_TOOLS="custom_read_only_tool"
