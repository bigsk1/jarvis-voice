{
  "name": "Jarvis → Send Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-email",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "jarvis-email"
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.body.from_email || 'noreply@yourdomain.com' }}",
        "toEmail": "={{ $json.body.to }}",
        "subject": "={{ $json.body.subject }}",
        "html": "=<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<meta name=\"color-scheme\" content=\"dark\">\n<meta name=\"supported-color-schemes\" content=\"dark\">\n<title>Incoming Transmission</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');\nbody, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\ntable, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\nimg { -ms-interpolation-mode: bicubic; }\n:root { color-scheme: dark; supported-color-schemes: dark; }\nbody {\n  background-color: #0f172a !important;\n  font-family: 'JetBrains Mono', 'Courier New', monospace;\n  color: #e2e8f0 !important;\n  margin: 0;\n  padding: 0;\n  width: 100% !important;\n  height: 100% !important;\n}\n.wrapper {\n  width: 100%;\n  table-layout: fixed;\n  background-color: #0f172a;\n  padding-bottom: 40px;\n}\n.main-box {\n  max-width: 600px;\n  margin: 0 auto;\n  background-color: #1e293b;\n  border: 1px solid #334155;\n  border-radius: 8px;\n  overflow: hidden;\n  box-shadow: 0 0 15px rgba(14, 165, 233, 0.15);\n}\n.header {\n  background-color: #0f172a;\n  border-bottom: 2px solid #0ea5e9;\n  padding: 20px;\n  text-align: left;\n}\n.header h1 {\n  color: #0ea5e9;\n  font-size: 16px;\n  margin: 0;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  display: inline-block;\n}\n.cursor {\n  display: inline-block;\n  width: 10px;\n  height: 16px;\n  background-color: #0ea5e9;\n  animation: blink 1s step-end infinite;\n  vertical-align: middle;\n  margin-left: 5px;\n}\n@keyframes blink { 50% { opacity: 0; } }\n.meta-grid {\n  display: table;\n  width: 100%;\n  background-color: #162032;\n  border-bottom: 1px solid #334155;\n  font-size: 10px;\n  color: #64748b;\n}\n.meta-cell {\n  display: table-cell;\n  padding: 10px 20px;\n  border-right: 1px solid #334155;\n  width: 33%;\n}\n.meta-label { text-transform: uppercase; display: block; margin-bottom: 2px; color: #475569; }\n.meta-value { color: #94a3b8; font-weight: bold; }\n.content {\n  padding: 30px;\n  color: #f1f5f9;\n  font-size: 15px;\n  line-height: 1.6;\n  white-space: pre-line;\n}\n.footer {\n  background-color: #0f172a;\n  padding: 15px 30px;\n  border-top: 1px solid #334155;\n  font-size: 10px;\n  color: #475569;\n}\n.secure-badge {\n  color: #10b981;\n  border: 1px solid #10b981;\n  padding: 2px 6px;\n  border-radius: 4px;\n  text-transform: uppercase;\n  font-size: 9px;\n}\n</style>\n</head>\n<body>\n  <div class=\"wrapper\">\n    <br>\n    <div class=\"main-box\">\n      <div class=\"header\">\n        <h1>// Jarvis_Link_Established<span class=\"cursor\"></span></h1>\n      </div>\n      <div class=\"meta-grid\">\n        <div class=\"meta-cell\">\n          <span class=\"meta-label\">Protocol</span>\n          <span class=\"meta-value\">SMTP_SECURE</span>\n        </div>\n        <div class=\"meta-cell\">\n          <span class=\"meta-label\">Timestamp</span>\n          <span class=\"meta-value\">{{ $now.toUTC().toFormat(\"HH:mm:ss\") }} UTC</span>\n        </div>\n        <div class=\"meta-cell\" style=\"border-right: none;\">\n          <span class=\"meta-label\">Ref ID</span>\n          <span class=\"meta-value\">{{ $execution.id }}</span>\n        </div>\n      </div>\n      <div class=\"content\">\n        {{ $json.body.body }}\n\n        {{ $json.body.image_url ? '<div style=\"margin-top: 20px; text-align: center;\"><a href=\"' + ($json.body.link_url || $json.body.image_url) + '\"><img src=\"' + $json.body.image_url + '\" alt=\"' + ($json.body.link_text || 'Image') + '\" style=\"max-width: 280px; border-radius: 8px; border: 1px solid #334155; box-shadow: 0 0 10px rgba(14, 165, 233, 0.3);\"></a></div>' : '' }}\n\n        {{ $json.body.link_url ? '<div style=\"margin-top: 15px; text-align: center;\"><a href=\"' + $json.body.link_url + '\" style=\"display: inline-block; background: linear-gradient(135deg, #1DB954 0%, #1ed760 100%); color: #fff; padding: 12px 24px; border-radius: 25px; text-decoration: none; font-weight: bold; font-size: 14px;\">▶ ' + ($json.body.link_text || 'Open Link') + '</a></div>' : '' }}\n      </div>\n      <div class=\"footer\">\n        <table width=\"100%\">\n          <tr>\n            <td align=\"left\">SYSTEM: ONLINE</td>\n            <td align=\"right\"><span class=\"secure-badge\">Encrypted: AES-256</span></td>\n          </tr>\n        </table>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        256,
        0
      ],
      "webhookId": "7c7ca9a7-80d1-4068-9260-44a163540fc5",
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ok: true, message: 'Email sent to ' + $('Webhook').item.json.body.to}) }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        512,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ok: false, error: $json.message || 'Email failed'}) }}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        512,
        176
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          },
          {
            "node": "Respond Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "versionId": "EXAMPLE_VERSION_ID",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "YOUR_INSTANCE_ID"
  },
  "id": "EXAMPLE_WORKFLOW_ID",
  "tags": []
}
