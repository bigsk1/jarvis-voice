  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "WebSocket chat and /api/query both instantiate Orchestrator inside a mode-scoped config context.",
        "The core branches to explicit workflow pipelines before falling back to LLM routing and tool execution."
      ]
    },
    {
      "dot": "emerald",
      "title": "Runtime modes",
      "items": [
        "Native startup uses tmux sessions and ~/jarvis-venv; Docker uses docker/entrypoint.sh, /opt/venv, and bind-mounted config/data/logs/audio.",
        "JARVIS_MODE selects config and data boundaries; LLM_PROVIDER selects the chat backend."
      ]
    },
    {
      "dot": "rose",
      "title": "Persistence",
      "items": [
        "SQLite memory/intelligence databases are split by cloud/local mode and synced by startup/service paths.",
        "Canvas pages, stash artifacts, generated media, uploads, audio, and JSONL logs stay repo-local under data/, jarvis-web/data/, audio/, and logs/."
      ]
    }
  ]
