# Optional Docker Compose interpolation settings.
# Copy to .env at the repo root or pass with: docker compose --env-file docker/docker.env ...

JARVIS_DOCKER_UID=1000
JARVIS_DOCKER_GID=1000
JARVIS_MODE=cloud
JARVIS_SYNC_MODES=cloud

# API is bound to 127.0.0.1 by default and disabled inside the private compose
# network for first bring-up. Set true only with a configured JARVIS_API_KEY in
# config/cloud.env or config/local.env.
JARVIS_DOCKER_API_AUTH=false

JARVIS_WEB_PORT=5001
JARVIS_API_PORT=8880
JARVIS_CANVAS_PORT=8890
JARVIS_MEMORY_PORT=5002
JARVIS_INTELLIGENCE_PORT=5003
JARVIS_DOCS_PORT=5004
