{
  "enabled": true,
  "name": "craft_pdf",
  "description": "Edit existing PDFs through an optional self-hosted PdfCraft gateway: rotate selected pages, extract pages, combine PDFs, or render a selected page. Page numbers start at 1. Use pdf_read for ordinary extraction and pdf_create for document creation.",
  "script": "craft_pdf.py",
  "complementary_tools": [
    "stash",
    "craft_inspect",
    "canvas",
    "pdf_read",
    "pdf_create",
    "docling_convert"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "rotate",
          "extract",
          "combine",
          "render"
        ]
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 16,
        "description": "Source stash:// references, permitted local paths, or craft://project/artifact references from previous output. Native projects cannot be uploaded."
      },
      "project_id": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$",
        "description": "Existing gateway project for follow-up edits and Craft artifact reuse. Omit for a new project."
      },
      "pages": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "minItems": 1,
        "maxItems": 200
      },
      "degrees": {
        "type": "integer",
        "enum": [
          90,
          180,
          270
        ]
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "permissions": {
    "dangerous": false,
    "bash": false,
    "network": true,
    "filesystem": true,
    "auto_approve": true
  },
  "availability": {
    "all_of_env": [
      "CRAFT_API_URL",
      "CRAFT_API_KEY"
    ],
    "setup_hint": "Run jarvis-craft-tools/setup.sh on the app host, then set CRAFT_API_URL and CRAFT_API_KEY in the selected mode ENV. See jarvis-craft-tools/README.md."
  },
  "child_environment": {
    "mode": "restricted",
    "from_availability": true,
    "allow": [
      "CRAFT_CA_BUNDLE",
      "CRAFT_WAIT_SECONDS",
      "STASH_DIR",
      "JARVIS_BACKGROUND_MAX_INPUT_BYTES"
    ]
  },
  "execution": {
    "background": {
      "supported": true,
      "adapter": "remote_skill_v1",
      "completion_scope": "remote_work",
      "timeout_seconds": 1500,
      "progress_label": "Editing with Craft",
      "limits": {
        "memory_bytes": 1073741824,
        "file_bytes": 536870912,
        "input_bytes": 52428800,
        "output_bytes": 2097152
      },
      "argument_constraints": {
        "properties": {}
      }
    }
  }
}
