# Bind to a Tailscale or trusted LAN IP to open the browser from another device.
# Loopback keeps a new installation local until you choose an address.
FILEBROWSER_BIND_IP=127.0.0.1
FILEBROWSER_PORT=8111

# Required. Set a unique password of at least 12 characters before starting.
FILEBROWSER_ADMIN_PASSWORD=

# Optional host path if Jarvis uses a custom stash directory.
# FILEBROWSER_STASH_PATH=../data/stash
