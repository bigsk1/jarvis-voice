# Jarvis Voice Assistant - Git Ignore

# ===== Secrets & Config =====
config/*.env
*.env
!config/*.env.template
!config/*.env.example
*.key
*.pem

# ===== Audio Files =====
audio/
*.wav
*.mp3
*.ogg
*.flac

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
jarvis-venv/

# ===== Logs & Runtime =====
*.log
logs/
*.tmp
.cache/
tmp/

# ===== IDE & Editors =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===== System =====
.Trash/
Thumbs.db

data/*.db
data/*.db.*
data/*.db-*
*.db.backup
*.db.backup-*
*.sqlite
*.sqlite.*
*.sqlite-*

# Cursor chat history files
cursor_*.md
*.cursor.*

# OpenCode sessions and logs
logs/opencode/
.opencode/

# User knowledge base (contains sensitive info: IPs, credentials, network configs)
jarvis-intel/
