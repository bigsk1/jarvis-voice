# Jarvis Voice Assistant - Git Ignore

# ===== Secrets & Config =====
config/*.env
*.env
!config/*.env.template
!config/*.env.example
*.key
*.pem
config/contacts.json
config/webhook_registry.json
config/elevenlabs_voices.json
config/ssh.json
jarvis-monitor/.env
jarvis-web/config/web_config.json
config/webhook_registry.json.template
config/price-alerts.yaml
data/secrets/
data/bookmarks.html

# ===== n8n Workflows (contain personal emails, keep .example versions) =====
docs/n8n/workflows/*.json
!docs/n8n/workflows/*.json.example
.n8n/

# ===== Stash (task artifacts) =====
# Keep directory structure, ignore space contents
data/stash/space_*/

# ===== Audio Files =====
audio/
*.wav
*.mp3
*.ogg
*.flac

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
jarvis-venv/

# ===== Logs & Runtime =====
*.log
logs/*
!logs/test/
logs/test/*.log
logs/test/*.json
!logs/test/README.md
*.tmp
.cache/
tmp/
tests/integration/logs
tests/integration/logs/*
# Tool profiles: only default.json is tracked; everything else is local
skills/profiles/*
!skills/profiles/default.json

# ===== Backup & Temp Files =====
*.bak
*.orig

# ===== IDE & Editors =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===== System =====
.Trash/
Thumbs.db

data/*.db
data/*.db.*
data/*.db-*
*.db.backup
*.db.backup-*
*.sqlite
*.sqlite.*
*.sqlite-*
data/backups
data/.email_rate_limit
data/.webhook_rate_limit
data/.scheduled_task_notification_rate_limit
data/canvas/*
data/generated_videos/*
data/generated_videos/.thumbnails/
data/generated_music/*
docs/personal

# Cursor chat history files
cursor_*.md
*.cursor.*
.cursor/
.agents
.codex

# OpenCode sessions and logs
logs/opencode/
.opencode/

# Auth logs
logs/auth/

# User knowledge base (contains sensitive info: IPs, credentials, network configs)
jarvis-intel/*
!jarvis-intel/jarvis-tool-knowledge.md
!jarvis-intel/jarvis-learned-lessons.md
!jarvis-intel/README.md

# ===== Blinko Integration =====
# Ignore runtime data but keep setup files
blinko/data/
blinko/postgres-data/
blinko/.env

opencodetmp/
# Spotify OAuth cache (contains access tokens)
data/.spotify_cache
data/.phone_call_lock
data/.phone_call_in_progress
data/.webui_secret

characters/
data/generated_images/*
jarvis-web/data/uploads/

