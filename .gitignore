# Jarvis Voice Assistant - Git Ignore

# ===== Secrets & Config =====
config/*.env
*.env
!config/*.env.template
!config/*.env.example
*.key
*.pem
config/contacts.json
config/webhook_registry.json
config/elevenlabs_voices.json
config/ssh.json
jarvis-monitor/.env

# ===== Stash (task artifacts) =====
# Keep directory structure, ignore space contents
data/stash/space_*/

# ===== Audio Files =====
audio/
*.wav
*.mp3
*.ogg
*.flac

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
jarvis-venv/

# ===== Logs & Runtime =====
*.log
logs/*
!logs/test/
logs/test/*.log
logs/test/*.json
!logs/test/README.md
*.tmp
.cache/
tmp/
tests/integration/logs
tests/integration/logs/*

# ===== IDE & Editors =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===== System =====
.Trash/
Thumbs.db

data/*.db
