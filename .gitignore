# Jarvis Voice Assistant - Git Ignore

# ===== Secrets & Config =====
config/*.env
*.env
!config/*.env.template
!config/*.env.example
*.key
*.pem
config/contacts.json
config/webhook_registry.json

# ===== Audio Files =====
audio/
*.wav
*.mp3
*.ogg
*.flac

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
jarvis-venv/

# ===== Logs & Runtime =====
*.log
logs/*
!logs/test/
logs/test/*.log
logs/test/*.json
!logs/test/README.md
*.tmp
.cache/
tmp/
tests/integration/logs
tests/integration/logs/*

# ===== IDE & Editors =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===== System =====
.Trash/
Thumbs.db

data/*.db
data/*.db.*
data/*.db-*
*.db.backup
*.db.backup-*
*.sqlite
*.sqlite.*
*.sqlite-*
data/backups
data/.email_rate_limit
data/.webhook_rate_limit
data/canvas

# Cursor chat history files
cursor_*.md
*.cursor.*

# OpenCode sessions and logs
logs/opencode/
.opencode/

# User knowledge base (contains sensitive info: IPs, credentials, network configs)
jarvis-intel/

# ===== Blinko Integration =====
# Ignore runtime data but keep setup files
blinko/data/
blinko/postgres-data/
blinko/.env
